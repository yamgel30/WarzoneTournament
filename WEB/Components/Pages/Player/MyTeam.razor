@page "/my-team"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using WarzoneTournament.Application.Common.Interfaces
@using WarzoneTournament.Application.DTOs.Team
@using WarzoneTournament.Application.DTOs.Tournament
@using WarzoneTournament.Application.DTOs.Discord
@using WarzoneTournament.Domain.Enums
@inject ITeamService TeamService
@inject ITeamInvitationService InvitationService
@inject ITournamentService TournamentService
@inject IPlayerService PlayerService
@inject IDiscordNotificationService DiscordService
@inject ISiteSettingsService SiteSettings
@inject NavigationManager NavManager
@inject DialogService DialogSvc

<PageTitle>Mi Equipo — Warzone Tournament</PageTitle>

<div class="page-container">

@if (_loading)
{
    <div class="loading-spinner-container">
        <div class="loading-ring"></div>
        <span class="loading-text">Cargando equipo...</span>
    </div>
}
else if (!_profileComplete)
{
    <div class="empty-state">
        <div class="empty-state__icon">⚠️</div>
        <h3>Perfil incompleto</h3>
        <p>Completa tu perfil para acceder a esta sección.</p>
        <div style="margin-top:16px">
            <RadzenButton Text="Configurar perfil" Icon="person" ButtonStyle="ButtonStyle.Primary"
                          Click="@(() => NavManager.NavigateTo("/profile/setup"))" />
        </div>
    </div>
}
else if (_team is null)
{
    @* ── CREATE TEAM ── *@
    <div class="page-header">
        <div>
            <h1 class="page-title">Crear Equipo</h1>
            <p class="page-subtitle">Forma tu equipo y compite en los torneos</p>
        </div>
    </div>

    <div class="glass-card" style="max-width:520px">
        @if (!string.IsNullOrEmpty(_error))
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" Variant="Variant.Flat" style="margin-bottom:16px">@_error</RadzenAlert>
        }
        <div class="form-field" style="margin-bottom:16px">
            <RadzenLabel Text="Nombre del equipo *" />
            <RadzenTextBox @bind-Value="_createDto.Name" Style="width:100%;margin-top:6px" Placeholder="Ej: Shadow Wolves" />
        </div>
        <div class="form-field" style="margin-bottom:16px">
            <RadzenLabel Text="Tag del equipo (3-5 letras)" />
            <RadzenTextBox @bind-Value="_createDto.Tag" Style="width:100%;margin-top:6px" Placeholder="Ej: SHW" />
        </div>
        <div class="form-field" style="margin-bottom:16px">
            <RadzenLabel Text="Logo del equipo" />
            <div style="margin-top:6px"><ImageUploadField @bind-Value="_createDto.LogoUrl" /></div>
        </div>
        <div class="form-field" style="margin-bottom:24px">
            <RadzenLabel Text="Plataforma" />
            <RadzenDropDown @bind-Value="_createDto.PreferredPlatform" Data="@(Enum.GetValues<Platform>())" Style="width:100%;margin-top:6px" />
        </div>
        <RadzenButton Text="Crear Equipo" Icon="group_add" ButtonStyle="ButtonStyle.Primary"
                      Click="@CreateTeamAsync" Disabled="@_busy" />
    </div>
}
else
{
    @* ── TEAM MANAGEMENT ── *@
    <div class="page-header">
        <div style="display:flex;align-items:center;gap:18px">
            @if (!string.IsNullOrEmpty(_team.LogoUrl))
            {
                <img src="@_team.LogoUrl" style="width:60px;height:60px;border-radius:var(--r-lg);object-fit:cover;border:2px solid var(--c-electric);box-shadow:0 0 16px rgba(8,51,212,0.4)" />
            }
            else
            {
                <div style="width:60px;height:60px;border-radius:var(--r-lg);background:linear-gradient(135deg,var(--c-royal),var(--c-electric));display:flex;align-items:center;justify-content:center;font-size:1.8em;box-shadow:0 0 16px rgba(8,51,212,0.4)">👥</div>
            }
            <div>
                <h1 class="page-title" style="margin:0">@_team.Name</h1>
                @if (!string.IsNullOrEmpty(_team.Tag))
                {
                    <span style="color:var(--c-sky);font-size:0.9em;font-weight:700">[@_team.Tag]</span>
                }
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" Variant="Variant.Flat" style="margin-bottom:16px">@_error</RadzenAlert>
    }
    @if (!string.IsNullOrEmpty(_success))
    {
        <RadzenAlert AlertStyle="AlertStyle.Success" ShowIcon="true" Variant="Variant.Flat" style="margin-bottom:16px">@_success</RadzenAlert>
    }

    @* ── EDIT TEAM (captain only, collapsible) ── *@
    @if (_isCaptain)
    {
        <div class="glass-card" style="margin-bottom:20px">
            <button @onclick="@(() => _editOpen = !_editOpen)"
                    style="width:100%;background:none;border:none;cursor:pointer;display:flex;align-items:center;justify-content:space-between;padding:0">
                <span class="section-title">✏️ Editar Equipo</span>
                <span style="color:var(--c-muted);font-size:12px;transition:transform 0.2s;display:inline-block;transform:rotate(@(_editOpen ? "180deg" : "0deg"))">▼</span>
            </button>

            @if (_editOpen)
            {
                <div style="margin-top:18px;display:grid;grid-template-columns:1fr 1fr;gap:16px">
                    <div>
                        <div class="form-field" style="margin-bottom:14px">
                            <RadzenLabel Text="Nombre del equipo *" />
                            <RadzenTextBox @bind-Value="_editDto.Name" Style="width:100%;margin-top:6px" Placeholder="Nombre del equipo" />
                        </div>
                        <div class="form-field" style="margin-bottom:14px">
                            <RadzenLabel Text="Tag (3-5 letras)" />
                            <RadzenTextBox @bind-Value="_editDto.Tag" Style="width:100%;margin-top:6px" Placeholder="Ej: SHW" />
                        </div>
                        <div class="form-field" style="margin-bottom:14px">
                            <RadzenLabel Text="Plataforma" />
                            <RadzenDropDown @bind-Value="_editDto.PreferredPlatform" Data="@(Enum.GetValues<Platform>())" Style="width:100%;margin-top:6px" />
                        </div>
                        <RadzenButton Text="@(_busy ? "Guardando..." : "Guardar cambios")" Icon="save"
                                      ButtonStyle="ButtonStyle.Primary" Click="@UpdateTeamAsync" Disabled="@_busy" />
                    </div>
                    <div>
                        <RadzenLabel Text="Logo del equipo" />
                        <div style="margin-top:6px"><ImageUploadField @bind-Value="_editDto.LogoUrl" /></div>
                    </div>
                </div>
            }
        </div>
    }

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:4px">

        @* ── MEMBERS ── *@
        <div class="glass-card">
            <div class="section-header">
                <span class="section-title">👥 Miembros (@_team.Players.Count)</span>
                <div class="section-header-line"></div>
            </div>
            @foreach (var p in _team.Players)
            {
                <div style="display:flex;align-items:center;gap:10px;padding:10px 0;border-bottom:1px solid var(--c-border)">
                    <div style="width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,var(--c-royal),var(--c-neon));display:flex;align-items:center;justify-content:center;font-weight:700;font-size:12px;color:var(--c-white);flex-shrink:0">
                        @p.Username.Substring(0, 1).ToUpper()
                    </div>
                    <span style="font-weight:600;color:var(--c-white);flex:1">@p.Username</span>
                    @if (_team.CaptainId.HasValue && p.PlayerId == _team.CaptainId)
                    {
                        <RadzenBadge Text="Capitán" BadgeStyle="BadgeStyle.Warning" />
                    }
                    @if (_isCaptain && p.PlayerId != _myPlayerId)
                    {
                        <RadzenButton Icon="person_remove" ButtonStyle="ButtonStyle.Danger"
                                      Size="ButtonSize.Small" Variant="Variant.Text"
                                      title="Eliminar del equipo"
                                      Click="@(() => RemovePlayerAsync(p.PlayerId))"
                                      Disabled="@_busy" />
                    }
                </div>
            }
        </div>

        @* ── INVITE PLAYER ── *@
        @if (_isCaptain)
        {
            <div class="glass-card">
                <div class="section-header">
                    <span class="section-title">✉️ Invitar Jugador</span>
                    <div class="section-header-line"></div>
                </div>

                @* Search mode toggle *@
                <div style="display:flex;gap:6px;margin-bottom:14px;background:rgba(7,26,130,0.3);border-radius:var(--r-md);padding:4px;border:1px solid var(--c-border)">
                    <button @onclick="@(() => SetSearchMode("app"))"
                            style="flex:1;padding:6px 10px;border:none;border-radius:calc(var(--r-md) - 2px);font-size:12px;font-weight:600;cursor:pointer;transition:all 0.2s;
                                   @(_searchMode == "app" ? "background:var(--c-electric);color:#fff;" : "background:transparent;color:var(--c-muted);")">
                        <span class="material-icons" style="font-size:14px;vertical-align:-3px;margin-right:4px">person_search</span>En App
                    </button>
                    <button @onclick="@(() => SetSearchMode("discord"))"
                            style="flex:1;padding:6px 10px;border:none;border-radius:calc(var(--r-md) - 2px);font-size:12px;font-weight:600;cursor:pointer;transition:all 0.2s;
                                   @(_searchMode == "discord" ? "background:var(--c-electric);color:#fff;" : "background:transparent;color:var(--c-muted);")">
                        <svg style="width:14px;height:14px;vertical-align:-3px;margin-right:4px;fill:currentColor" viewBox="0 0 24 24"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03z"/></svg>En Discord
                    </button>
                </div>

                @* ─ APP SEARCH ─ *@
                @if (_searchMode == "app")
                {
                    <div style="display:flex;gap:8px;margin-bottom:12px">
                        <RadzenTextBox @bind-Value="_searchQuery" Placeholder="Buscar por gamer tag..."
                                       Style="flex:1"
                                       @onkeyup="@(async e => { if (e.Key == "Enter") await SearchPlayersAsync(); })" />
                        <RadzenButton Icon="search" ButtonStyle="ButtonStyle.Secondary"
                                      Click="@SearchPlayersAsync" Disabled="@_busy" />
                    </div>
                    @if (_searchResults.Any())
                    {
                        <div style="margin-bottom:14px;background:rgba(7,26,130,0.3);border-radius:var(--r-md);overflow:hidden;border:1px solid var(--c-border)">
                            @foreach (var p in _searchResults)
                            {
                                <div style="display:flex;align-items:center;justify-content:space-between;padding:9px 12px;border-bottom:1px solid var(--c-border)">
                                    <span style="font-weight:500">@p.Username</span>
                                    <RadzenButton Text="Invitar" Icon="send" ButtonStyle="ButtonStyle.Primary"
                                                  Size="ButtonSize.Small" Click="@(() => SendInviteAsync(p.Id))" Disabled="@_busy" />
                                </div>
                            }
                        </div>
                    }
                }

                @* ─ DISCORD SEARCH ─ *@
                @if (_searchMode == "discord")
                {
                    <div style="display:flex;gap:8px;margin-bottom:12px">
                        <RadzenTextBox @bind-Value="_discordQuery" Placeholder="Buscar usuario en Discord..."
                                       Style="flex:1"
                                       @onkeyup="@(async e => { if (e.Key == "Enter") await SearchDiscordAsync(); })" />
                        <RadzenButton Icon="search" ButtonStyle="ButtonStyle.Secondary"
                                      Click="@SearchDiscordAsync" Disabled="@(_discordBusy || string.IsNullOrWhiteSpace(_discordQuery))" />
                    </div>

                    @if (!string.IsNullOrEmpty(_discordError))
                    {
                        <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" Variant="Variant.Flat" style="margin-bottom:10px;font-size:12px">@_discordError</RadzenAlert>
                    }

                    @if (_discordBusy)
                    {
                        <div style="display:flex;align-items:center;gap:8px;padding:12px 0;color:var(--c-muted);font-size:13px">
                            <div class="loading-ring" style="width:18px;height:18px"></div> Buscando en Discord...
                        </div>
                    }
                    else if (_discordResults.Any())
                    {
                        <div style="margin-bottom:14px;background:rgba(7,26,130,0.3);border-radius:var(--r-md);overflow:hidden;border:1px solid var(--c-border)">
                            @foreach (var m in _discordResults)
                            {
                                <div style="display:flex;align-items:center;gap:10px;padding:10px 12px;border-bottom:1px solid var(--c-border)">
                                    @if (!string.IsNullOrEmpty(m.AvatarUrl))
                                    {
                                        <img src="@m.AvatarUrl" style="width:32px;height:32px;border-radius:50%;flex-shrink:0;border:1px solid var(--c-border)" />
                                    }
                                    else
                                    {
                                        <div style="width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,#5865F2,#7289da);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:13px;color:#fff;flex-shrink:0">
                                            @m.DisplayName.Substring(0, 1).ToUpper()
                                        </div>
                                    }
                                    <div style="flex:1;min-width:0">
                                        <div style="font-weight:600;color:var(--c-white);font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">@m.DisplayName</div>
                                        <div style="font-size:11px;color:var(--c-muted)">@m.Username</div>
                                    </div>
                                    @if (m.IsRegistered)
                                    {
                                        <RadzenBadge Text="En app" BadgeStyle="BadgeStyle.Success" style="font-size:10px;flex-shrink:0" />
                                        <RadzenButton Text="Invitar" Icon="send" ButtonStyle="ButtonStyle.Primary"
                                                      Size="ButtonSize.Small" Disabled="@_busy"
                                                      Click="@(() => SendInviteAsync(m.PlayerId!.Value))" />
                                    }
                                    else
                                    {
                                        <RadzenBadge Text="No registrado" BadgeStyle="BadgeStyle.Light" style="font-size:10px;flex-shrink:0" />
                                        <RadzenButton Text="Invitar" Icon="send" ButtonStyle="ButtonStyle.Secondary"
                                                      Size="ButtonSize.Small" Disabled="@_busy"
                                                      Click="@(() => SendDiscordInviteAsync(m.DiscordId))" />
                                    }
                                </div>
                            }
                        </div>
                    }
                    else if (_discordSearched)
                    {
                        <div style="padding:12px 0;text-align:center;color:var(--c-muted);font-size:13px">
                            Sin resultados. Intenta con otro nombre de usuario.
                        </div>
                    }
                }

                <div class="section-header" style="margin-top:8px">
                    <span class="section-title" style="font-size:10px">Invitaciones enviadas</span>
                    <div class="section-header-line"></div>
                </div>
                @foreach (var inv in _sentInvitations)
                {
                    <div style="display:flex;align-items:center;justify-content:space-between;padding:7px 0;font-size:0.85em;border-bottom:1px solid var(--c-border)">
                        <span style="color:var(--c-white)">@inv.InvitedPlayerUsername</span>
                        <RadzenBadge Text="@inv.Status.ToString()" BadgeStyle="@InvBadge(inv.Status)" />
                    </div>
                }
            </div>
        }
    </div>

    @* ── REGISTER FOR TOURNAMENT ── *@
    @if (_isCaptain && _openTournaments.Any())
    {
        <div class="glass-card" style="margin-top:20px">
            <div class="section-header">
                <span class="section-title">🏆 Inscribir en Torneo</span>
                <div class="section-header-line"></div>
            </div>
            <div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin-top:4px">
                <RadzenDropDown @bind-Value="_selectedTournamentId"
                                Data="@_openTournaments"
                                TextProperty="Name" ValueProperty="Id"
                                Placeholder="Selecciona un torneo..."
                                Style="min-width:280px" AllowClear="true"
                                Change="@(_ => _registrationWarning = null)" />
                <RadzenButton Text="Inscribir Equipo" Icon="how_to_reg" ButtonStyle="ButtonStyle.Success"
                              Click="@RegisterForTournamentAsync"
                              Disabled="@(_busy || _selectedTournamentId == Guid.Empty)" />
            </div>
            @if (!string.IsNullOrEmpty(_registrationWarning))
            {
                <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" Variant="Variant.Flat"
                             style="margin-top:10px;font-size:13px">@_registrationWarning</RadzenAlert>
            }
        </div>
    }
}

</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool _loading = true;
    private bool _busy;
    private bool _profileComplete;
    private bool _isCaptain;
    private Guid _myPlayerId;
    private string? _error;
    private string? _success;

    private TeamDto? _team;
    private CreateTeamDto _createDto = new();
    private UpdateTeamDto _editDto = new();
    private bool _editOpen;

    // App search
    private string _searchMode = "app";
    private string _searchQuery = "";
    private List<WarzoneTournament.Application.DTOs.Player.PlayerListDto> _searchResults = new();

    // Discord search
    private string _discordQuery = "";
    private List<DiscordMemberSearchDto> _discordResults = new();
    private bool _discordBusy;
    private bool _discordSearched;
    private string? _discordError;
    private string? _guildId;

    private List<TeamInvitationDto> _sentInvitations = new();
    private List<TournamentListDto> _openTournaments = new();
    private Guid _selectedTournamentId;
    private string? _registrationWarning;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState!;
        var user = auth.User;
        _profileComplete = user.FindFirst("profile_complete")?.Value == "true";
        Guid.TryParse(user.FindFirst("player_id")?.Value, out _myPlayerId);

        if (!_profileComplete || _myPlayerId == Guid.Empty) { _loading = false; return; }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        var allTeams = await TeamService.GetTeamsAsync();
        if (allTeams.IsSuccess)
        {
            foreach (var t in allTeams.Value)
            {
                var detail = await TeamService.GetTeamByIdAsync(t.Id);
                if (detail.IsSuccess && detail.Value.Players.Any(p => p.PlayerId == _myPlayerId))
                {
                    _team = detail.Value;
                    _isCaptain = _team.CaptainId == _myPlayerId;
                    break;
                }
            }
        }

        if (_team is not null && _isCaptain)
        {
            var sent = await InvitationService.GetSentByTeamAsync(_team.Id);
            if (sent.IsSuccess) _sentInvitations = sent.Value.ToList();

            _editDto = new UpdateTeamDto
            {
                Name = _team.Name,
                Tag = _team.Tag,
                LogoUrl = _team.LogoUrl,
                PreferredPlatform = _team.PreferredPlatform
            };
        }

        var tourRes = await TournamentService.GetTournamentsAsync(new TournamentQueryDto
        {
            Status = TournamentStatus.Registration,
            PageSize = 50, PageNumber = 1
        });
        if (tourRes.IsSuccess) _openTournaments = tourRes.Value.Items.ToList();

        var settings = await SiteSettings.GetAsync();
        _guildId = settings.DefaultDiscordGuildId;

        _loading = false;
    }

    private async Task CreateTeamAsync()
    {
        if (string.IsNullOrWhiteSpace(_createDto.Name)) { _error = "El nombre es obligatorio."; return; }
        _busy = true; _error = null;
        _createDto.CaptainId = _myPlayerId;
        _createDto.PlayerIds = new List<Guid> { _myPlayerId };
        var result = await TeamService.CreateTeamAsync(_createDto);
        if (result.IsSuccess) { _team = result.Value; _isCaptain = true; _success = "¡Equipo creado!"; await LoadAsync(); }
        else _error = result.Error;
        _busy = false;
    }

    private async Task SearchPlayersAsync()
    {
        if (string.IsNullOrWhiteSpace(_searchQuery)) return;
        var res = await PlayerService.SearchPlayersAsync(_searchQuery);
        if (res.IsSuccess) _searchResults = res.Value.Where(p => p.Id != _myPlayerId).Take(5).ToList();
    }

    private async Task SendInviteAsync(Guid playerId)
    {
        _busy = true; _error = null;
        var result = await InvitationService.SendAsync(_team!.Id, _myPlayerId, playerId, null);
        if (result.IsSuccess)
        {
            _success = "Invitación enviada.";
            _searchResults.Clear();
            var sent = await InvitationService.GetSentByTeamAsync(_team.Id);
            if (sent.IsSuccess) _sentInvitations = sent.Value.ToList();
        }
        else _error = result.Error;
        _busy = false;
    }

    private async Task RemovePlayerAsync(Guid playerId)
    {
        var player = _team!.Players.FirstOrDefault(p => p.PlayerId == playerId);
        if (player is null) return;

        var confirmed = await DialogSvc.Confirm(
            $"¿Eliminar a <strong>{player.Username}</strong> del equipo?",
            "Confirmar eliminación",
            new ConfirmOptions { OkButtonText = "Eliminar", CancelButtonText = "Cancelar", CloseDialogOnOverlayClick = true });
        if (confirmed != true) return;

        _busy = true; _error = null;
        var result = await TeamService.RemovePlayerFromTeamAsync(_team.Id, playerId);
        if (result.IsSuccess) { _success = $"{player.Username} fue eliminado del equipo."; await LoadAsync(); }
        else _error = result.Error;
        _busy = false;
    }

    private async Task RegisterForTournamentAsync()
    {
        if (_selectedTournamentId == Guid.Empty) return;
        _registrationWarning = null;

        var tournament = _openTournaments.FirstOrDefault(t => t.Id == _selectedTournamentId);
        if (tournament is not null && tournament.PlayersPerTeam > 0)
        {
            var teamCount = _team!.Players.Count;
            if (teamCount != tournament.PlayersPerTeam)
            {
                _registrationWarning = $"Este torneo requiere exactamente {tournament.PlayersPerTeam} jugadores por equipo. " +
                                       $"Tu equipo tiene {teamCount}. " +
                                       (teamCount < tournament.PlayersPerTeam ? "Invita más jugadores antes de inscribirte." : "Tienes demasiados jugadores.");
                return;
            }
        }

        var confirmed = await DialogSvc.Confirm(
            $"¿Inscribir al equipo <strong>{_team!.Name}</strong> en el torneo <strong>{tournament?.Name}</strong>?",
            "Confirmar inscripción",
            new ConfirmOptions { OkButtonText = "Inscribir", CancelButtonText = "Cancelar", CloseDialogOnOverlayClick = true });
        if (confirmed != true) return;

        _busy = true; _error = null;
        var result = await TeamService.RegisterTeamForTournamentAsync(_team!.Id, _selectedTournamentId);
        if (result.IsSuccess) _success = $"¡Equipo inscrito en {tournament?.Name}!";
        else _error = result.Error;
        _busy = false;
    }

    private async Task UpdateTeamAsync()
    {
        if (string.IsNullOrWhiteSpace(_editDto.Name)) { _error = "El nombre del equipo es obligatorio."; return; }
        _busy = true; _error = null;
        var result = await TeamService.UpdateTeamAsync(_team!.Id, _editDto);
        if (result.IsSuccess)
        {
            _success = "Equipo actualizado correctamente.";
            _editOpen = false;
            await LoadAsync();
        }
        else _error = result.Error;
        _busy = false;
    }

    private void SetSearchMode(string mode)
    {
        _searchMode = mode;
        _searchResults.Clear();
        _discordResults.Clear();
        _discordSearched = false;
        _discordError = null;
        _searchQuery = "";
        _discordQuery = "";
    }

    private async Task SearchDiscordAsync()
    {
        if (string.IsNullOrWhiteSpace(_discordQuery)) return;
        if (string.IsNullOrEmpty(_guildId))
        {
            _discordError = "El Guild ID de Discord no está configurado en Configuración Global.";
            return;
        }
        _discordBusy = true;
        _discordError = null;
        _discordResults.Clear();
        _discordSearched = false;

        var result = await DiscordService.SearchGuildMembersAsync(_guildId, _discordQuery, 10);
        if (result.IsSuccess)
            _discordResults = result.Value.ToList();
        else
            _discordError = result.Error;

        _discordSearched = true;
        _discordBusy = false;
    }

    private async Task SendDiscordInviteAsync(string discordId)
    {
        _busy = true; _error = null;
        var result = await InvitationService.SendDiscordInviteAsync(_team!.Id, _myPlayerId, discordId, null);
        if (result.IsSuccess)
        {
            _success = "Invitación enviada por Discord. El jugador la recibirá al registrarse.";
            _discordResults.Clear();
            _discordSearched = false;
            _discordQuery = "";
        }
        else _error = result.Error;
        _busy = false;
    }

    private static BadgeStyle InvBadge(InvitationStatus s) => s switch
    {
        InvitationStatus.Accepted => BadgeStyle.Success,
        InvitationStatus.Declined => BadgeStyle.Danger,
        InvitationStatus.Expired  => BadgeStyle.Light,
        _                         => BadgeStyle.Warning
    };
}
