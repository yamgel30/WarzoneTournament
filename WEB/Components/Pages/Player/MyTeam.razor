@page "/my-team"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@using WarzoneTournament.Application.Common.Interfaces
@using WarzoneTournament.Application.DTOs.Team
@using WarzoneTournament.Application.DTOs.Tournament
@using WarzoneTournament.Domain.Enums
@inject ITeamService TeamService
@inject ITeamInvitationService InvitationService
@inject ITournamentService TournamentService
@inject IPlayerService PlayerService
@inject NavigationManager NavManager

<PageTitle>Mi Equipo — Warzone Tournament</PageTitle>

<div class="page-container">

@if (_loading) {
    <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
} else if (!_profileComplete) {
    <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true">
        Completa tu perfil primero. <a href="/profile/setup">Ir a configuración de perfil</a>
    </RadzenAlert>
} else if (_team is null) {

    @* ── CREATE TEAM FORM ── *@
    <div class="page-header">
        <h1 class="page-title">Crear mi Equipo</h1>
    </div>
    <RadzenCard style="max-width:520px">
        @if (!string.IsNullOrEmpty(_error)) {
            <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" Variant="Variant.Flat" class="mb-3">@_error</RadzenAlert>
        }
        <div class="form-field" style="margin-bottom:14px">
            <RadzenLabel Text="Nombre del equipo *" />
            <RadzenTextBox @bind-Value="_createDto.Name" Style="width:100%;margin-top:4px" Placeholder="Ej: Shadow Wolves" />
        </div>
        <div class="form-field" style="margin-bottom:14px">
            <RadzenLabel Text="Tag del equipo (3-5 letras)" />
            <RadzenTextBox @bind-Value="_createDto.Tag" Style="width:100%;margin-top:4px" Placeholder="Ej: SHW" />
        </div>
        <div class="form-field" style="margin-bottom:14px">
            <RadzenLabel Text="Logo del equipo" />
            <div style="margin-top:4px"><ImageUploadField @bind-Value="_createDto.LogoUrl" /></div>
        </div>
        <div class="form-field" style="margin-bottom:20px">
            <RadzenLabel Text="Plataforma" />
            <RadzenDropDown @bind-Value="_createDto.PreferredPlatform" Data="@(Enum.GetValues<Platform>())" Style="width:100%;margin-top:4px" />
        </div>
        <RadzenButton Text="Crear Equipo" Icon="group_add" ButtonStyle="ButtonStyle.Primary"
                      Click="@CreateTeamAsync" Disabled="@_busy" />
    </RadzenCard>

} else {

    @* ── TEAM MANAGEMENT ── *@
    <div class="page-header">
        <div style="display:flex;align-items:center;gap:16px">
            @if (!string.IsNullOrEmpty(_team.LogoUrl)) {
                <img src="@_team.LogoUrl" style="width:56px;height:56px;border-radius:8px;object-fit:cover;border:2px solid var(--rz-primary)" />
            }
            <div>
                <h1 class="page-title" style="margin:0">@_team.Name</h1>
                @if (!string.IsNullOrEmpty(_team.Tag)) { <small style="color:var(--rz-text-secondary-color)">[@_team.Tag]</small> }
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_error)) {
        <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" Variant="Variant.Flat" class="mb-3">@_error</RadzenAlert>
    }
    @if (!string.IsNullOrEmpty(_success)) {
        <RadzenAlert AlertStyle="AlertStyle.Success" ShowIcon="true" Variant="Variant.Flat" class="mb-3">@_success</RadzenAlert>
    }

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:16px">

        @* ── MEMBERS ── *@
        <RadzenCard>
            <h3 style="margin-bottom:12px">👥 Miembros (@_team.Players.Count)</h3>
            @foreach (var p in _team.Players) {
                <div style="display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid rgba(255,255,255,0.06)">
                    <span style="font-weight:600;color:var(--rz-text-color)">@p.Username</span>
                    @if (_team.CaptainId.HasValue && p.PlayerId == _team.CaptainId) {
                        <RadzenBadge Text="Capitán" BadgeStyle="BadgeStyle.Warning" />
                    }
                </div>
            }
        </RadzenCard>

        @* ── INVITE PLAYER ── *@
        @if (_isCaptain) {
        <RadzenCard>
            <h3 style="margin-bottom:12px">✉️ Invitar jugador</h3>
            <div style="display:flex;gap:8px;margin-bottom:10px">
                <RadzenTextBox @bind-Value="_searchQuery" Placeholder="Buscar por gamer tag..."
                               Style="flex:1" @onkeyup="@(async e => { if(e.Key=="Enter") await SearchPlayersAsync(); })" />
                <RadzenButton Text="Buscar" Icon="search" ButtonStyle="ButtonStyle.Light"
                              Click="@SearchPlayersAsync" Disabled="@_busy" />
            </div>
            @if (_searchResults.Any()) {
                <div style="margin-bottom:12px">
                    @foreach (var p in _searchResults) {
                        <div style="display:flex;align-items:center;justify-content:space-between;padding:6px 0;border-bottom:1px solid rgba(255,255,255,0.06)">
                            <span>@p.Username</span>
                            <RadzenButton Text="Invitar" Icon="send" ButtonStyle="ButtonStyle.Primary"
                                          Size="ButtonSize.Small" Click="@(() => SendInviteAsync(p.Id))" Disabled="@_busy" />
                        </div>
                    }
                </div>
            }

            <h4 style="margin:16px 0 8px;font-size:0.85em;color:var(--rz-text-secondary-color)">Invitaciones enviadas</h4>
            @foreach (var inv in _sentInvitations) {
                <div style="display:flex;align-items:center;justify-content:space-between;padding:5px 0;font-size:0.85em;border-bottom:1px solid rgba(255,255,255,0.04)">
                    <span>@inv.InvitedPlayerUsername</span>
                    <RadzenBadge Text="@inv.Status.ToString()" BadgeStyle="@InvBadge(inv.Status)" />
                </div>
            }
        </RadzenCard>
        }
    </div>

    @* ── REGISTER FOR TOURNAMENT ── *@
    @if (_isCaptain && _openTournaments.Any()) {
    <RadzenCard style="margin-top:20px">
        <h3 style="margin-bottom:12px">🏆 Inscribir equipo en torneo</h3>
        <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap">
            <RadzenDropDown @bind-Value="_selectedTournamentId"
                            Data="@_openTournaments"
                            TextProperty="Name" ValueProperty="Id"
                            Placeholder="Selecciona un torneo..."
                            Style="min-width:280px" AllowClear="true" />
            <RadzenButton Text="Inscribir" Icon="how_to_reg" ButtonStyle="ButtonStyle.Success"
                          Click="@RegisterForTournamentAsync"
                          Disabled="@(_busy || _selectedTournamentId == Guid.Empty)" />
        </div>
    </RadzenCard>
    }
}

</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool _loading = true;
    private bool _busy;
    private bool _profileComplete;
    private bool _isCaptain;
    private Guid _myPlayerId;
    private string? _error;
    private string? _success;

    private TeamDto? _team;
    private CreateTeamDto _createDto = new();
    private string _searchQuery = "";
    private List<WarzoneTournament.Application.DTOs.Player.PlayerListDto> _searchResults = new();
    private List<TeamInvitationDto> _sentInvitations = new();
    private List<TournamentListDto> _openTournaments = new();
    private Guid _selectedTournamentId;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState!;
        var user = auth.User;
        _profileComplete = user.FindFirst("profile_complete")?.Value == "true";
        Guid.TryParse(user.FindFirst("player_id")?.Value, out _myPlayerId);

        if (!_profileComplete || _myPlayerId == Guid.Empty) { _loading = false; return; }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        // Find team where this player is captain or member
        var allTeams = await TeamService.GetTeamsAsync();
        if (allTeams.IsSuccess)
        {
            foreach (var t in allTeams.Value)
            {
                var detail = await TeamService.GetTeamByIdAsync(t.Id);
                if (detail.IsSuccess && detail.Value.Players.Any(p => p.PlayerId == _myPlayerId))
                {
                    _team = detail.Value;
                    _isCaptain = _team.CaptainId == _myPlayerId;
                    break;
                }
            }
        }

        if (_team is not null && _isCaptain)
        {
            var sent = await InvitationService.GetSentByTeamAsync(_team.Id);
            if (sent.IsSuccess) _sentInvitations = sent.Value.ToList();
        }

        // Open tournaments (Registration status)
        var tourRes = await TournamentService.GetTournamentsAsync(new WarzoneTournament.Application.DTOs.Tournament.TournamentQueryDto
        {
            Status = WarzoneTournament.Domain.Enums.TournamentStatus.Registration,
            PageSize = 50, PageNumber = 1
        });
        if (tourRes.IsSuccess) _openTournaments = tourRes.Value.Items.ToList();

        _loading = false;
    }

    private async Task CreateTeamAsync()
    {
        if (string.IsNullOrWhiteSpace(_createDto.Name)) { _error = "El nombre es obligatorio."; return; }
        _busy = true; _error = null;
        _createDto.CaptainId = _myPlayerId;
        _createDto.PlayerIds = new List<Guid> { _myPlayerId };
        var result = await TeamService.CreateTeamAsync(_createDto);
        if (result.IsSuccess)
        {
            _team = result.Value;
            _isCaptain = true;
            _success = "¡Equipo creado!";
            await LoadAsync();
        }
        else _error = result.Error;
        _busy = false;
    }

    private async Task SearchPlayersAsync()
    {
        if (string.IsNullOrWhiteSpace(_searchQuery)) return;
        var res = await PlayerService.SearchPlayersAsync(_searchQuery);
        if (res.IsSuccess)
            _searchResults = res.Value
                .Where(p => p.Id != _myPlayerId)
                .Take(5).ToList();
    }

    private async Task SendInviteAsync(Guid playerId)
    {
        _busy = true; _error = null;
        var result = await InvitationService.SendAsync(_team!.Id, _myPlayerId, playerId, null);
        if (result.IsSuccess)
        {
            _success = "Invitación enviada.";
            _searchResults.Clear();
            var sent = await InvitationService.GetSentByTeamAsync(_team.Id);
            if (sent.IsSuccess) _sentInvitations = sent.Value.ToList();
        }
        else _error = result.Error;
        _busy = false;
    }

    private async Task RegisterForTournamentAsync()
    {
        if (_selectedTournamentId == Guid.Empty) return;
        _busy = true; _error = null;
        var result = await TeamService.RegisterTeamForTournamentAsync(_team!.Id, _selectedTournamentId);
        if (result.IsSuccess)
            _success = "¡Equipo inscrito en el torneo!";
        else
            _error = result.Error;
        _busy = false;
    }

    private static BadgeStyle InvBadge(WarzoneTournament.Domain.Enums.InvitationStatus s) => s switch
    {
        InvitationStatus.Accepted => BadgeStyle.Success,
        InvitationStatus.Declined => BadgeStyle.Danger,
        InvitationStatus.Expired  => BadgeStyle.Light,
        _ => BadgeStyle.Warning
    };
}
