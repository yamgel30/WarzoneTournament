@page "/profile/setup"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using WarzoneTournament.Application.Common.Interfaces
@using WarzoneTournament.Application.DTOs.Auth
@using WarzoneTournament.Domain.Enums
@inject IUserService UserService
@inject NavigationManager NavManager

<PageTitle>Configura tu perfil — Warzone Tournament</PageTitle>

<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;padding:20px;background:linear-gradient(135deg,#01020E,#040B41)">
    <div style="background:rgba(4,11,65,0.9);border:1px solid rgba(34,110,236,0.3);border-radius:16px;padding:40px;width:100%;max-width:480px;backdrop-filter:blur(12px)">
        <div style="text-align:center;margin-bottom:32px">
            @if (!string.IsNullOrEmpty(_avatarUrl))
            {
                <img src="@_avatarUrl" style="width:80px;height:80px;border-radius:50%;border:3px solid #0833D4;margin-bottom:12px" />
            }
            <h2 style="color:#6CA4F1;font-size:1.4em;font-weight:900;margin:0">Completa tu perfil</h2>
            <p style="color:#3F5497;font-size:0.85em;margin-top:6px">Solo necesitas hacer esto una vez</p>
        </div>

        @if (_error is not null)
        {
            <div style="background:rgba(239,68,68,0.15);border:1px solid #ef4444;border-radius:8px;padding:10px 14px;color:#fca5a5;font-size:0.85em;margin-bottom:16px">@_error</div>
        }

        <div style="margin-bottom:16px">
            <label style="display:block;font-size:0.82em;color:#6CA4F1;margin-bottom:6px;font-weight:700">NOMBRE A MOSTRAR</label>
            <input @bind="_displayName" placeholder="@_discordUsername"
                   style="width:100%;padding:10px 14px;background:rgba(8,51,212,0.2);border:1px solid rgba(34,110,236,0.3);border-radius:8px;color:#e0e0f0;font-size:0.95em;outline:none" />
            <small style="color:#3F5497;font-size:0.78em">Cómo te verán otros jugadores. Por defecto tu usuario de Discord.</small>
        </div>

        <div style="margin-bottom:16px">
            <label style="display:block;font-size:0.82em;color:#6CA4F1;margin-bottom:6px;font-weight:700">GAMER TAG (en juego)</label>
            <input @bind="_gamerTag" placeholder="TuNombre#1234 o BattleTag"
                   style="width:100%;padding:10px 14px;background:rgba(8,51,212,0.2);border:1px solid rgba(34,110,236,0.3);border-radius:8px;color:#e0e0f0;font-size:0.95em;outline:none" />
        </div>

        <div style="margin-bottom:24px">
            <label style="display:block;font-size:0.82em;color:#6CA4F1;margin-bottom:6px;font-weight:700">PLATAFORMA</label>
            <select @bind="_platform"
                    style="width:100%;padding:10px 14px;background:rgba(8,51,212,0.2);border:1px solid rgba(34,110,236,0.3);border-radius:8px;color:#e0e0f0;font-size:0.95em;outline:none">
                @foreach (var p in Enum.GetValues<Platform>())
                {
                    <option value="@p">@p</option>
                }
            </select>
        </div>

        <button @onclick="SaveAsync" disabled="@_saving"
                style="width:100%;padding:13px;background:linear-gradient(90deg,#0833D4,#226EEC);border:none;border-radius:10px;color:#fff;font-size:1em;font-weight:700;cursor:pointer">
            @(_saving ? "Guardando..." : "Comenzar →")
        </button>
    </div>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private string _displayName = "";
    private string _gamerTag = "";
    private Platform _platform = Platform.PC;
    private string? _error;
    private bool _saving;
    private string? _avatarUrl;
    private string _discordUsername = "";
    private Guid _userId;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState!;
        var user = auth.User;

        var profileComplete = user.FindFirst("profile_complete")?.Value == "true";
        if (profileComplete)
        {
            NavManager.NavigateTo("/", replace: true);
            return;
        }

        _discordUsername = user.Identity?.Name ?? "";
        _displayName = _discordUsername;
        var discordId = user.FindFirst("discord_id")?.Value ?? "";
        var avatarHash = user.FindFirst("avatar_hash")?.Value;
        if (!string.IsNullOrEmpty(discordId) && !string.IsNullOrEmpty(avatarHash))
            _avatarUrl = $"https://cdn.discordapp.com/avatars/{discordId}/{avatarHash}.png";

        Guid.TryParse(user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out _userId);
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_gamerTag)) { _error = "El Gamer Tag es obligatorio."; return; }

        _saving = true; _error = null;
        var name = string.IsNullOrWhiteSpace(_displayName) ? _discordUsername : _displayName;
        var result = await UserService.CompleteProfileAsync(_userId, name, _gamerTag, _platform);
        if (result.IsSuccess)
            NavManager.NavigateTo("/", forceLoad: true); // force reload to refresh claims
        else
            _error = result.Error;
        _saving = false;
    }
}
