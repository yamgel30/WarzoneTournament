
@inject NavigationManager NavManager
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization

<AuthorizeView>
    <Authorized>
        @{
            var isAdmin = context.User.IsInRole("Admin");
            var displayName = context.User.Identity?.Name ?? "Player";
            var discordId = context.User.FindFirst("discord_id")?.Value ?? "";
            var avatarHash = context.User.FindFirst("avatar_hash")?.Value ?? "";
            var avatarUrl = !string.IsNullOrEmpty(avatarHash)
                ? $"https://cdn.discordapp.com/avatars/{discordId}/{avatarHash}.png"
                : "https://cdn.discordapp.com/embed/avatars/0.png";
        }
        <div class="nav-user-card">
            <img class="nav-avatar" src="@avatarUrl" alt="avatar" />
            <div>
                <div class="nav-user-name">@displayName</div>
                <div class="nav-user-role @(isAdmin ? "admin" : "")">@(isAdmin ? "Admin" : "Player")</div>
            </div>
        </div>

        <RadzenPanelMenu>
            @if (isAdmin) {
                <RadzenPanelMenuItem Text="Dashboard" Icon="dashboard" Path="/" />
                <RadzenPanelMenuItem Text="Tournaments" Icon="emoji_events">
                    <RadzenPanelMenuItem Text="All Tournaments" Icon="list" Path="/tournaments" />
                    <RadzenPanelMenuItem Text="Create Tournament" Icon="add_circle" Path="/tournaments/create" />
                </RadzenPanelMenuItem>
                <RadzenPanelMenuItem Text="Teams" Icon="groups">
                    <RadzenPanelMenuItem Text="All Teams" Icon="list" Path="/teams" />
                </RadzenPanelMenuItem>
                <RadzenPanelMenuItem Text="Players" Icon="person">
                    <RadzenPanelMenuItem Text="All Players" Icon="list" Path="/players" />
                </RadzenPanelMenuItem>
                <RadzenPanelMenuItem Text="Leaderboard" Icon="leaderboard" Path="/leaderboard" />
                <RadzenPanelMenuItem Text="Admin" Icon="admin_panel_settings">
                    <RadzenPanelMenuItem Text="Dashboard" Icon="dashboard" Path="/admin" />
                    <RadzenPanelMenuItem Text="Evidence Review" Icon="fact_check" Path="/admin/evidence" />
                    <RadzenPanelMenuItem Text="Manual Points" Icon="add_box" Path="/admin/manual-points" />
                    <RadzenPanelMenuItem Text="Hangfire Jobs" Icon="schedule" Path="/hangfire" />
                    <RadzenPanelMenuItem Text="Configuración Global" Icon="settings" Path="/admin/settings" />
                </RadzenPanelMenuItem>
            } else {
                <RadzenPanelMenuItem Text="Leaderboard" Icon="leaderboard" Path="/leaderboard" />
                <RadzenPanelMenuItem Text="Mi Equipo" Icon="groups" Path="/my-team" />
                <RadzenPanelMenuItem Text="Invitaciones" Icon="mail" Path="/invitations" />
                <RadzenPanelMenuItem Text="Mi Perfil" Icon="person" Path="/profile" />
                <RadzenPanelMenuItem Text="Subir Evidencia" Icon="upload" Path="/submit-evidence" />
            }
            <RadzenPanelMenuItem Text="Cerrar Sesión" Icon="logout" Click="@Logout" />
        </RadzenPanelMenu>
    </Authorized>
    <NotAuthorized>
        <RadzenPanelMenu>
            <RadzenPanelMenuItem Text="Iniciar sesión" Icon="login" Click="@GoLogin" />
        </RadzenPanelMenu>
    </NotAuthorized>
</AuthorizeView>

@code {
    private void Logout() => NavManager.NavigateTo("/logout", forceLoad: true);
    private void GoLogin() => NavManager.NavigateTo("/login", forceLoad: true);
}
