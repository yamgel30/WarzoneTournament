@page "/login"
@model WEB.Pages.LoginModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar sesión — Warzone Tournament</title>
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            min-height: 100vh;
            display: flex; align-items: center; justify-content: center;
            background: linear-gradient(135deg, #01020E 0%, #040B41 100%);
            font-family: 'Segoe UI', system-ui, sans-serif;
            color: #e0e0f0;
        }
        .card {
            background: rgba(4,11,65,0.85);
            border: 1px solid rgba(34,110,236,0.3);
            border-radius: 16px;
            padding: 48px 40px;
            width: 100%; max-width: 400px;
            box-shadow: 0 0 60px rgba(8,51,212,0.3);
            backdrop-filter: blur(12px);
        }
        .logo { text-align: center; margin-bottom: 36px; }
        .logo .icon { font-size: 2.8rem; display: block; margin-bottom: 10px; }
        .logo h1 { font-size: 1.3rem; font-weight: 900; color: #6CA4F1; letter-spacing: 2px; }
        .logo p  { font-size: 0.82rem; color: #3F5497; margin-top: 6px; }
        .discord-btn {
            display: flex; align-items: center; justify-content: center; gap: 12px;
            width: 100%; padding: 14px 20px;
            background: #5865F2; border: none; border-radius: 10px;
            color: #fff; font-size: 1rem; font-weight: 700;
            cursor: pointer; text-decoration: none;
            transition: background .2s, transform .1s;
        }
        .discord-btn:hover { background: #4752c4; transform: translateY(-1px); }
        .discord-btn svg { flex-shrink: 0; }
        .divider { text-align: center; margin: 24px 0; color: #3F5497; font-size: 0.8em; }
        .admin-link {
            display: block; text-align: center;
            color: #3F5497; font-size: 0.82rem;
            text-decoration: none; transition: color .2s;
        }
        .admin-link:hover { color: #6CA4F1; }
        .error {
            background: rgba(239,68,68,0.15); border: 1px solid #ef4444;
            border-radius: 8px; padding: 10px 14px;
            color: #fca5a5; font-size: 0.85rem; margin-bottom: 20px;
        }
    </style>
</head>
<body>
    <div class="card">
        <div class="logo">
            <span class="icon">&#x26A1;</span>
            <h1>WARZONE TOURNAMENT</h1>
            <p>Plataforma de torneos competitivos</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.Error))
        {
            <div class="error">@Model.Error</div>
        }

        <form method="post" asp-page-handler="Discord">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
            <button type="submit" class="discord-btn">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="white">
                    <path d="M20.317 4.37a19.791 19.791 0 00-4.885-1.515.074.074 0 00-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 00-5.487 0 12.64 12.64 0 00-.617-1.25.077.077 0 00-.079-.037A19.736 19.736 0 003.677 4.37a.07.07 0 00-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 00.031.057 19.9 19.9 0 005.993 3.03.078.078 0 00.084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 00-.041-.106 13.107 13.107 0 01-1.872-.892.077.077 0 01-.008-.128 10.2 10.2 0 00.372-.292.074.074 0 01.077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 01.078.01c.12.098.246.198.373.292a.077.077 0 01-.006.127 12.299 12.299 0 01-1.873.892.077.077 0 00-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 00.084.028 19.839 19.839 0 006.002-3.03.077.077 0 00.032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 00-.031-.03z"/>
                </svg>
                Continuar con Discord
            </button>
        </form>

        <div class="divider">&#x2501;&#x2501;&#x2501;&#x2501;&#x2501;&#x2501;&#x2501;&#x2501;&#x2501;&#x2501;&#x2501;&#x2501;&#x2501;&#x2501;&#x2501;</div>
        <a href="/admin/login" class="admin-link">&#x1F510; Acceso de administrador</a>
    </div>
</body>
</html>
