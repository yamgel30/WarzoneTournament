                                   ByVal isNew As Boolean, ByVal pageNumber As Integer, ByVal validateAHA As Boolean) As AHASubmissionResponse Implements IAHAService12.PartialSaveAHA

        Dim debugOn As Boolean = False
        Dim requestXML As String = String.Empty
        Dim errorMessage As String = "initialized"

        If AppSettings("DebugOn") IsNot Nothing AndAlso Boolean.Parse(AppSettings("DebugOn")) Then
            debugOn = True
            requestXML = SerializeObject(ahaForm)
        End If

        Dim _Response As New AHASubmissionResponse

        Try
            'Dim token As String = CreateSessionToken(loginToken, sourceIP)

            'If ValidateSession(accountID, token) Then

            If ahaForm.FormHeader.AtHome Is Nothing OrElse ahaForm.FormHeader.AtHome.Value Is Nothing Then
                ahaForm.FormHeader.AtHome = New BooleanField With {.Value = False}
            End If

            errorMessage = "validate session passed"

