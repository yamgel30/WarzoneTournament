    Public Function CheckMemberHasAHA(memberID As String, isEdit As Boolean, isResubmit As Boolean, ahaYear As Integer, atHome As Boolean) As GenericResponse Implements IAHAService12.CheckMemberHasAHA

        '/*************************************************************
        ' * # CHANGE #
        ' * Brian Melendez
        ' * 2021-05-06
        ' * Bug - Duplicated AHAs
        ' * -----------------------------------------------------------
        ' * There was an error that allowed an AHA to be created via the New button even if it had one for the year, this is not allowed.
        ' * The error ocurred when the RejectTypeId was NULL, the validation of not equal to 1 failed
        ' *------------------------------------------------------------
        ' * # SOLUTION #
        ' * ISNULL was used to correct this problem
        ' *************************************************************/



        Dim resp As New GenericResponse
        Dim dbo As New SqlDataObject(ConnectionStrings(AppSettings("DBClaimAttach").ToString).ConnectionString, True)
        Dim cmd As SqlCommand = New SqlCommand()
        Dim countOfSubmitted As Integer = 0

        Dim claimClass As Integer = GetClaimClassByYear(ahaYear)

        Try

            If (Not isEdit) AndAlso (Not isResubmit) Then

                Dim qry As New StringBuilder

                qry.Append("SELECT ISNULL(COUNT(*),0) AS 'CountOfSubmitted'")
                qry.Append(" FROM Claims WITH (NOLOCK)")
                qry.Append(" INNER JOIN vwMSV_Master WITH (NOLOCK) ON Claims.sPatientContract = vwMSV_Master.memberID")
                qry.Append(" INNER Join Claims_AHADetail WITH (NOLOCK) ON Claims_AHADetail.biClaimID = Claims.biClaimID")
                qry.Append(" WHERE Claims.iStatus > 1")

                'qry.Append(" AND Claims.RejectTypeId <> 1") 'This validation fails when RejectTypeId is NULL
                qry.Append(" AND ISNULL(Claims.RejectTypeId, 0) <> 1")

                qry.AppendFormat(" AND Claims.nClaimClass = {0}", claimClass)
                qry.AppendFormat(" AND Claims.nClaimClassTag = 1") 'Only verifies AHA no THA
                qry.Append(" AND vwMSV_Master.useForPCPEligibility = 1")
                qry.Append(" AND Claims.sPatientContract = @sPatientContract")
                qry.AppendFormat(" AND Claims_AHADetail.AtHome = {0}", If(atHome, "1", "0"))
                'qry.AppendFormat(" AND vwMSV_Master.billingNPI IN ({0})", firstPlusDummyProvider)
                'qry.AppendFormat(" AND vwMSV_Master.renderingNPI IN ({0})", firstPlusDummyProvider)

                cmd.CommandType = CommandType.Text
                cmd.CommandText = qry.ToString()

                cmd.Parameters.AddWithValue("@sPatientContract", memberID)

                Dim dr As SqlDataReader = dbo.GetReader(cmd)

                If dr.HasRows AndAlso dr.Read() Then
                    countOfSubmitted = dr("CountOfSubmitted")
                End If

                If Not dr.IsClosed Then dr.Close()
            End If

            resp.ErrorNumber = 0

            If (countOfSubmitted > 0) Then
                resp.ErrorNumber = 4
            End If

        Catch ex As Exception
            Globals.LogError(0, MethodBase.GetCurrentMethod.DeclaringType.Name, MethodBase.GetCurrentMethod.Name, "", ex.Message, ex.StackTrace)
            resp.ErrorNumber = -1
            resp.ReturnValue = "Internal Error"
        Finally
            cmd.Dispose()
        End Try

        Return resp

    End Function

    Public Function SaveError(ByVal sessionId As String, ByVal message As String, ByVal trace As String, ByVal requestTime As Integer?, ByVal errorCode As String, ByVal className As String) As Integer Implements IAHAService12.SaveError
        Dim errorMessage As String = String.Empty
        Try

            Dim ahaDataAdapter As AHADataAdapter = New AHADataAdapter()
            Dim errorL = New ErrorLog
            Dim sessionIdLong As Long

            If Long.TryParse(sessionId, sessionIdLong) Then
                errorL.SessionID = sessionIdLong
            Else
                errorL.SessionID = 0
            End If
            errorL.ClassName = className 'MethodBase.GetCurrentMethod.DeclaringType.Name
            errorL.Message = message
            errorL.StrackTrace = trace
            errorL.CreationDate = DateTime.Now
            errorL.MethodParameters = MethodBase.GetCurrentMethod.GetParameters.ToString()
            errorL.Method = errorCode 'MethodBase.GetCurrentMethod.Name
            errorL.RequestTimeSeconds = requestTime
            ahaDataAdapter.ErrorLog_Insert(errorL)

            Return 1
        Catch e As Exception
            errorMessage = e.Message
            Globals.LogError(0, MethodBase.GetCurrentMethod.DeclaringType.Name, MethodBase.GetCurrentMethod.Name, "", e.Message, e.StackTrace)
        End Try
    End Function

