        _DBO = New SqlDataObject(ConnectionStrings(AppSettings("DBClaimAttach").ToString).ConnectionString, True)
    End Sub

    Private Function ValidateSession(ByVal accountID As String, ByVal token As String) As Boolean
        Return ValidateSession(accountID, token, Nothing)
    End Function

    Private Function ValidateSession(ByVal accountID As String, ByVal token As String, ByVal dbo As SqlDataObject) As Boolean

        Dim sqlCMD As New SqlCommand
        Dim ok As Boolean = False

        Try

            sqlCMD.CommandType = CommandType.StoredProcedure
            sqlCMD.CommandText = "uspValidate_AHASession"

            sqlCMD.Parameters.AddWithValue("@sAccountID", accountID)
            sqlCMD.Parameters.AddWithValue("@sToken", token)

            If dbo Is Nothing Then
                _DBO.OpenConnection()
            End If

            Dim sdr As SqlDataReader = _DBO.GetReader(sqlCMD, CommandBehavior.Default)

            If sdr.HasRows AndAlso sdr.Read Then
                _SessionKey = sdr("SessionKey")
                _AccountKey = sdr("AccountKey")
                ok = True
            End If

            sdr.Close()
        Catch ex As Exception
            Globals.LogError(0, MethodBase.GetCurrentMethod.DeclaringType.Name, MethodBase.GetCurrentMethod.Name, "", ex.Message, ex.StackTrace)
        Finally
            sqlCMD.Dispose()
            If dbo Is Nothing Then
                _DBO.CloseConnection()
            End If
        End Try

        Return ok

    End Function

    Public Shared Function CreateSessionToken(ByVal token As String, ByVal sourceIP As String) As String
        token = String.Concat(token, sourceIP.PadRight(20, "F"))
        Return Tools.Hash.GetMD5(Tools.Encode.GetBytes(token)).ToLower
    End Function

    Public Function Login(ByVal accountID As String, ByVal userID As String, ByVal password As String,
                          ByVal clientCert As String, ByVal previousLoginToken As String,
                          ByVal sourceIP As String, ByVal productID As String) As AUSAuthentication.LoginResponse Implements IAHAService12.Login

        Dim debugOn As Boolean = False
        Dim requestXML As String = String.Empty
        Dim errorMessage As String = String.Empty

        If AppSettings("DebugOn") IsNot Nothing AndAlso Boolean.Parse(AppSettings("DebugOn")) Then
            debugOn = True
        End If

        Dim s As New AHAFormItemShort


        Dim sqlCMD As New SqlCommand
        Dim serv As New AUSAuthentication.AuthenticationServiceClient
        Dim resp As New AUSAuthentication.LoginResponse

        Try
            resp = serv.Login1(accountID, userID, password, sourceIP)

            If resp.ErrorNumber = AHAEDM.Errors.Sucessfull Then

                'Create and Loggin Session Token
                Dim token As String = CreateSessionToken(resp.LoginToken, sourceIP)

                sqlCMD.CommandType = CommandType.StoredProcedure
                sqlCMD.CommandText = "uspAHASessions_Save"

                sqlCMD.Parameters.AddWithValue("@nAccountKey", resp.AccountUser.Account.AccountKey)
                sqlCMD.Parameters.AddWithValue("@sAccountID", resp.AccountUser.Account.AccountID)
                sqlCMD.Parameters.AddWithValue("@sLoginID", resp.AccountUser.UserID)
                sqlCMD.Parameters.AddWithValue("@sToken", token)
                sqlCMD.Parameters.AddWithValue("@sSourceIP", sourceIP)

                If Not _DBO.ExecuteCommand(sqlCMD) = 1 Then
                    resp.ErrorNumber = -1
                    resp.ReturnValue = "An error occur creating Session."
                End If
            End If

            Return resp

        Catch ex As Exception
            errorMessage = ex.Message
            Globals.LogError(0, MethodBase.GetCurrentMethod.DeclaringType.Name, MethodBase.GetCurrentMethod.Name, "", ex.Message, ex.StackTrace)
            Throw
        Finally
            sqlCMD.Dispose()
            If Not serv.State = CommunicationState.Closed Then
                serv.Close()
            End If

            If debugOn AndAlso resp.ErrorNumber <> 0 Then
                Dim logResp As New GenericResponse


                logResp.ErrorNumber = resp.ErrorNumber
                logResp.ReturnValue = resp.ReturnValue


                LogAHA(accountID, sourceIP, requestXML, logResp, "AHAServiceLogin", errorMessage)

            End If

        End Try

    End Function

    Public Function GetAHAListPending(ByVal accountID As String, ByVal loginToken As String,
                                      ByVal sourceIP As String, ByVal searchCriteria As SearchCriteria, ByVal sessionID As Long) As GetAHAListResponse Implements IAHAService12.GetAHAListPending

        Dim cmd As New SqlCommand
        Dim resp As New GetAHAListResponse

        If searchCriteria.AHAYear = 0 Then
            searchCriteria.AHAYear = AppShared.AHAVersion
        End If

        'searchCriteria.AHAYear = AppShared.AHAVersion
        searchCriteria.ClaimClass = GetClaimClassByYear(searchCriteria.AHAYear)

        Try

            'Dim token As String = CreateSessionToken(loginToken, sourceIP)

            'If ValidateSession(accountID, token) Then

            cmd.CommandType = CommandType.StoredProcedure
            cmd.CommandText = "uspAHA_GetPending"
            cmd.CommandTimeout = 120

            Dim renderingTable As New DataTable
            Dim drRendering As DataRow

            renderingTable.Columns.Add("NPI")

            For Each r In searchCriteria.RenderingNPIList

                drRendering = renderingTable.NewRow

                drRendering("NPI") = r

                renderingTable.Rows.Add(drRendering)

            Next

            Dim billingTable As New DataTable
            Dim drBilling As DataRow

            billingTable.Columns.Add("NPI")

            For Each b In searchCriteria.BillingNPIList

                drBilling = billingTable.NewRow

                drBilling("NPI") = b

                billingTable.Rows.Add(drBilling)

            Next

            With cmd.Parameters

                Dim param As New SqlParameter("RenderingNPIs", SqlDbType.Structured)
                param.Value = renderingTable

                .Add(param)

                param = New SqlParameter("BillingNPIs", SqlDbType.Structured)
                param.Value = billingTable

                .Add(param)

                If Not String.IsNullOrEmpty(searchCriteria.DateFrom) Then .AddWithValue("DateFrom", searchCriteria.DateFrom)
                If Not String.IsNullOrEmpty(searchCriteria.DateTo) Then .AddWithValue("DateTo", searchCriteria.DateTo)
                If Not String.IsNullOrEmpty(searchCriteria.MemberId) Then .AddWithValue("MemberID", searchCriteria.MemberId)

                .Add("AHAYear", SqlDbType.Int).Value = searchCriteria.AHAYear
                .Add("ClaimClass", SqlDbType.Int).Value = searchCriteria.ClaimClass

                If Not String.IsNullOrEmpty(searchCriteria.PayerID) Then .AddWithValue("PayerID", searchCriteria.PayerID)

                If searchCriteria.PageSize > 0 Then .AddWithValue("PageSize", searchCriteria.PageSize)
                If searchCriteria.PageNumber > 0 Then .AddWithValue("PageNumber", searchCriteria.PageNumber)
                If searchCriteria.AtHome Then .AddWithValue("AtHome", searchCriteria.AtHome)

            End With

            _DBO.OpenConnection()

            Using sdr As SqlDataReader = _DBO.GetReader(cmd, CommandBehavior.Default)

                While sdr.Read

                    Dim item As New AHAListItem

                    With item

                        .ID = CLng(sdr("ClaimKey"))

                        If Not IsDBNull(sdr("SubmittedDate")) AndAlso Not String.IsNullOrEmpty(sdr("SubmittedDate")) Then .SubmittedDate = CDate(sdr("SubmittedDate"))

                        .BillingNPI = sdr("billingNPI").ToString
                        .RenderingNPI = sdr("renderingNPI").ToString
                        .MemberID = sdr("memberID").ToString
                        '.MemberUID = sdr("memberUID").ToString 
                        .StatusCode = sdr("ClaimStatus")
                        .MemberName = sdr("memberName").ToString
                        .ProviderName = sdr("ProvName").ToString
                        .Source = "E" 'Claim Class
                        .ClaimClass = sdr("ClaimClass")
                        .IsEditable = sdr("IsEditable")
                        .IsPriority = sdr("isPriority")
                        .AddendumID = sdr("biAddendumID")
                        .DayLeft = sdr("DaysLeft").ToString
                        .PayerID = sdr("PayerID").ToString

                        .CanCreate = True
                        .PriorityColor = sdr("priorityColor").ToString
                        .PriorityLevel = sdr("PriorityLevel")
                        resp.PageSize = sdr("PageSize")
                        resp.PageNumber = sdr("PageNumber")
                        resp.RecordTotal = sdr("RecordTotal")

                    End With

                    resp.AHAList.Add(item)

                End While
            End Using

            resp.ErrorNumber = AHAEDM.Errors.Sucessfull
            'Else
            '    resp.ErrorNumber = AHAEDM.Errors.InvalidLoginToken
            'End If

        Catch ex As Exception
            Globals.LogError(sessionID, MethodBase.GetCurrentMethod.DeclaringType.Name, MethodBase.GetCurrentMethod.Name, "", ex.Message, ex.StackTrace)
            Throw
        Finally
            cmd.Dispose()
            _DBO.CloseConnection()
        End Try

        Return resp

    End Function

