    Public Function CheckOrphanMemberHasAHA(memberID As String, isEdit As Boolean, isResubmit As Boolean, ByVal ahaYear As Integer, Optional ByVal atHome As Boolean = 0) As CheckOrphanMemberHasAHAResponse Implements IAHAService12.CheckOrphanMemberHasAHA

        Dim resp As New CheckOrphanMemberHasAHAResponse With {.HasAHA = False}
        Dim dbo As New SqlDataObject(ConnectionStrings(AppSettings("DBClaimAttach").ToString).ConnectionString, True)
        Dim cmd As SqlCommand = New SqlCommand()
        Dim countOfSubmitted As Integer = 0

        Dim claimClass As Integer = GetClaimClassByYear(ahaYear)

        Try

            Dim firstPlusDummyProvider As String = GetFirstPlusDummyNPI(GetFirstPlusDummyNPI) ' "9876543213"

            If (Not isEdit) AndAlso (Not isResubmit) AndAlso (Not String.IsNullOrEmpty(firstPlusDummyProvider)) Then
                Dim qry As New StringBuilder

                qry.Append("SELECT ISNULL(COUNT(*),0) AS 'CountOfSubmitted'")
                qry.Append(" FROM Claims WITH (NOLOCK)")
                qry.Append(" JOIN Claims_AHADetail ad WITH (NOLOCK) ON ad.biClaimID = Claims.biClaimID")
                qry.Append(" INNER JOIN vwMSV_Master WITH (NOLOCK) ON Claims.sPatientContract = vwMSV_Master.memberID")
                qry.Append(" WHERE (Claims.iStatus > 1")
                qry.Append(" AND ((Claims.RejectTypeId IS NOT NULL AND Claims.RejectTypeId <> 1) OR Claims.RejectTypeId IS NULL)")
                qry.AppendFormat(" AND Claims.nClaimClass = {0}", claimClass)
                qry.Append(" AND Claims.sPatientContract = @sPatientContract")
                qry.Append(" AND Claims.nClaimClassTag = 1)")
                qry.AppendFormat(" AND ad.AtHome = {0}", If(atHome, "1", "0"))
                qry.Append(" AND (vwMSV_Master.useForPCPEligibility = 1")
                qry.Append(" OR (LEN(vwMSV_Master.billingNPI) = 0 OR vwMSV_Master.billingNPI IS NULL")
                qry.Append(" AND (LEN(vwMSV_Master.renderingNPI) = 0 OR vwMSV_Master.renderingNPI IS NULL)))")

                'qry.AppendFormat(" AND vwMSV_Master.billingNPI IN ({0})", firstPlusDummyProvider)
                'qry.AppendFormat(" AND vwMSV_Master.renderingNPI IN ({0})", firstPlusDummyProvider)

                cmd.CommandType = CommandType.Text
                cmd.CommandText = qry.ToString()

                cmd.Parameters.AddWithValue("@sPatientContract", memberID)

                Dim dr As SqlDataReader = dbo.GetReader(cmd)

                If dr.HasRows Then
                    dr.Read()
                    countOfSubmitted = dr("CountOfSubmitted")
                End If

                If Not dr.IsClosed Then dr.Close()
            End If

            resp.ErrorNumber = 0
            resp.HasAHA = (countOfSubmitted > 0)

        Catch ex As Exception
            Globals.LogError(0, MethodBase.GetCurrentMethod.DeclaringType.Name, MethodBase.GetCurrentMethod.Name, "", ex.Message, ex.StackTrace)
            resp.ErrorNumber = -1
            resp.ReturnValue = "Internal Error"
        Finally
            cmd.Dispose()
        End Try

        Return resp

    End Function

    Public Function GetMemberEmptyForm(accountID As String, loginToken As String, sourceIP As String, memberID As String,
                                       renderingNPI As String, billingNPI As String, ipaName As String, formYear As Integer) As GetAHAReportBytesResponse Implements IAHAService12.GetMemberEmptyForm
        Try

            Dim resp As New GetAHAReportBytesResponse
            Dim ahaHeaders As List(Of FormHeaderSection) = GetMemberHeaderList(memberID, renderingNPI, billingNPI, ipaName, formYear, True)

            If ahaHeaders.Count > 0 Then

                Dim pdfByteList As New List(Of Byte())

                'Create AhaForm and contact to PDF
                For Each h As FormHeaderSection In ahaHeaders
                    pdfByteList.Add(GetEmptyAHA(h))
                Next

                Dim pdfHelper As New PDFHelper

                resp.ReportBytes = pdfHelper.MergePdfFiles(pdfByteList)
                resp.ErrorNumber = 0
                resp.ReturnValue = ""

                'IO.File.WriteAllBytes("C:\Form_Test\EmptyAHAList.pdf", resp.ReportBytes)

                If String.IsNullOrEmpty(memberID) Then


                    'ProcessPDFBatch(resp.ReportBytes)
                    Return Nothing
                Else
                    Return resp
                End If

            End If

            Return resp

        Catch ex As Exception
            Return Nothing
        End Try

    End Function


    Private Function GetMemberHeaderList(ByVal memberID As String, ByVal renderingNPI As String,
                                        ByVal billingNPI As String, ByVal ipaName As String, ByVal year As Integer, ByVal clinicOrHeader As Boolean) As List(Of FormHeaderSection)

        Dim ahaHeaders As New List(Of FormHeaderSection)
        Dim ahaHeaderItem As New FormHeaderSection

        Dim dbo As New SqlDataObject(ConnectionStrings(AppSettings("DBClaimAttach").ToString).ConnectionString, True)
        Dim cmd As SqlCommand = New SqlCommand()

        Dim claimClass As Integer = GetClaimClassByYear(year)

        Try
            cmd.CommandType = CommandType.StoredProcedure
            'cmd.CommandText = IIf(Not clinicOrHeader, "uspMemberPendingForm", "uspMemberClinicalFormAndHeaderForm")
            cmd.CommandText = "uspMemberClinicalFormAndHeaderForm"

            With cmd.Parameters
                .AddWithValue("@FormYear", year)
                .AddWithValue("@ClaimClass", claimClass)
                If Not String.IsNullOrEmpty(memberID) Then .AddWithValue("@MemberID", memberID)
                If Not String.IsNullOrEmpty(billingNPI) Then .AddWithValue("@BillingNPI", billingNPI)
                If Not String.IsNullOrEmpty(renderingNPI) Then .AddWithValue("@RenderingNPI", renderingNPI)
                If Not String.IsNullOrEmpty(ipaName) Then .AddWithValue("@IPAName", ipaName)
            End With

            Dim dr As SqlDataReader = dbo.GetReader(cmd, CommandBehavior.Default)

            If dr.HasRows Then

                Dim billingNPIIndex As Integer = dr.GetOrdinal("billingNPI")
                Dim renderingNPIIndex As Integer = dr.GetOrdinal("renderingNPI")
                Dim memberIDIndex As Integer = dr.GetOrdinal("memberID")
                Dim memberNameIndex As Integer = dr.GetOrdinal("memberName")
                Dim memberMiddleNameIndex As Integer = dr.GetOrdinal("MemberMiddleName")
                Dim memberLastNameIndex As Integer = dr.GetOrdinal("MemberLastName")
                Dim memberFirstNameIndex As Integer = dr.GetOrdinal("MemberFirstName")
                Dim memberBirthDateIndex As Integer = dr.GetOrdinal("MemberBirthDate")
                Dim memberGenderIndex As Integer = dr.GetOrdinal("MemberGender")
                Dim memberPayerIndex As Integer = dr.GetOrdinal("MemberPayerID")
                Dim providerNameIndex As Integer = dr.GetOrdinal("ProvName")
                Dim providerPostalCityIndex As Integer = dr.GetOrdinal("ProviderPostalCity")
                Dim providerStreetCityIndex As Integer = dr.GetOrdinal("ProviderStreetCity")
                Dim ipaNameIndex As Integer = dr.GetOrdinal("IPAName")

                While dr.Read()

                    ahaHeaderItem = New FormHeaderSection

                    With ahaHeaderItem
                        .BillingNPI.Value = dr.GetString(billingNPIIndex)
                        .RenderingNPI.Value = dr.GetString(renderingNPIIndex)
                        .MemberID.Value = dr.GetString(memberIDIndex)
                        .MemberName.Value = dr.GetString(memberNameIndex)
                        .MemberFName = dr.GetString(memberFirstNameIndex)
                        .MemberMName = dr.GetString(memberMiddleNameIndex)
                        .MemberLName = dr.GetString(memberLastNameIndex)
                        .MemberDOB.Value = dr.GetDateTime(memberBirthDateIndex)
                        .MemberGender.Value = dr.GetString(memberGenderIndex)
                        .PayerID.Value = dr.GetString(memberPayerIndex)
                        .RenderingName = dr.GetString(providerNameIndex)
                        .ProviderName.Value = .RenderingName
                        .ProviderPostalCity = dr.GetString(providerPostalCityIndex)
                        .ProviderStreetCity = dr.GetString(providerStreetCityIndex)
                        If Not dr.IsDBNull(ipaNameIndex) Then .IPAName = dr.GetString(ipaNameIndex)
                        .Status.Value = 2
                    End With

                    ahaHeaders.Add(ahaHeaderItem)

                End While

            End If

            If Not dr.IsClosed Then dr.Close()

        Catch ex As Exception
            Globals.LogError(0, MethodBase.GetCurrentMethod.DeclaringType.Name, MethodBase.GetCurrentMethod.Name, "", ex.Message, ex.StackTrace)
        Finally
            cmd.Dispose()
        End Try

        Return ahaHeaders

    End Function

