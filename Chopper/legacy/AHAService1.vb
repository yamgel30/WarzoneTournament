    Public Function GetAHAListSubmitted(ByVal accountID As String, ByVal loginToken As String,
                                        ByVal sourceIP As String, ByVal searchCriteria As SearchCriteria) As GetAHAListResponse Implements IAHAService12.GetAHAListSubmitted

        Dim cmd As New SqlCommand
        Dim resp As New GetAHAListResponse

        If searchCriteria.AHAYear = 0 Then
            searchCriteria.AHAYear = AppShared.AHAVersion
        Else
            searchCriteria.AHAYear = searchCriteria.AHAYear
        End If

        searchCriteria.ClaimClass = GetClaimClassByYear(searchCriteria.AHAYear) 'AppShared.AHAClaimClass


        Try

            'Dim token As String = CreateSessionToken(loginToken, sourceIP)

            'If ValidateSession(accountID, token) Then

            cmd.CommandType = CommandType.StoredProcedure
            cmd.CommandText = "uspAHA_GetSubmitted"
            cmd.CommandTimeout = 120

            Dim renderingTable As New DataTable
            Dim drRendering As DataRow

            renderingTable.Columns.Add("NPI")

            For Each r In searchCriteria.RenderingNPIList

                drRendering = renderingTable.NewRow

                drRendering("NPI") = r

                renderingTable.Rows.Add(drRendering)

            Next

            Dim billingTable As New DataTable
            Dim drBilling As DataRow

            billingTable.Columns.Add("NPI")

            For Each b In searchCriteria.BillingNPIList

                drBilling = billingTable.NewRow

                drBilling("NPI") = b

                billingTable.Rows.Add(drBilling)

            Next

            With cmd.Parameters

                Dim param As New SqlParameter("RenderingNPIs", SqlDbType.Structured)
                param.Value = renderingTable

                .Add(param)

                param = New SqlParameter("BillingNPIs", SqlDbType.Structured)
                param.Value = billingTable

                .Add(param)

                If Not String.IsNullOrEmpty(searchCriteria.DateFrom) Then .AddWithValue("DateFrom", searchCriteria.DateFrom)
                If Not String.IsNullOrEmpty(searchCriteria.DateTo) Then .AddWithValue("DateTo", searchCriteria.DateTo)
                If Not String.IsNullOrEmpty(searchCriteria.MemberId) Then .AddWithValue("MemberID", searchCriteria.MemberId)

                .AddWithValue("AHAYear", searchCriteria.AHAYear)
                .AddWithValue("ClaimClass", searchCriteria.ClaimClass)

                If Not String.IsNullOrEmpty(searchCriteria.PayerID) Then .AddWithValue("PayerID", searchCriteria.PayerID)

                .AddWithValue("AtHome", searchCriteria.AtHome)

                If searchCriteria.PageSize > 0 Then .AddWithValue("PageSize", searchCriteria.PageSize)
                If searchCriteria.PageNumber > 0 Then .AddWithValue("PageNumber", searchCriteria.PageNumber)
                If searchCriteria.ClaimClassTag > 0 Then .AddWithValue("nClaimClassTag", searchCriteria.ClaimClassTag)
            End With


            _DBO.OpenConnection()

            Using sdr As SqlDataReader = _DBO.GetReader(cmd, CommandBehavior.Default)

                While sdr.Read

                    Dim item As New AHAListItem

                    With item

                        .ID = sdr("ClaimKey")
                        If Not IsDBNull(sdr("SubmittedDate")) AndAlso Not String.IsNullOrEmpty(sdr("SubmittedDate")) Then .SubmittedDate = CDate(sdr("SubmittedDate"))
                        .BillingNPI = sdr("billingNPI").ToString
                        .RenderingNPI = sdr("renderingNPI").ToString
                        .MemberID = sdr("memberID").ToString
                        .StatusCode = sdr("ClaimStatus")
                        .MemberName = sdr("memberName").ToString
                        .ProviderName = sdr("ProvName").ToString
                        .Source = "E" 'Claim Class
                        .ClaimClass = sdr("ClaimClass")
                        .IsEditable = sdr("IsEditable")
                        .PaymentStatus = sdr("paymentStatus").ToString
                        .DeniedCode = sdr("deniedCode").ToString
                        .CheckNumber = sdr("checkNumber").ToString
                        If Not IsDBNull(sdr("checkAmount")) Then .CheckAmount = sdr("checkAmount")
                        If Not IsDBNull(sdr("checkDate")) Then .CheckDate = sdr("CheckDate")
                        .PaymentBillingNPI = sdr("PymtBillingNPI").ToString
                        If Not IsDBNull(sdr("RejectTypeID")) Then .RejectTypeID = sdr("RejectTypeID")
                        .IsPriority = sdr("isPriority")
                        .AtHome = sdr("AtHome")
                        .AddendumID = sdr("biAddendumID")
                        .HasAddendum = sdr("HasAddendum")
                        .DayLeft = sdr("DaysLeft").ToString

                        .PayerID = sdr("PayerID").ToString
                        If IsDBNull(sdr("nClaimClassTag")) = True Then
                            .ClaimClassTag = 1
                        Else
                            .ClaimClassTag = sdr("nClaimClassTag")
                        End If

                        .CanPrint = True

                        Select Case .StatusCode

                            Case "2"
                                .StatusText = "Pending for Quality Review"
                                .CanEdit = True

                            Case "3"

                                .CanEdit = False

                                If .RejectTypeID = 2 Then
                                    .StatusText = "Administrative Denied"
                                    .CanViewRejectNotes = True
                                ElseIf .RejectTypeID = 3 Then
                                    .StatusText = "Rejected Expire"
                                    .CanViewRejectNotes = True
                                End If

                            Case "4"

                                .CanEdit = False

                                Select Case .PaymentStatus.ToString.ToUpper
                                    Case "COMPLETED"
                                        .StatusText = "Completed"

                                    Case "PAID"

                                        Dim checkNumber As String = .CheckNumber.ToString.Trim
                                        Dim checkDate As String = ""
                                        Dim checkAmount As String = ""

                                        If IsDate(.CheckDate.ToString) Then checkDate = .CheckDate.ToShortDateString
                                        If IsNumeric(.CheckAmount.ToString) Then checkAmount = .CheckAmount.ToString("C")

                                        .StatusText = .PaymentStatus
                                        .StatusTextToolTip = String.Format("Check#: {0}, Amount: {1}, Date: {2}, BillingNPI: {3}", checkNumber, checkAmount, checkDate, .PaymentBillingNPI.ToString)

                                    Case "DENIED"

                                        Dim checkDate As String = ""

                                        If IsDate(.CheckDate.ToString) Then checkDate = .CheckDate.ToShortDateString

                                        .StatusText = "Claim-Denied" 'dr("paymentStatus").ToString
                                        .StatusTextToolTip = String.Format("EOP Date: {0}", checkDate)

                                    Case Else
                                        .StatusText = "In Process"

                                End Select

                            Case Else
                                .StatusText = ""

                        End Select

                        If Not IsDBNull(sdr("ServiceDate")) AndAlso Not String.IsNullOrEmpty(sdr("ServiceDate")) Then .ServiceDate = CDate(sdr("ServiceDate"))

                        resp.PageSize = sdr("PageSize")
                        resp.PageNumber = sdr("PageNumber")
                        resp.RecordTotal = sdr("RecordTotal")

                    End With

                    resp.AHAList.Add(item)

                End While

            End Using

            resp.ErrorNumber = AHAEDM.Errors.Sucessfull
            'Else
            '    resp.ErrorNumber = AHAEDM.Errors.InvalidLoginToken
            'End If

        Catch ex As Exception
            Globals.LogError(0, MethodBase.GetCurrentMethod.DeclaringType.Name, MethodBase.GetCurrentMethod.Name, "", ex.Message, ex.StackTrace)
            Throw
        Finally
            cmd.Dispose()
            _DBO.CloseConnection()
        End Try

        Return resp

    End Function

