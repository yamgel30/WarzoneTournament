                Else
                    'Error saving
                    response.ErrorNumber = -1
                    response.ReturnValue = "Internal Error. Save Claim in Submit AHA."
                    response.AHAForm = ahaForm
                End If


            End If

            'Else
            '    response.ErrorNumber = 1
            '    response.ReturnValue = ""
            'End If

        Catch ex As Exception

            response.AHAForm = ahaForm
            response.ErrorNumber = -1
            response.ReturnValue = "Internal Error. At Submit"

            Try
                errorMessage = ex.ToString

                Try
                    requestXML = SerializeObject(ahaForm)
                Catch
                End Try

                Dim mp As New StringBuilder

                Try
                    mp.AppendLine(String.Format("ClaimID = {0}", ahaForm.ID))

                    If ahaForm.FormHeader.MemberID.Value IsNot Nothing Then mp.AppendLine(String.Format("MemberID = {0}", ahaForm.FormHeader.MemberID.Value))
                    If ahaForm.FormHeader.BillingNPI.Value IsNot Nothing Then mp.AppendLine(String.Format("BillingNPI = {0}", ahaForm.FormHeader.BillingNPI.Value))
                    If ahaForm.FormHeader.RenderingNPI.Value IsNot Nothing Then mp.AppendLine(String.Format("RenderingNPI = {0}", ahaForm.FormHeader.RenderingNPI.Value))
                Catch
                End Try

                mp.AppendLine("RequestXML...")
                mp.AppendLine(requestXML)

                Globals.LogError(ahaForm.SessionID, MethodBase.GetCurrentMethod.DeclaringType.Name, MethodBase.GetCurrentMethod.Name, mp.ToString, ex.Message, ex.StackTrace)

            Catch 'ex1 As Exception
            End Try

        Finally
            If debugOn AndAlso response.ErrorNumber <> 0 Then
                LogAHA(accountID, loginToken, requestXML, response, "SubmitAHA", errorMessage)
            End If
        End Try

        'response.AHAForm.FormSectionErrors = response.AHAForm.FormSectionErrors.GetRange(0, 8)
        'response.AHAForm.FormSectionErrors.RemoveAt(8)
        'response.AHAForm = New AHAFormItem()

        response.AHAForm.MajorDepression.MedicationList = New List(Of String)()
        If response.AHAForm.MajorDepression.PHQ9 Is Nothing Then
            response.AHAForm.MajorDepression.PHQ9 = New PHQ9()
        End If
        Return response

    End Function

    Public Function UpdateAHAShort(ByVal accountID As String, ByVal loginToken As String, ByVal sourceIP As String, ByVal ahaForm As AHAFormItemShort) As AHASubmissionShortResponse Implements IAHAService12.UpdateAHAShort

        Dim debugOn As Boolean = False
        Dim requestXML As String = String.Empty
        If AppSettings("DebugOn") IsNot Nothing AndAlso Boolean.Parse(AppSettings("DebugOn")) Then
            debugOn = True
            requestXML = SerializeObject(ahaForm)
        End If

        Dim errorMessage As String = String.Empty
        Dim response As New AHASubmissionShortResponse

        Try
            'Dim token As String = CreateSessionToken(loginToken, sourceIP)

            'If ValidateSession(accountID, token) Then

            If ahaForm.ID IsNot Nothing Then

                Select Case AppShared.ValidatedClaimID(ahaForm.ID, AppShared.ValidateAHAIDFor.Update)

                    Case AppShared.ValidateAHAID.OK

                        Dim ahaVal As New AHAShortValidator

                        ahaForm = ahaVal.Validate(ahaForm, False, 0)

                        If ahaForm.FormSectionErrors.Count > 0 Then

                            response.AHAForm = ahaForm

                            response.ErrorNumber = 1000
                            response.ReturnValue = ""

                        Else
                            'Dim sessionID As Long = GetSessionID(accountID, loginToken)

                            'Save AHA, return ahaItem with assigned ID.
                            Dim ahaDA As New AHADataAdapter

                            If ahaDA.SaveClaim("", sourceIP, False, ahaForm, False, False, 0) Then
                                response.AHAForm = ahaForm

                                response.ErrorNumber = 0
                                response.ReturnValue = ""
                            Else
                                'Error saving
                                response.ErrorNumber = -1
                                response.ReturnValue = "Internal Error. Save Claim in Update AHA"
                                response.AHAForm = ahaForm
                            End If

                        End If

                    Case AppShared.ValidateAHAID.NotValidForUpdate
                        response.ErrorNumber = 1502
                        response.ReturnValue = "AHA not valid for update."
                        response.AHAForm = ahaForm

                    Case AppShared.ValidateAHAID.NotFound
                        response.ErrorNumber = 1501
                        response.ReturnValue = "AHA ID Not found."
                        response.AHAForm = ahaForm

                    Case Else
                        response.ErrorNumber = -1
                        response.ReturnValue = "Internal Error. Validating Update AHA."
                        response.AHAForm = ahaForm

                End Select

            Else
                response.ErrorNumber = 1500
                response.ReturnValue = "AHA Form ID is empty."
                response.AHAForm = ahaForm
            End If

            'Else
            '    response.ErrorNumber = 1
            '    response.ReturnValue = ""
            'End If

        Catch ex As Exception
            response.ErrorNumber = -1
            response.ReturnValue = "Internal Error. At update"
            response.AHAForm = ahaForm
            errorMessage = ex.ToString

            Try
                requestXML = SerializeObject(ahaForm)
            Catch
            End Try

            Dim mp As New StringBuilder

            Try
                mp.AppendLine(String.Format("ClaimID = {0}", ahaForm.ID))

                If ahaForm.FormHeader.MemberID.Value IsNot Nothing Then mp.AppendLine(String.Format("MemberID = {0}", ahaForm.FormHeader.MemberID.Value))
                If ahaForm.FormHeader.BillingNPI.Value IsNot Nothing Then mp.AppendLine(String.Format("BillingNPI = {0}", ahaForm.FormHeader.BillingNPI.Value))
                If ahaForm.FormHeader.RenderingNPI.Value IsNot Nothing Then mp.AppendLine(String.Format("RenderingNPI = {0}", ahaForm.FormHeader.RenderingNPI.Value))

                mp.AppendLine("RequestXML...")
                mp.AppendLine(requestXML)

            Catch 'ex As Exception
            End Try

            Try
                Globals.LogError(ahaForm.SessionID, MethodBase.GetCurrentMethod.DeclaringType.Name, MethodBase.GetCurrentMethod.Name, mp.ToString, ex.Message, ex.StackTrace)
            Catch
            End Try

        Finally
            If debugOn AndAlso response.ErrorNumber <> 0 Then
                LogAHA(accountID, loginToken, requestXML, response, "UpdateAHA", errorMessage)
            End If
        End Try

        Return response

    End Function

    Public Function GetAHAItemShort(ByVal accountID As String, ByVal loginToken As String, ByVal sourceIP As String, ByVal ahaID As Long) As GetAHAItemShortResponse Implements IAHAService12.GetAHAItemShort

        Dim debugOn As Boolean = False
        Dim errorMessage As String = String.Empty
        If AppSettings("DebugOn") IsNot Nothing AndAlso Boolean.Parse(AppSettings("DebugOn")) Then
            debugOn = True
        End If

        Dim response As New GetAHAItemShortResponse
        Dim ahaForm As New AHAFormItemShort

        Try
            ahaForm = GetAHAShort(ahaID)
            response.AHAForm = New AHAFormItem()
            If ahaForm.ID.HasValue AndAlso ahaForm.ID.Value > 0 Then
                response.AHAFormShort = ahaForm
            End If


        Catch ex As Exception
            response.ErrorNumber = -1
            response.ReturnValue = "Internal Error. Get AHA Item"
            errorMessage = ex.ToString
            Globals.LogError(0, MethodBase.GetCurrentMethod.DeclaringType.Name, MethodBase.GetCurrentMethod.Name, String.Format("ClaimID = {0}", ahaID), ex.Message, ex.StackTrace)
        Finally
            If debugOn Then
                LogAHA(accountID, loginToken, String.Empty, response, "GetAHAItem", errorMessage)
            End If
        End Try

        Return response

    End Function

