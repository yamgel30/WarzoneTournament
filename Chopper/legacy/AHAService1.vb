    Public Function GetAHAReport(accountID As String, loginToken As String, sourceIP As String, claimId As String, exportFormat As String, hasAddendum As Boolean, changeColor As Boolean, addendumFirst As Boolean) As GetAHAReportBytesResponse Implements IAHAService12.GetAHAReport

