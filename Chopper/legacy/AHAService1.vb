        '    SelectServiceCodeVitalPed(ahaForm)
        'End If

        Try
            'Dim token As String = CreateSessionToken(loginToken, sourceIP)

            'If ValidateSession(accountID, token) Then

            Dim ahaVal As New AHAShortValidator(ahaForm.Language)

            ahaForm = ahaVal.Validate(ahaForm, False, 0)
