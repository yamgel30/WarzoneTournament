                            response.ReportBytes = GetAHAReport2026(ahaFormShort, exportFormat, hasAddendum, changeColor)
                        Else
                            response.ReportBytes = GetAHAReport2026(ahaForm, exportFormat, hasAddendum, changeColor)
                        End If

                    Case 2025
                        If ahaForm.FormHeader.ClaimClassTag.Value = 4 Then
                            Dim ahaFormShort As New AHAFormItemShort
