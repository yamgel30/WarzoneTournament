    Private Function LogAHA(ByVal accountID As String,
                            ByVal loginToken As String,
                            ByVal requestXML As String,
                            ByVal resp As GenericResponse,
                            ByVal sourceName As String,
                            ByVal errorMessage As String) As Boolean


        Dim outFile As IO.FileStream = Nothing

        Try

            Dim folder As String = IIf(resp.ErrorNumber = 0, "Sucess", "Fail")

            'Log AHAForm to review only for Dev Test
            Dim timeStamp As String = String.Format("{0}{1}{2}{3}", Now.Year.ToString, Now.Month.ToString, Now.Day.ToString, Now.Ticks.ToString)
            Dim filenameRequest As String = String.Format("c:\temp\aha\{0}\{1}-{2}-{3}-{4}-Request.xml", folder, accountID, loginToken, timeStamp, sourceName)
            Dim filenameResponse As String = String.Format("c:\temp\aha\{0}\{1}-{2}-{3}-{4}-Reponse.xml", folder, accountID, loginToken, timeStamp, sourceName)
            Dim filenameError As String = String.Format("c:\temp\aha\{0}\{1}-{2}-{3}-{4}-ErrorDetail.txt", folder, accountID, loginToken, timeStamp, sourceName)

            If Not String.IsNullOrEmpty(requestXML) Then
                IO.File.WriteAllText(filenameRequest, requestXML)
            End If

            Dim respSub As AHASubmissionResponse = Nothing
            If resp.GetType.Name = GetType(AHASubmissionResponse).Name Then
                respSub = resp
            End If

            Dim respTemplate As GetMembersAHATemplateResponse = Nothing
            If resp.GetType.Name = GetType(GetMembersAHATemplateResponse).Name Then
                respTemplate = resp
            End If

            If resp.ErrorNumber <> 0 Then
                Select Case resp.ErrorNumber
                    Case 1000
                        If respSub.AHAForm IsNot Nothing Then
                            If respSub.AHAForm.FormSectionErrors IsNot Nothing Then
                                For Each fse In respSub.AHAForm.FormSectionErrors
                                    errorMessage += String.Format("[SectionID:{0}]{1}", fse.SectionID, vbCrLf)
                                    For Each se In fse.ErrorFieldList
                                        errorMessage += String.Format("--Code:{0} | Description:{1}{2}", se.ErrorCode, se.ErrorDescription, vbCrLf)
                                    Next
                                    errorMessage += vbCrLf
                                Next
                            End If
                        End If

                    Case Else
                        If String.IsNullOrEmpty(errorMessage.Trim) Then errorMessage = resp.ReturnValue
                End Select

                IO.File.WriteAllText(filenameError, String.Format("ErrorNumber:{0}{1}ErrorDescription: {2}", resp.ErrorNumber, vbCrLf, errorMessage))
            End If

            If respSub IsNot Nothing Then
                IO.File.WriteAllText(filenameResponse, SerializeObject(respSub))
            ElseIf respTemplate IsNot Nothing Then
                IO.File.WriteAllText(filenameResponse, SerializeObject(respTemplate))
            Else
                IO.File.WriteAllText(filenameResponse, SerializeObject(resp))
            End If


            Return True

        Catch 'ex As Exception
            'Do nothing
            Return False
        Finally
            If outFile IsNot Nothing Then
                Try
                    outFile.Close()
                    outFile.Dispose()
                Catch
                End Try
            End If
        End Try

    End Function

    Private Function SerializeObject(ByVal o As Object) As String

        Try

            Dim x As DataContractSerializer
            Dim ws As New Xml.XmlWriterSettings
            Dim sb As New StringBuilder

            ws.Indent = True
            ws.Encoding = System.Text.Encoding.UTF8
            ws.CloseOutput = False
            'ws.OmitXmlDeclaration = True 

            Dim xmlw As Xml.XmlWriter = Xml.XmlWriter.Create(sb, ws)

            x = New DataContractSerializer(o.GetType)
            x.WriteObject(xmlw, o)
            xmlw.Flush()
            xmlw.Close()

            Return sb.ToString.Replace("utf-16", "utf-8")

        Catch
            ' Do Nothing
        End Try

        Return String.Empty
    End Function

