                    'Else
                    '    reportName = ".AHA2017_WithAddendumCopy.rdlc"
                    'End If

                    reportName = ".AHA2018_WithAddendumAndDx.rdlc"

                    .DataSources.Add(New ReportDataSource("dsAHAClaims_AcceptedDx", GetDxList(ahaItem.ID)))

                    Dim dsAddendum As DataSet = GetAddendumReport(Convert.ToInt32(ahaItem.ID))

                    .DataSources.Add(New ReportDataSource("Addendum", dsAddendum.Tables(0)))
                    .DataSources.Add(New ReportDataSource("Claims", dsAddendum.Tables(1)))
                    .DataSources.Add(New ReportDataSource("AddendumRejectCodes", dsAddendum.Tables(2)))

                    AddHandler .SubreportProcessing, AddressOf SubReportEventHandler

                ElseIf ahaItem.FormHeader.Status.Value = 4 AndAlso Not hasAddendum Then

                    reportName = ".AHA2018_WithDx.rdlc"
                    .DataSources.Add(New ReportDataSource("dsAHAClaims_AcceptedDx", GetDxList(ahaItem.ID)))

                    AddHandler .SubreportProcessing, AddressOf SubReportEventHandler

                ElseIf hasAddendum Then

                    If addendumFirst Then
                        reportName = ".AddendumWithAHA2018.rdlc"
                    Else
                        reportName = ".AHA2018_WithAddendum.rdlc"
                    End If

                    Dim dsAddendum As DataSet = GetAddendumReport(Convert.ToInt32(ahaItem.ID))

                    .DataSources.Add(New ReportDataSource("Addendum", dsAddendum.Tables(0)))
                    .DataSources.Add(New ReportDataSource("Claims", dsAddendum.Tables(1)))
                    .DataSources.Add(New ReportDataSource("AddendumRejectCodes", dsAddendum.Tables(2)))

                    AddHandler .SubreportProcessing, AddressOf SubReportEventHandler

                End If

                .ReportEmbeddedResource = Assembly.GetExecutingAssembly.GetName.Name & reportName

                .DataSources.Add(New ReportDataSource("dsAHA2018_Claims_AHADetail", ds.Tables(2)))
                .DataSources.Add(New ReportDataSource("dsAHA2018_Claims", ds.Tables(0)))
                .DataSources.Add(New ReportDataSource("dsAHA2018_Claims_DX", ds.Tables(1)))
                .DataSources.Add(New ReportDataSource("dsAHA2018_Claims_PressureSore", ds.Tables(3)))

                '.DataSources.Add(New ReportDataSource("dsAHA2017_Claims_MedicationList", ds.Tables(0)))
                .DataSources.Add(New ReportDataSource("dsAHA2018_Claims_DiseasesOfTheSkin", ds.Tables(4)))


                Dim isEmptyAHA As New ReportParameter
                Dim TextColorReport As New ReportParameter()
                TextColorReport.Name = "InputTextColor"


                If changeColor Then
                    TextColorReport.Values.Add(True)
                Else
                    TextColorReport.Values.Add(False)
                End If

                isEmptyAHA.Name = "IsEmptyAHA"
                isEmptyAHA.Values.Add(False)


                Dim parameters() As ReportParameter = {TextColorReport, isEmptyAHA}
                .SetParameters(parameters)

                .Refresh()


                Dim format As String = ""
                Dim deviceInfo As String = String.Empty
                Dim mimeType As String = ""
                Dim encoding As String = String.Empty
                Dim extension As String = "pdf"
                Dim streamIDs() As String = Nothing
                Dim warnings() As Warning = Nothing

                Select Case UCase(exportFormat)
                    Case UCase("tiff")
                        format = "IMAGE"
                        mimeType = "image/tiff"
                    Case Else
                        format = "PDF"
                        mimeType = "application/pdf"
                End Select

                bytes = .Render(format, deviceInfo, mimeType, encoding, extension, streamIDs, warnings)


            End With
            ds.Dispose()

        Catch ex As Exception

            Dim requestXML As String

            requestXML = SerializeObject(ahaItem)

            Dim mp As New StringBuilder

            Try
                mp.AppendLine(String.Format("ClaimID = {0}", ahaItem.ID))

                If ahaItem.FormHeader.MemberID.Value IsNot Nothing Then mp.AppendLine(String.Format("MemberID = {0}", ahaItem.FormHeader.MemberID.Value))
                If ahaItem.FormHeader.BillingNPI.Value IsNot Nothing Then mp.AppendLine(String.Format("BillingNPI = {0}", ahaItem.FormHeader.BillingNPI.Value))
                If ahaItem.FormHeader.RenderingNPI.Value IsNot Nothing Then mp.AppendLine(String.Format("RenderingNPI = {0}", ahaItem.FormHeader.RenderingNPI.Value))

                mp.AppendLine("RequestXML...")
                mp.AppendLine(requestXML)

            Catch 'ex As Exception
            End Try

            Globals.LogError(ahaItem.SessionID, MethodBase.GetCurrentMethod.DeclaringType.Name, MethodBase.GetCurrentMethod.Name, mp.ToString, ex.Message, ex.StackTrace)

            Throw
        End Try

        Return bytes

    End Function

