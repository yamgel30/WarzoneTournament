    Public Function GetMemberSuspiciousConditionReport(memberId As String, ByVal memberName As String) As GetAHAReportBytesResponse Implements IAHAService12.GetMemberSuspiciousConditionReport

        Dim resp As New GetAHAReportBytesResponse

        Dim rptViewer As New ReportViewer
        Dim bytes() As Byte = Nothing

        Dim title As String = "Condiciones Sospechosas"

        Dim memberConditionResponse As GetMemberConditionResponse = GetMemberSuspiciousCondition(memberId, AppShared.AHAVersion)
        Dim conditionList As New List(Of Condition)

        conditionList = memberConditionResponse.Conditions

        Try

            rptViewer.Reset()

            With rptViewer.LocalReport

                Dim reportName As String = "MemberConditions.rdlc"

                .ReportEmbeddedResource = String.Format("{0}.{1}", Assembly.GetExecutingAssembly.GetName.Name, reportName)

                Dim paramList As New List(Of ReportParameter)

                paramList.Add(New ReportParameter("paramReportTitle", title))
                paramList.Add(New ReportParameter("paramMemberID", memberId))
                paramList.Add(New ReportParameter("paramMemberName", memberName))

                .SetParameters(paramList)

                .DataSources.Clear()
                .DataSources.Add(New ReportDataSource("dsMemberCondition_MemberConditions", conditionList))

                .Refresh()

                Dim format As String
                Dim deviceInfo As String = String.Empty
                Dim mimeType As String
                Dim encoding As String = String.Empty
                Dim extension As String = "pdf"
                Dim streamIDs() As String = Nothing
                Dim warnings() As Warning = Nothing

                format = "PDF"
                mimeType = "application/pdf"

                bytes = .Render(format, deviceInfo, mimeType, encoding, extension, streamIDs, warnings)

            End With

        Catch ex As Exception
            Globals.LogError(0, MethodBase.GetCurrentMethod.DeclaringType.Name, MethodBase.GetCurrentMethod.Name, "", ex.Message, ex.StackTrace)
            resp.ErrorNumber = -1
            resp.ReturnValue = "Internal Error"
        Finally

        End Try

        resp.ReportBytes = bytes

        Return resp

    End Function


    Public Function GetMemberClaimStatus(memberId As String, claimClass As Integer) As GetMemberClaimStatus Implements IAHAService12.GetMemberClaimStatus

        Dim resp As New GetMemberClaimStatus

        resp.ClaimInfo = New ClaimItem

        Try

            Dim _DBO As New SqlDataObject(ConnectionStrings(AppSettings("DBClaimAttach").ToString).ConnectionString, True)
            Dim cmd As New SqlCommand

            cmd.CommandType = CommandType.StoredProcedure
            cmd.CommandText = "uspClaim_GetClaimStatusByMember"

            cmd.Parameters.AddWithValue("MemberID", memberId)
            cmd.Parameters.AddWithValue("ClaimClass", claimClass)

            Using reader As SqlDataReader = _DBO.GetReader(cmd, CommandBehavior.Default)

                If reader.HasRows AndAlso reader.Read Then

                    resp.ClaimInfo.ClaimID = Convert.ToInt64(reader("biClaimID"))
                    resp.ClaimInfo.Status = Convert.ToInt32(reader("iStatus"))

                    If resp.ClaimInfo.Status < 2 Then resp.CurrentStatus = EnumHelper.MemberClaimStatus.InProgress
                    If resp.ClaimInfo.Status = 2 Then resp.CurrentStatus = EnumHelper.MemberClaimStatus.Submitted
                    If resp.ClaimInfo.Status = 3 Then resp.CurrentStatus = EnumHelper.MemberClaimStatus.Rejected

                Else
                    resp.CurrentStatus = EnumHelper.MemberClaimStatus.Pending
                End If

                resp.ErrorNumber = 0
                resp.ReturnValue = ""

            End Using

        Catch ex As Exception
            Globals.LogError(0, MethodBase.GetCurrentMethod.DeclaringType.Name, MethodBase.GetCurrentMethod.Name, "", ex.Message, ex.StackTrace)
            resp.ErrorNumber = -1
            resp.ReturnValue = "Internal Error."
        End Try

        Return resp

    End Function

    Public Function GetAddendumInfo(ByVal claimID As Long) As GetAddendumResponse

        Dim resp As New GetAddendumResponse
        resp.Addendum = New Addendum

        Dim coderInfo As New AddendumCoderAndNotes
        coderInfo = LoadCodUserAndNotes(claimID)

        Dim ahaItem As New AHAFormItem

        ahaItem = GetAHA(claimID)

        resp.Addendum = LoadQuestions(coderInfo.AddendumID)

        Select Case ahaItem.FormHeader.DateOfVisit.Value.Value.Year
            Case 2017
                resp.Addendum.AHAImage = GetAHAReport2017(ahaItem, "pdf", False, False)
            Case 2018
                resp.Addendum.AHAImage = GetAHAReport2018(ahaItem, "pdf", False, False)
        End Select

        resp.Addendum.AddendumCoderInfo = coderInfo
        resp.Addendum.AddendumRejectNotes = LoadRejectedCodes(coderInfo.AddendumID)

        resp.Addendum.Header = ahaItem.FormHeader

        Return resp

    End Function

    Private Function LoadCodUserAndNotes(ByVal claimId As Long) As AddendumCoderAndNotes

        Dim addendumCoderNotesItem As New AddendumCoderAndNotes
        Dim _DBO As New SqlDataObject(ConnectionStrings(AppSettings("DBClaimAttach").ToString).ConnectionString, True)
        Dim cmd As SqlCommand = New SqlCommand("uspGetAddendumCodNameAndMore_ByClaim")

        Try
            cmd.CommandType = CommandType.StoredProcedure
            cmd.Parameters.AddWithValue("@claimID", claimId)

            Dim dt As DataTable = _DBO.GetDataTable(cmd)

            If dt IsNot Nothing AndAlso dt.Rows.Count > 0 Then
                addendumCoderNotesItem.CoderUserID = dt(0)("sUserID").ToString()
                addendumCoderNotesItem.ApprovedDate = CDate(dt(0)("dApproved"))
                addendumCoderNotesItem.PatientName = dt(0)("PatientName").ToString()
                addendumCoderNotesItem.DateOfService = CDate(dt(0)("dDos"))
                addendumCoderNotesItem.SubmitterDate = CDate(dt(0)("dSubmitter"))
                addendumCoderNotesItem.AddendumID = Convert.ToInt32(dt(0)("biAddendumID").ToString())
            End If

        Catch ex As Exception
            Globals.LogError(0, MethodBase.GetCurrentMethod.DeclaringType.Name, MethodBase.GetCurrentMethod.Name, "", ex.Message, ex.StackTrace)
        Finally
            cmd.Dispose()
        End Try

        Return addendumCoderNotesItem

    End Function

    Private Function LoadRejectedCodes(ByVal addendumID As Long) As List(Of AddendumRejectedNotes)

        Dim addendumRejectNoteList As New List(Of AddendumRejectedNotes)
        Dim addendumRejectNoteItem As New AddendumRejectedNotes
        Dim dbo As New SqlDataObject(ConnectionStrings(AppSettings("DBClaimAttach").ToString).ConnectionString, True)
        Dim cmd As SqlCommand = New SqlCommand("uspGetAddendumRejectedNotes")

        Try
            cmd.CommandType = CommandType.StoredProcedure
            cmd.Parameters.AddWithValue("@addendumID", addendumID)

            Dim dt As DataTable = dbo.GetDataTable(cmd)
            Dim count As Integer = 1

            For Each row As DataRow In dt.Rows

                addendumRejectNoteItem = New AddendumRejectedNotes

                dt(dt.Rows.IndexOf(row))("RejectedNote") = "Query" + count.ToString() + ": " + If(IsDBNull(row("RejectedNote")), String.Empty, row("RejectedNote").ToString())

                With addendumRejectNoteItem
                    .AddendumRejectCodesID = CLng(row("biAddendumRejectCodes"))
                    .RejectCode = row("sRejectCode").ToString
                    .RejectedNotes = row("RejectedNote").ToString
                    .PageNumber = CInt(row("Page"))
                End With

                addendumRejectNoteList.Add(addendumRejectNoteItem)

                count += 1
            Next

        Catch ex As Exception
            Globals.LogError(0, MethodBase.GetCurrentMethod.DeclaringType.Name, MethodBase.GetCurrentMethod.Name, "", ex.Message, ex.StackTrace)
        Finally
            cmd.Dispose()
        End Try

        Return addendumRejectNoteList

    End Function

    Private Function LoadQuestions(ByVal addendumID As Long) As Addendum

        Dim dbo As New SqlDataObject(ConnectionStrings(AppSettings("DBClaimAttach").ToString).ConnectionString, True)
        Dim cmd As SqlCommand = New SqlCommand("uspGetAddendumQuestions")
        Dim addendumItem As New Addendum

        Try
            cmd.CommandType = CommandType.StoredProcedure
            cmd.Parameters.AddWithValue("@addendumID", addendumID)

            Dim dataReader As SqlDataReader

            dataReader = dbo.GetReader(cmd, CommandBehavior.Default)

            If dataReader IsNot Nothing AndAlso dataReader.HasRows AndAlso dataReader.Read Then

                With addendumItem
                    .Tratamiento = CBool(dataReader("bTratamiento"))
                    .Resultado = CBool(dataReader("bResultado"))
                    .Comorbilidades = CBool(dataReader("bComorbilidades"))
                    .Documentacion = CBool(dataReader("bDocumentacion"))
                    .Otro1 = CBool(dataReader("bOtro1"))
                    .Clarificar = CBool(dataReader("bClarificar"))
                    .Corregir = CBool(dataReader("bCorregir"))
                    .Anadir = CBool(dataReader("bAnadir"))
                    .Otro2 = CBool(dataReader("bOtro2"))
                    .OtroRazon = dataReader("sOtroRazon").ToString
                    .ProvClarificacion = dataReader("sProvClarificacion").ToString
                    .Status = CBool(dataReader("bStatus"))
                    If Not IsDBNull(dataReader("dProvAccepted")) Then .ProvAccepted = CDate(dataReader("dProvAccepted"))
                End With

                dataReader.Close()

            End If

            ' Dim dt As DataTable = dbo.GetDataTable(cmd)
            ' FillQuery2(dt(0))
        Catch ex As Exception
            Globals.LogError(0, MethodBase.GetCurrentMethod.DeclaringType.Name, MethodBase.GetCurrentMethod.Name, "", ex.Message, ex.StackTrace)
        Finally
            cmd.Dispose()
        End Try

        Return addendumItem

    End Function

    Public Function SaveAddendumProvider(ByVal addendumItem As Addendum, ByVal newClaimID As Long, ByVal claimIDToResubmit As Long) As AddendeumProviderSaveResponse Implements IAHAService12.SaveAddendumProvider

        Dim dbo As New SqlDataObject(ConnectionStrings(AppSettings("DBClaimAttach").ToString).ConnectionString, True)
        Dim resp As New AddendeumProviderSaveResponse

        Dim cmd As New SqlCommand

        Dim errMsg As New StringBuilder

        For Each rn As AddendumRejectedNotes In addendumItem.AddendumRejectNotes

            Try
                cmd = New SqlCommand("uspAddendumProvider_Save")
                cmd.CommandType = CommandType.StoredProcedure

                cmd.Parameters.AddWithValue("@addendumRejectCode", rn.AddendumRejectCodesID)
                cmd.Parameters.AddWithValue("@clinica", rn.ClinicaNoDetermina)
                cmd.Parameters.AddWithValue("@otroRej", rn.Otro)

                If rn.Otro Then
                    cmd.Parameters.AddWithValue("@otroDesc1", rn.OtroRazon)
                End If

                dbo.ExecuteCommand(cmd)

            Catch ex As Exception
                errMsg.AppendLine($"Reject Codes: {ex.Message.ToString}")
            Finally
                cmd.Dispose()
            End Try

        Next

        If String.IsNullOrEmpty(errMsg.ToString) Then

            Try
                cmd = New SqlCommand("uspAddendumProvider_Save")
                cmd.CommandType = CommandType.StoredProcedure

                cmd.Parameters.AddWithValue("@claimID", claimIDToResubmit)
                cmd.Parameters.AddWithValue("@claimID2", newClaimID)
                cmd.Parameters.AddWithValue("@addendumID", addendumItem.AddendumCoderInfo.AddendumID)
                cmd.Parameters.AddWithValue("@SaveQuery2", "1")
                cmd.Parameters.AddWithValue("@clarificar", addendumItem.Clarificar)
                cmd.Parameters.AddWithValue("@corregir", addendumItem.Corregir)
                cmd.Parameters.AddWithValue("@anadir", addendumItem.Anadir)
                cmd.Parameters.AddWithValue("@otroQuery2", addendumItem.Otro2)
                cmd.Parameters.AddWithValue("@provClarif", addendumItem.ProvClarificacion)

                If addendumItem.Otro2 Then
                    cmd.Parameters.AddWithValue("@otroDesc2", addendumItem.OtroRazon)
                End If

                dbo.ExecuteCommand(cmd)

                If Not dbo.HasError Then
                    resp.ErrorNumber = 0
                End If

            Catch ex As Exception
                Globals.LogError(0, MethodBase.GetCurrentMethod.DeclaringType.Name, MethodBase.GetCurrentMethod.Name, "", ex.Message, ex.StackTrace)
                errMsg.AppendLine("Addendum: " & ex.Message.ToString())
            End Try

        End If

        If Not String.IsNullOrEmpty(errMsg.ToString) Then
            resp.ErrorNumber = 5
            resp.ReturnValue = errMsg.ToString
        End If

        Return resp

    End Function

