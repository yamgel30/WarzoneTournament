                    .LoadSubreportDefinition("AHA2020_PHQ9_ENG", asm.GetManifestResourceStream("AHAController" + ".AHA2020_PHQ9_ENG.rdlc"))
                Else
                    .LoadSubreportDefinition("AHA2020_MalnutritionCriteria", asm.GetManifestResourceStream("AHAController" + ".AHA2020_MalnutritionCriteria.rdlc"))
                    .LoadSubreportDefinition("AHA2020_SocialDeterminants", asm.GetManifestResourceStream("AHAController" + ".AHA2020_SocialDeterminants.rdlc"))
                    .LoadSubreportDefinition("AHA2020_ScreeningSubstanceUse", asm.GetManifestResourceStream("AHAController" + ".AHA2020_ScreeningSubstanceUse.rdlc"))
                    .LoadSubreportDefinition("AHA2020_PHQ9", asm.GetManifestResourceStream("AHAController" + ".AHA2020_PHQ9.rdlc"))
                End If
                ' Se inicializa los datos de SocialDeterminants en blanco
                'Dim ahaClaims_Claims_SocialDeterminantsRow As dsAHA2020.Claims_SocialDeterminantsRow = ds.Tables("Claims_SocialDeterminants").NewRow()

                'ahaClaims_Claims_SocialDeterminantsRow.biClaimID = 0
                'ds.Tables("Claims_SocialDeterminants").LoadDataRow(ahaClaims_Claims_SocialDeterminantsRow.ItemArray, True)


                .DataSources.Add(New ReportDataSource("dsAHA2020_Claims_AHADetail", ds.Tables(2)))
