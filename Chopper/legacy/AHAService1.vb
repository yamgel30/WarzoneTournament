        Dim resp As New GetProviderListResponse

        Try

            'Dim token As String = CreateSessionToken(loginToken, sourceIP)

            'If ValidateSession(accountID, token) Then

            Dim sqlText As New StringBuilder

            sqlCMD.CommandType = CommandType.StoredProcedure
            sqlCMD.CommandText = "uspGetBillingsOfRendering"

            sqlCMD.Parameters.AddWithValue("@renderingNPI", renderingNPI)

            _DBO.OpenConnection()
            Dim sdr As SqlDataReader = _DBO.GetReader(sqlCMD, CommandBehavior.Default)

            While sdr.Read
                Dim item As New ProviderItem
                item.BillingNPI = sdr("billingNPI").ToString
                item.PayerID = sdr("payerID").ToString
                item.RenderingNPI = renderingNPI
                resp.ProviderList.Add(item)
            End While
            sdr.Close()

            resp.ErrorNumber = AHAEDM.Errors.Sucessfull
