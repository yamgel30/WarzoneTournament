    Private Function GetAHAReport2021(ByVal ahaItem As AHAFormItem, ByVal exportFormat As String, ByVal hasAddendum As Boolean, ByVal changeColor As Boolean, Optional ByVal addendumFirst As Boolean = False) As Byte()

        Dim rptViewer As New ReportViewer
        Dim bytes() As Byte = Nothing

        'get type of payer
        Dim payers As Dictionary(Of String, Boolean) = Globals.ValidatePayerID(ahaItem)
        Dim _isGHP As Boolean = payers.Item("isGHP")
        Dim _isAhaFL As Boolean = payers.Item("isAhaFL")
        Dim _isAhaPR As Boolean = payers.Item("isAhaPR")
        Dim _isDX As Boolean = False
        Dim _isPed As Boolean = False

        Dim sMemberID As String = String.Empty
        Dim sRenderingNPI As String = String.Empty

        If Not (IsNothing(ahaItem)) Then
            If Not IsNothing(ahaItem.FormHeader) Then

                If Not IsNothing(ahaItem.FormHeader.MemberID) Then
                    If Not IsNothing(ahaItem.FormHeader.MemberID.Value) Then
                        sMemberID = ahaItem.FormHeader.MemberID.Value
                    End If
                End If

                If Not IsNothing(ahaItem.FormHeader.RenderingNPI) Then
                    If Not IsNothing(ahaItem.FormHeader.RenderingNPI.Value) Then
                        sRenderingNPI = ahaItem.FormHeader.RenderingNPI.Value
                    End If
                End If

            End If
        End If


        Try

            Dim ahahelp As New AHAReportHelper2021(ahaItem)
            Dim ds As DataSet = ahahelp.ConvertToDataset()
            Dim rptSubReport As String = ""
            Dim hasSubReport As Boolean = False
            Dim rptSubReportNameID As String = ""

            rptViewer.Reset()

            With rptViewer.LocalReport

                .DataSources.Clear()

                'Differ here if GHP form is used instead. use GHP2019.rdlc or the english vers _ENG instead.

                Dim reportName As String
                reportName = ""

                If _isGHP Then




                    Dim iAge As Long = DateDiff(DateInterval.Year, CType(ahaItem.FormHeader.MemberDOB.Value, Date), CType(ahaItem.FormHeader.DateOfVisit.Value, Date)) -
                                        If(DateAdd(DateInterval.Year, DateDiff(DateInterval.Year, CType(ahaItem.FormHeader.MemberDOB.Value, Date), CType(ahaItem.FormHeader.DateOfVisit.Value, Date)), CType(ahaItem.FormHeader.MemberDOB.Value, Date)) > CType(ahaItem.FormHeader.DateOfVisit.Value, Date), 1, 0)


                    _isPed = iAge < 21


                    'Dim _isPed As Boolean = False


                    ''get time diference on month
                    'Dim CorrectedAge As Integer = DateDiff(DateInterval.Month, CType(ahaItem.FormHeader.MemberDOB.Value, Date), Date.Now)
                    'Dim fAge As Decimal
                    ''divide by 12 to get correct years not aproximate
                    'fAge = CorrectedAge / 12
                    ''compare to 21 and get if is pediatric
                    '_isPed = fAge < 21


                    If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                        If _isPed Then
                            reportName = ".GHP2021_Ped_ENG.rdlc"
                        Else
                            reportName = ".GHP2021_ENG.rdlc"
                        End If
                    Else
                        If _isPed Then
                            reportName = ".GHP2021_Ped.rdlc"
                        Else
                            reportName = ".GHP2021.rdlc"
                        End If
                    End If


                ElseIf _isAhaFL Then
                    'Same goes for the others but in the future can descriminate.
                    If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                        reportName = ".AHA2021_ENG.rdlc"
                    Else
                        reportName = ".AHA2021.rdlc"
                    End If

                ElseIf _isAhaPR Then

                    If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                        reportName = ".AHA2021_ENG.rdlc"
                    Else
                        reportName = ".AHA2021.rdlc"
                    End If

                Else

                    If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                        reportName = ".AHA2021_ENG.rdlc"
                    Else
                        reportName = ".AHA2021.rdlc"
                    End If

                End If



                hasAddendum = AHAHasAddendum(ahaItem.ID)

                'Dim claimClassTag As Short = GetClaimClassTag(claimKey)

                'If ahaItem.FormHeader.Status.Value = 4 And hasAddendum Then 'ahaItem.FormHeader.Status.Value.Value = 3 Or 
                '    reportName = ".AHA2017_WithAddendumAndDx.rdlc"

                If ahaItem.FormHeader.Status.Value = 4 And hasAddendum Then

                    'If addendumFirst Then
                    '    reportName = ".AddendumWithAHA.rdlc"
                    'Else
                    '    reportName = ".AHA2017_WithAddendumCopy.rdlc"
                    'End If

                    reportName = ".AHA2021_WithAddendumAndDx.rdlc"

                    .DataSources.Add(New ReportDataSource("dsAHAClaims_AcceptedDx", GetDxList(ahaItem.ID)))

                    Dim dsAddendum As DataSet = GetAddendumReport(Convert.ToInt32(ahaItem.ID))

                    .DataSources.Add(New ReportDataSource("Addendum", dsAddendum.Tables(0)))
                    .DataSources.Add(New ReportDataSource("Claims", dsAddendum.Tables(1)))
                    .DataSources.Add(New ReportDataSource("AddendumRejectCodes", dsAddendum.Tables(2)))

                    AddHandler .SubreportProcessing, AddressOf SubReportEventHandler

                ElseIf ahaItem.FormHeader.Status.Value = 4 AndAlso Not hasAddendum Then

                    'If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                    '    reportName = ".AHA2021_ENG.rdlc"
                    'Else
                    '    reportName = ".AHA2021.rdlc"
                    'End If
                    _isDX = True
                    If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                        rptSubReport = reportName
                        reportName = ".AHA2021_WithDx_ENG.rdlc"
                        rptSubReportNameID = "AHA2021_ENG"
                    Else
                        rptSubReport = reportName
                        reportName = ".AHA2021_WithDx.rdlc"
                        rptSubReportNameID = "AHA2021"
                    End If

                    ' ajuste temporero
                    hasSubReport = True

                    .DataSources.Add(New ReportDataSource("dsAHAClaims_AcceptedDx", GetDxList(ahaItem.ID)))

                    AddHandler .SubreportProcessing, AddressOf SubReportEventHandler

                ElseIf hasAddendum Then

                    If addendumFirst Then
                        reportName = ".AddendumWithAHA2021.rdlc"
                    Else
                        ' ajuste temporero
                        'reportName = ".AHA2021_WithAddendum.rdlc"
                        'If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                        '    reportName = ".AHA2021_ENG.rdlc"
                        'Else
                        '    reportName = ".AHA2021.rdlc"
                        'End If
                    End If

                    Dim dsAddendum As DataSet = GetAddendumReport(Convert.ToInt32(ahaItem.ID))

                    .DataSources.Add(New ReportDataSource("Addendum", dsAddendum.Tables(0)))
                    .DataSources.Add(New ReportDataSource("Claims", dsAddendum.Tables(1)))
                    .DataSources.Add(New ReportDataSource("AddendumRejectCodes", dsAddendum.Tables(2)))

                    AddHandler .SubreportProcessing, AddressOf SubReportEventHandler

                End If

                Dim asm As Assembly = Assembly.GetAssembly(Me.GetType())


                If (hasSubReport) Then
                    .LoadReportDefinition(asm.GetManifestResourceStream(Assembly.GetExecutingAssembly.GetName.Name & reportName))
                    .LoadSubreportDefinition(rptSubReportNameID, asm.GetManifestResourceStream("AHAController" + rptSubReport))

                    'Else
                    '    If (reportName = ".AHA2021.rdlc") Then
                    '        '.LoadSubreportDefinition("AHA" + ahaYear.ToString() + "_WithMemberClinicalHistory", asm.GetManifestResourceStream("AHAController" & rptSubReport))
                    '        '.LoadSubreportDefinition("AHAController" + ".AHA2021_Claims_MalnutritionCriteria", asm.GetManifestResourceStream("AHAController" + ".AHA2021.rdlc"))
                    '    End If
                Else
                    .ReportEmbeddedResource = Assembly.GetExecutingAssembly.GetName.Name & reportName
                End If
                If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                    .LoadSubreportDefinition("AHA2021_MalnutritionCriteria_ENG", asm.GetManifestResourceStream("AHAController" + ".AHA2021_MalnutritionCriteria_ENG.rdlc"))
                    .LoadSubreportDefinition("AHA2021_SocialDeterminants_ENG", asm.GetManifestResourceStream("AHAController" + ".AHA2021_SocialDeterminants_ENG.rdlc"))
                    .LoadSubreportDefinition("AHA2021_ScreeningSubstanceUse_ENG", asm.GetManifestResourceStream("AHAController" + ".AHA2021_ScreeningSubstanceUse_ENG.rdlc"))
                    .LoadSubreportDefinition("AHA2021_PHQ9_ENG", asm.GetManifestResourceStream("AHAController" + ".AHA2021_PHQ9_ENG.rdlc"))
                Else
                    .LoadSubreportDefinition("AHA2021_MalnutritionCriteria", asm.GetManifestResourceStream("AHAController" + ".AHA2021_MalnutritionCriteria.rdlc"))
                    .LoadSubreportDefinition("AHA2021_SocialDeterminants", asm.GetManifestResourceStream("AHAController" + ".AHA2021_SocialDeterminants.rdlc"))
                    .LoadSubreportDefinition("AHA2021_ScreeningSubstanceUse", asm.GetManifestResourceStream("AHAController" + ".AHA2021_ScreeningSubstanceUse.rdlc"))
                    .LoadSubreportDefinition("AHA2021_PHQ9", asm.GetManifestResourceStream("AHAController" + ".AHA2021_PHQ9.rdlc"))
                End If
                ' Se inicializa los datos de SocialDeterminants en blanco
                'Dim ahaClaims_Claims_SocialDeterminantsRow As dsAHA2021.Claims_SocialDeterminantsRow = ds.Tables("Claims_SocialDeterminants").NewRow()

                'ahaClaims_Claims_SocialDeterminantsRow.biClaimID = 0
                'ds.Tables("Claims_SocialDeterminants").LoadDataRow(ahaClaims_Claims_SocialDeterminantsRow.ItemArray, True)


                .DataSources.Add(New ReportDataSource("dsAHA2021_Claims_AHADetail", ds.Tables(2)))
                .DataSources.Add(New ReportDataSource("dsAHA2021_Claims", ds.Tables(0)))
                .DataSources.Add(New ReportDataSource("dsAHA2021_Claims_DX", ds.Tables(1)))
                .DataSources.Add(New ReportDataSource("dsAHA2021_Claims_PressureSore", ds.Tables(3)))
                .DataSources.Add(New ReportDataSource("dsAHA2021_Claims_DiseasesOfTheSkin", ds.Tables(4)))

                .DataSources.Add(New ReportDataSource("dsAHA2021_Claims_MalnutritionCriteria", ds.Tables("Claims_MalnutritionCriteria")))
                .DataSources.Add(New ReportDataSource("dsAHA2021_Claims_SocialDeterminants", ds.Tables("Claims_SocialDeterminants")))
                .DataSources.Add(New ReportDataSource("dsAHA2021_ScreeningSubstanceUse", ds.Tables("Claims_ScreeningSubstanceUse")))

                ' Verifcar si hay que añadir los datasource de los reportes nuevos


                'If PHQ9 is not rendered skip this line!!!
                AddHandler .SubreportProcessing, AddressOf SubReportEventHandler

                Dim isEmptyAHA As New ReportParameter
                Dim TextColorReport As New ReportParameter()
                Dim isFlorida As New ReportParameter
                Dim biClaimIDSub As New ReportParameter
                Dim isPed As New ReportParameter
                Dim isGHP As New ReportParameter
                Dim isTHA As New ReportParameter


                isFlorida.Name = "isFlorida"
                isFlorida.Values.Add(_isAhaFL)

                TextColorReport.Name = "InputTextColor"
                If changeColor Then
                    TextColorReport.Values.Add(True)
                Else
                    TextColorReport.Values.Add(False)
                End If

                isEmptyAHA.Name = "IsEmptyAHA"
                isEmptyAHA.Values.Add(False)

                biClaimIDSub.Name = "biClaimIDSub"
                biClaimIDSub.Values.Add(ahaItem.ID)

                isPed.Name = "isPED"
                isPed.Values.Add(_isPed)

                isGHP.Name = "isGHP"
                isGHP.Values.Add(_isGHP)

                isTHA.Name = "isTHA"
                isTHA.Values.Add(False)


                Dim parameters() As ReportParameter

                If _isDX Then
                    parameters = {TextColorReport, isEmptyAHA, isFlorida, biClaimIDSub, isTHA, isGHP, isPed}

                Else

                    parameters = {TextColorReport, isEmptyAHA, isFlorida, biClaimIDSub}
                End If



                Dim parametersList As New List(Of ReportParameter)()

                parametersList.AddRange(parameters)

                If UCase(exportFormat) = "PDF/NO" Then
                    parametersList.Add(New ReportParameter("printAppends", False))
                    exportFormat = "PDF"
                End If

                .SetParameters(parametersList.ToArray())


                .Refresh()


                Dim format As String = ""
                Dim deviceInfo As String = String.Empty
                Dim mimeType As String = ""
                Dim encoding As String = String.Empty
                Dim extension As String = "pdf"
                Dim streamIDs() As String = Nothing
                Dim warnings() As Warning = Nothing

                Select Case UCase(exportFormat)
                    Case UCase("tiff")
                        format = "IMAGE"
                        mimeType = "image/tiff"
                    Case Else
                        format = "PDF"
                        mimeType = "application/pdf"
                End Select

                bytes = .Render(format, deviceInfo, mimeType, encoding, extension, streamIDs, warnings)


                'Try

                '    ' Diagnostics.Process.Start("cmd C:  \Users\jorge.ramos\Desktop\Clean.bat")
                '    If System.IO.Directory.Exists("C:\Form_Test\") Then
                '        Dim fts As String = Date.Now.Ticks
                '        Dim filenametopdf As String = "C:\Form_Test\" & reportName.Remove(0, 1).Remove(reportName.Length - 6, 5) & "-" & fts & ".pdf"
                '        System.IO.File.WriteAllBytes(filenametopdf, bytes)
                '        Diagnostics.Process.Start(filenametopdf)
                '    End If



                'Catch ex As Exception

                'End Try

            End With
            ds.Dispose()

        Catch ex As Exception

            Dim requestXML As String

            requestXML = SerializeObject(ahaItem)

            Dim mp As New StringBuilder

            Try
                mp.AppendLine(String.Format("ClaimID = {0}", ahaItem.ID))

                If ahaItem.FormHeader.MemberID.Value IsNot Nothing Then mp.AppendLine(String.Format("MemberID = {0}", ahaItem.FormHeader.MemberID.Value))
                If ahaItem.FormHeader.BillingNPI.Value IsNot Nothing Then mp.AppendLine(String.Format("BillingNPI = {0}", ahaItem.FormHeader.BillingNPI.Value))
                If ahaItem.FormHeader.RenderingNPI.Value IsNot Nothing Then mp.AppendLine(String.Format("RenderingNPI = {0}", ahaItem.FormHeader.RenderingNPI.Value))

                mp.AppendLine("RequestXML...")
                mp.AppendLine(requestXML)

            Catch 'ex As Exception
            End Try

            Globals.LogError(ahaItem.SessionID, MethodBase.GetCurrentMethod.DeclaringType.Name, MethodBase.GetCurrentMethod.Name, mp.ToString, ex.Message, ex.StackTrace, sMemberID, sRenderingNPI)

            Throw
        End Try

        Return bytes

    End Function

    Private Function GetAHAReport2021(ByVal ahaItem As AHAFormItemShort, ByVal exportFormat As String, ByVal hasAddendum As Boolean, ByVal changeColor As Boolean, Optional ByVal addendumFirst As Boolean = False) As Byte()
        Dim rptViewer As New ReportViewer
        Dim bytes() As Byte = Nothing

        'get type of payer
        Dim payers As Dictionary(Of String, Boolean) = Globals.ValidatePayerID(ahaItem)
        Dim _isGHP As Boolean = payers.Item("isGHP")
        Dim _isAhaFL As Boolean = payers.Item("isAhaFL")
        Dim _isAhaPR As Boolean = payers.Item("isAhaPR")
        Dim _isDX As Boolean = False
        Dim _isPed As Boolean = (TimeSpan.FromTicks(DateTime.Now.Ticks - ahaItem.FormHeader.MemberDOB.Value.Value.Ticks).TotalDays / 365.25) < 21



        Dim sMemberID As String = String.Empty
        Dim sRenderingNPI As String = String.Empty

        If Not (IsNothing(ahaItem)) Then
            If Not IsNothing(ahaItem.FormHeader) Then

                If Not IsNothing(ahaItem.FormHeader.MemberID) Then
                    If Not IsNothing(ahaItem.FormHeader.MemberID.Value) Then
                        sMemberID = ahaItem.FormHeader.MemberID.Value
                    End If
                End If

                If Not IsNothing(ahaItem.FormHeader.RenderingNPI) Then
                    If Not IsNothing(ahaItem.FormHeader.RenderingNPI.Value) Then
                        sRenderingNPI = ahaItem.FormHeader.RenderingNPI.Value
                    End If
                End If

            End If
        End If


        Try

            Dim ahahelp As New AHAReportHelper2021(ahaItem)
            Dim ds As DataSet = ahahelp.ConvertToDatasetShort()
            Dim rptSubReport As String = ""
            Dim hasSubReport As Boolean = False
            Dim rptSubReportNameID As String = ""

            rptViewer.Reset()

            With rptViewer.LocalReport

                .DataSources.Clear()

                Dim reportName As String
                reportName = ""

                If _isGHP Then

                    If _isPed Then
                        If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                            reportName = ".GHP2021_Ped_ENG_THA.rdlc"
                        Else
                            reportName = ".GHP2021_Ped_THA.rdlc"
                        End If
                    Else
                        If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                            reportName = ".GHP2021_ENG_THA.rdlc"
                        Else
                            reportName = ".GHP2021_THA.rdlc"
                        End If
                    End If



                ElseIf _isAhaFL Or _isAhaPR Then

                    If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                        reportName = ".AHA2021Short_ENG.rdlc"
                    Else
                        reportName = ".AHA2021Short.rdlc"
                    End If
                End If


                hasAddendum = AHAHasAddendum(ahaItem.ID)


                If ahaItem.FormHeader.Status.Value = 4 And hasAddendum Then



                    reportName = ".AHA2021_WithAddendumAndDx.rdlc"

                    .DataSources.Add(New ReportDataSource("dsAHAClaims_AcceptedDx", GetDxList(ahaItem.ID)))

                    Dim dsAddendum As DataSet = GetAddendumReport(Convert.ToInt32(ahaItem.ID))

                    .DataSources.Add(New ReportDataSource("Addendum", dsAddendum.Tables(0)))
                    .DataSources.Add(New ReportDataSource("Claims", dsAddendum.Tables(1)))
                    .DataSources.Add(New ReportDataSource("AddendumRejectCodes", dsAddendum.Tables(2)))

                    AddHandler .SubreportProcessing, AddressOf SubReportEventHandler

                ElseIf ahaItem.FormHeader.Status.Value = 4 AndAlso Not hasAddendum Then
                    _isDX = True


                    ' ajuste temporero
                    If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                        reportName = ".AHA2021Short_ENG.rdlc"
                    Else
                        reportName = ".AHA2021Short.rdlc"
                    End If
                    hasSubReport = False

                    .DataSources.Add(New ReportDataSource("dsAHAClaims_AcceptedDx", GetDxList(ahaItem.ID)))

                    AddHandler .SubreportProcessing, AddressOf SubReportEventHandler

                ElseIf hasAddendum Then

                    If addendumFirst Then
                        reportName = ".AddendumWithAHA2021.rdlc"
                    Else

                        If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                            reportName = ".AHA2021Short_ENG.rdlc"
                        Else
                            reportName = ".AHA2021Short.rdlc"
                        End If
                    End If

                    Dim dsAddendum As DataSet = GetAddendumReport(Convert.ToInt32(ahaItem.ID))

                    .DataSources.Add(New ReportDataSource("Addendum", dsAddendum.Tables(0)))
                    .DataSources.Add(New ReportDataSource("Claims", dsAddendum.Tables(1)))
                    .DataSources.Add(New ReportDataSource("AddendumRejectCodes", dsAddendum.Tables(2)))

                    AddHandler .SubreportProcessing, AddressOf SubReportEventHandler

                End If

                Dim asm As Assembly = Assembly.GetAssembly(Me.GetType())


                If (hasSubReport) Then
                    .LoadReportDefinition(asm.GetManifestResourceStream(Assembly.GetExecutingAssembly.GetName.Name & reportName))
                    .LoadSubreportDefinition(rptSubReportNameID, asm.GetManifestResourceStream("AHAController" + rptSubReport))
                Else
                    .ReportEmbeddedResource = Assembly.GetExecutingAssembly.GetName.Name & reportName

                End If

                If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                    .LoadSubreportDefinition("AHA2021_MalnutritionCriteria_ENG", asm.GetManifestResourceStream("AHAController" + ".AHA2021_MalnutritionCriteria_ENG.rdlc"))
                    .LoadSubreportDefinition("AHA2021_SocialDeterminants_ENG", asm.GetManifestResourceStream("AHAController" + ".AHA2021_SocialDeterminants_ENG.rdlc"))
                    .LoadSubreportDefinition("AHA2021_ScreeningSubstanceUse_ENG", asm.GetManifestResourceStream("AHAController" + ".AHA2021_ScreeningSubstanceUse_ENG.rdlc"))
                    .LoadSubreportDefinition("AHA2021_PHQ9_ENG", asm.GetManifestResourceStream("AHAController" + ".AHA2021_PHQ9_ENG.rdlc"))
                Else
                    .LoadSubreportDefinition("AHA2021_MalnutritionCriteria", asm.GetManifestResourceStream("AHAController" + ".AHA2021_MalnutritionCriteria.rdlc"))
                    .LoadSubreportDefinition("AHA2021_SocialDeterminants", asm.GetManifestResourceStream("AHAController" + ".AHA2021_SocialDeterminants.rdlc"))
                    .LoadSubreportDefinition("AHA2021_ScreeningSubstanceUse", asm.GetManifestResourceStream("AHAController" + ".AHA2021_ScreeningSubstanceUse.rdlc"))
                    .LoadSubreportDefinition("AHA2021_PHQ9", asm.GetManifestResourceStream("AHAController" + ".AHA2021_PHQ9.rdlc"))
                End If

                .DataSources.Add(New ReportDataSource("dsAHA2021_Claims_AHADetail", ds.Tables(2)))
                .DataSources.Add(New ReportDataSource("dsAHA2021_Claims", ds.Tables(0)))
                .DataSources.Add(New ReportDataSource("dsAHA2021_Claims_DX", ds.Tables(1)))
                .DataSources.Add(New ReportDataSource("dsAHA2021_Claims_PressureSore", ds.Tables(3)))
                .DataSources.Add(New ReportDataSource("dsAHA2021_Claims_DiseasesOfTheSkin", ds.Tables(4)))
                .DataSources.Add(New ReportDataSource("dsAHA2021_Claims_AHADetail_Short", ds.Tables("Claims_AHADetail_Short")))
                .DataSources.Add(New ReportDataSource("dsAHA2021_Claims_MalnutritionCriteria", ds.Tables("Claims_MalnutritionCriteria")))
                .DataSources.Add(New ReportDataSource("dsAHA2021_Claims_SocialDeterminants", ds.Tables("Claims_SocialDeterminants")))
                .DataSources.Add(New ReportDataSource("dsAHA2021_ScreeningSubstanceUse", ds.Tables("Claims_ScreeningSubstanceUse")))

                AddHandler .SubreportProcessing, AddressOf SubReportEventHandler

                Dim isEmptyAHA As New ReportParameter
                Dim TextColorReport As New ReportParameter()
                Dim isFlorida As New ReportParameter
                Dim biClaimIDSub As New ReportParameter
                Dim isPed As New ReportParameter
                Dim isGHP As New ReportParameter
                Dim isTHA As New ReportParameter


                isFlorida.Name = "isFlorida"
                isFlorida.Values.Add(_isAhaFL)

                isPed.Name = "isPED"
                isPed.Values.Add(False)

                isGHP.Name = "isGHP"
                isGHP.Values.Add(False)

                isTHA.Name = "isTHA"
                isTHA.Values.Add(True)


                TextColorReport.Name = "InputTextColor"
                If changeColor Then
                    TextColorReport.Values.Add(True)
                Else
                    TextColorReport.Values.Add(False)
                End If

                isEmptyAHA.Name = "IsEmptyAHA"
                isEmptyAHA.Values.Add(False)


                biClaimIDSub.Name = "biClaimIDSub"
                biClaimIDSub.Values.Add(ahaItem.ID)


                Dim parameters() As ReportParameter

                parameters = {TextColorReport, isEmptyAHA, isFlorida, biClaimIDSub}

                Dim parametersList = New List(Of ReportParameter)()

                parametersList.AddRange(parameters)

                If UCase(exportFormat) = "PDF/NO" Then
                    parametersList.Add(New ReportParameter("printAppends", False))
                    exportFormat = "PDF"
                End If

                .SetParameters(parametersList.ToArray())

                .Refresh()

                Dim format As String = ""
                Dim deviceInfo As String = String.Empty
                Dim mimeType As String = ""
                Dim encoding As String = String.Empty
                Dim extension As String = "pdf"
                Dim streamIDs() As String = Nothing
                Dim warnings() As Warning = Nothing

                Select Case UCase(exportFormat)
                    Case UCase("tiff")
                        format = "IMAGE"
                        mimeType = "image/tiff"
                    Case Else
                        format = "PDF"
                        mimeType = "application/pdf"
                End Select

                bytes = .Render(format, deviceInfo, mimeType, encoding, extension, streamIDs, warnings)

                '                Try

                '#If DEBUG Then
                '                    If System.IO.Directory.Exists("C:\Form_Test\") Then
                '                        Dim fts As String = Date.Now.Ticks
                '                        Dim filenametopdf As String = "C:\Form_Test\" & reportName.Remove(0, 1).Remove(reportName.Length - 6, 5) & "-" & fts & ".pdf"
                '                        System.IO.File.WriteAllBytes(filenametopdf, bytes)
                '                        Diagnostics.Process.Start(filenametopdf)
                '                    End If

                '#End If

                '                Catch ex As Exception

                '                End Try

            End With
            ds.Dispose()

        Catch ex As Exception

            Dim requestXML As String

            requestXML = SerializeObject(ahaItem)

            Dim mp As New StringBuilder

            Try
                mp.AppendLine(String.Format("ClaimID = {0}", ahaItem.ID))

                If ahaItem.FormHeader.MemberID.Value IsNot Nothing Then mp.AppendLine(String.Format("MemberID = {0}", ahaItem.FormHeader.MemberID.Value))
                If ahaItem.FormHeader.BillingNPI.Value IsNot Nothing Then mp.AppendLine(String.Format("BillingNPI = {0}", ahaItem.FormHeader.BillingNPI.Value))
                If ahaItem.FormHeader.RenderingNPI.Value IsNot Nothing Then mp.AppendLine(String.Format("RenderingNPI = {0}", ahaItem.FormHeader.RenderingNPI.Value))

                mp.AppendLine("RequestXML...")
                mp.AppendLine(requestXML)

            Catch

            End Try

            Globals.LogError(ahaItem.SessionID, MethodBase.GetCurrentMethod.DeclaringType.Name, MethodBase.GetCurrentMethod.Name, mp.ToString, ex.Message, ex.StackTrace, sMemberID, sRenderingNPI)

            Throw
        End Try

        Return bytes
    End Function


    Private Function GetAHAReport2022(ByVal ahaItem As AHAFormItem, ByVal exportFormat As String, ByVal hasAddendum As Boolean, ByVal changeColor As Boolean, Optional ByVal addendumFirst As Boolean = False) As Byte()

        Dim rptViewer As New ReportViewer
        Dim bytes() As Byte = Nothing

        'get type of payer

        Dim payers As Dictionary(Of String, Boolean) = Globals.ValidatePayerID(ahaItem)
        Dim _isGHP As Boolean = payers.Item("isGHP")
        Dim _isAhaFL As Boolean = payers.Item("isAhaFL")
        Dim _isAhaPR As Boolean = payers.Item("isAhaPR")
        Dim _isDX As Boolean = False
        Dim _isPed As Boolean = False

        Dim sMemberID As String = String.Empty
        Dim sRenderingNPI As String = String.Empty

        If Not (IsNothing(ahaItem)) Then
            If Not IsNothing(ahaItem.FormHeader) Then

                If Not IsNothing(ahaItem.FormHeader.MemberID) Then
                    If Not IsNothing(ahaItem.FormHeader.MemberID.Value) Then
                        sMemberID = ahaItem.FormHeader.MemberID.Value
                    End If
                End If

                If Not IsNothing(ahaItem.FormHeader.RenderingNPI) Then
                    If Not IsNothing(ahaItem.FormHeader.RenderingNPI.Value) Then
                        sRenderingNPI = ahaItem.FormHeader.RenderingNPI.Value
                    End If
                End If

            End If
        End If

        Try

            Dim ahahelp As New AHAReportHelper2022(ahaItem)
            Dim ds As DataSet = ahahelp.ConvertToDataset()
            Dim rptSubReport As String = ""
            Dim hasSubReport As Boolean = False
            Dim rptSubReportNameID As String = ""

            rptViewer.Reset()


            Dim iAge As Long = DateDiff(DateInterval.Year, CType(ahaItem.FormHeader.MemberDOB.Value, Date), CType(ahaItem.FormHeader.DateOfVisit.Value, Date)) -
                                        If(DateAdd(DateInterval.Year, DateDiff(DateInterval.Year, CType(ahaItem.FormHeader.MemberDOB.Value, Date), CType(ahaItem.FormHeader.DateOfVisit.Value, Date)), CType(ahaItem.FormHeader.MemberDOB.Value, Date)) > CType(ahaItem.FormHeader.DateOfVisit.Value, Date), 1, 0)

            '#If DEBUG Then
            '            _isGHP = True
            '            iAge = 15
            '#End If




            With rptViewer.LocalReport

                .DataSources.Clear()

                'Differ here if GHP form is used instead. use GHP2019.rdlc or the english vers _ENG instead.

                Dim reportName As String
                reportName = ""

                If _isGHP Then
                    _isPed = iAge < 21
                    'Dim _isPed As Boolean = False
                    ''get time diference on month
                    'Dim CorrectedAge As Integer = DateDiff(DateInterval.Month, CType(ahaItem.FormHeader.MemberDOB.Value, Date), Date.Now)
                    'Dim fAge As Decimal
                    ''divide by 12 to get correct years not aproximate
                    'fAge = CorrectedAge / 12
                    ''compare to 21 and get if is pediatric
                    '_isPed = fAge < 21


                    If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                        If _isPed Then
                            reportName = ".GHP2022_Ped_ENG.rdlc"
                        Else
                            reportName = ".GHP2022_ENG.rdlc"
                        End If
                    Else
                        If _isPed Then
                            reportName = ".GHP2022_Ped.rdlc"
                        Else
                            reportName = ".GHP2022.rdlc"
                        End If
                    End If


                ElseIf _isAhaFL Then
                    'Same goes for the others but in the future can descriminate.
                    If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                        reportName = ".AHAFL2022_ENG.rdlc"
                    Else
                        reportName = ".AHAFL2022.rdlc"
                    End If

                ElseIf _isAhaPR Then

                    If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                        reportName = ".AHA2022_ENG.rdlc"
                    Else
                        reportName = ".AHA2022.rdlc"
                    End If

                Else

                    If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                        reportName = ".AHA2022_ENG.rdlc"
                    Else
                        reportName = ".AHA2022.rdlc"
                    End If

                End If



                hasAddendum = AHAHasAddendum(ahaItem.ID)

                'Dim claimClassTag As Short = GetClaimClassTag(claimKey)

                'If ahaItem.FormHeader.Status.Value = 4 And hasAddendum Then 'ahaItem.FormHeader.Status.Value.Value = 3 Or 
                '    reportName = ".AHA2017_WithAddendumAndDx.rdlc"

                If ahaItem.FormHeader.Status.Value = 4 And hasAddendum Then

                    'If addendumFirst Then
                    '    reportName = ".AddendumWithAHA.rdlc"
                    'Else
                    '    reportName = ".AHA2017_WithAddendumCopy.rdlc"
                    'End If

                    reportName = ".AHA2022_WithAddendumAndDx.rdlc"

                    .DataSources.Add(New ReportDataSource("dsAHAClaims_AcceptedDx", GetDxList(ahaItem.ID)))

                    Dim dsAddendum As DataSet = GetAddendumReport(Convert.ToInt32(ahaItem.ID))

                    .DataSources.Add(New ReportDataSource("Addendum", dsAddendum.Tables(0)))
                    .DataSources.Add(New ReportDataSource("Claims", dsAddendum.Tables(1)))
                    .DataSources.Add(New ReportDataSource("AddendumRejectCodes", dsAddendum.Tables(2)))

                    AddHandler .SubreportProcessing, AddressOf SubReportEventHandler

                ElseIf ahaItem.FormHeader.Status.Value = 4 AndAlso Not hasAddendum Then

                    'If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                    '    reportName = ".AHA2021_ENG.rdlc"
                    'Else
                    '    reportName = ".AHA2021.rdlc"
                    'End If
                    _isDX = True
                    If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                        rptSubReport = reportName
                        reportName = ".AHA2022_WithDx_ENG.rdlc"
                        rptSubReportNameID = "AHA2022_ENG"
                    Else
                        rptSubReport = reportName
                        reportName = ".AHA2022_WithDx.rdlc"
                        rptSubReportNameID = "AHA2022"
                    End If

                    ' ajuste temporero
                    hasSubReport = True

                    .DataSources.Add(New ReportDataSource("dsAHAClaims_AcceptedDx", GetDxList(ahaItem.ID)))

                    AddHandler .SubreportProcessing, AddressOf SubReportEventHandler

                ElseIf hasAddendum Then

                    If addendumFirst Then
                        reportName = ".AddendumWithAHA2022.rdlc"
                    Else
                        ' ajuste temporero
                        'reportName = ".AHA2021_WithAddendum.rdlc"
                        'If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                        '    reportName = ".AHA2021_ENG.rdlc"
                        'Else
                        '    reportName = ".AHA2021.rdlc"
                        'End If
                    End If

                    Dim dsAddendum As DataSet = GetAddendumReport(Convert.ToInt32(ahaItem.ID))

                    .DataSources.Add(New ReportDataSource("Addendum", dsAddendum.Tables(0)))
                    .DataSources.Add(New ReportDataSource("Claims", dsAddendum.Tables(1)))
                    .DataSources.Add(New ReportDataSource("AddendumRejectCodes", dsAddendum.Tables(2)))

                    AddHandler .SubreportProcessing, AddressOf SubReportEventHandler

                End If

                Dim asm As Assembly = Assembly.GetAssembly(Me.GetType())


                If (hasSubReport) Then
                    .LoadReportDefinition(asm.GetManifestResourceStream(Assembly.GetExecutingAssembly.GetName.Name & reportName))
                    .LoadSubreportDefinition(rptSubReportNameID, asm.GetManifestResourceStream("AHAController" + rptSubReport))

                    'Else
                    '    If (reportName = ".AHA2021.rdlc") Then
                    '        '.LoadSubreportDefinition("AHA" + ahaYear.ToString() + "_WithMemberClinicalHistory", asm.GetManifestResourceStream("AHAController" & rptSubReport))
                    '        '.LoadSubreportDefinition("AHAController" + ".AHA2021_Claims_MalnutritionCriteria", asm.GetManifestResourceStream("AHAController" + ".AHA2021.rdlc"))
                    '    End If
                Else
                    .ReportEmbeddedResource = Assembly.GetExecutingAssembly.GetName.Name & reportName
                End If
                If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                    .LoadSubreportDefinition("AHA2022_MalnutritionCriteria_ENG", asm.GetManifestResourceStream("AHAController" + ".AHA2022_MalnutritionCriteria_ENG.rdlc"))
                    .LoadSubreportDefinition("AHA2022_SocialDeterminants_ENG", asm.GetManifestResourceStream("AHAController" + ".AHA2022_SocialDeterminants_ENG.rdlc"))
                    .LoadSubreportDefinition("AHA2022_ScreeningSubstanceUse_ENG", asm.GetManifestResourceStream("AHAController" + ".AHA2022_ScreeningSubstanceUse_ENG.rdlc"))
                    If iAge >= 11 AndAlso iAge <= 20 AndAlso _isGHP Then
                        .LoadSubreportDefinition("AHA2022_PHQ9_ENG", asm.GetManifestResourceStream("AHAController" + ".AHA2022_PHQA_ENG.rdlc"))
                    Else
                        .LoadSubreportDefinition("AHA2022_PHQ9_ENG", asm.GetManifestResourceStream("AHAController" + ".AHA2022_PHQ9_ENG.rdlc"))
                    End If
                Else
                    .LoadSubreportDefinition("AHA2022_MalnutritionCriteria", asm.GetManifestResourceStream("AHAController" + ".AHA2022_MalnutritionCriteria.rdlc"))
                    .LoadSubreportDefinition("AHA2022_SocialDeterminants", asm.GetManifestResourceStream("AHAController" + ".AHA2022_SocialDeterminants.rdlc"))
                    .LoadSubreportDefinition("AHA2022_ScreeningSubstanceUse", asm.GetManifestResourceStream("AHAController" + ".AHA2022_ScreeningSubstanceUse.rdlc"))
                    If iAge >= 11 AndAlso iAge <= 20 AndAlso _isGHP Then
                        .LoadSubreportDefinition("AHA2022_PHQ9", asm.GetManifestResourceStream("AHAController" + ".AHA2022_PHQA.rdlc"))
                    Else
                        .LoadSubreportDefinition("AHA2022_PHQ9", asm.GetManifestResourceStream("AHAController" + ".AHA2022_PHQ9.rdlc")) ' Assembly.GetExecutingAssembly().GetName().Name
                    End If
                End If
                ' Se inicializa los datos de SocialDeterminants en blanco
                'Dim ahaClaims_Claims_SocialDeterminantsRow As dsAHA2021.Claims_SocialDeterminantsRow = ds.Tables("Claims_SocialDeterminants").NewRow()

                'ahaClaims_Claims_SocialDeterminantsRow.biClaimID = 0
                'ds.Tables("Claims_SocialDeterminants").LoadDataRow(ahaClaims_Claims_SocialDeterminantsRow.ItemArray, True)


                .DataSources.Add(New ReportDataSource("dsAHA2022_Claims_AHADetail", ds.Tables("Claims_AHADetail")))
                .DataSources.Add(New ReportDataSource("dsAHA2022_Claims", ds.Tables("Claims")))
                .DataSources.Add(New ReportDataSource("dsAHA2022_Claims_DX", ds.Tables("Claims_DX")))
                .DataSources.Add(New ReportDataSource("dsAHA2022_Claims_PressureSore", ds.Tables("Claims_PressureSores")))
                .DataSources.Add(New ReportDataSource("dsAHA2022_Claims_DiseasesOfTheSkin", ds.Tables("Claims_DiseasesOfTheSkin")))

                .DataSources.Add(New ReportDataSource("dsAHA2022_Claims_MalnutritionCriteria", ds.Tables("Claims_MalnutritionCriteria")))
                .DataSources.Add(New ReportDataSource("dsAHA2022_Claims_SocialDeterminants", ds.Tables("Claims_SocialDeterminants")))
                .DataSources.Add(New ReportDataSource("dsAHA2022_ScreeningSubstanceUse", ds.Tables("Claims_ScreeningSubstanceUse")))

                ' Verifcar si hay que añadir los datasource de los reportes nuevos


                'If PHQ9 is not rendered skip this line!!!
                AddHandler .SubreportProcessing, AddressOf SubReportEventHandler

                Dim isEmptyAHA As New ReportParameter
                Dim TextColorReport As New ReportParameter()
                Dim isFlorida As New ReportParameter
                Dim biClaimIDSub As New ReportParameter
                Dim isPed As New ReportParameter
                Dim isGHP As New ReportParameter
                Dim isTHA As New ReportParameter


                isFlorida.Name = "isFlorida"
                isFlorida.Values.Add(_isAhaFL)

                TextColorReport.Name = "InputTextColor"
                If changeColor Then
                    TextColorReport.Values.Add(True)
                Else
                    TextColorReport.Values.Add(False)
                End If

                isEmptyAHA.Name = "IsEmptyAHA"
                isEmptyAHA.Values.Add(False)

                biClaimIDSub.Name = "biClaimIDSub"
                biClaimIDSub.Values.Add(ahaItem.ID)

                isPed.Name = "isPED"
                isPed.Values.Add(_isPed)

                isGHP.Name = "isGHP"
                isGHP.Values.Add(_isGHP)

                isTHA.Name = "isTHA"
                isTHA.Values.Add(False)


                Dim parameters() As ReportParameter

                If _isDX Then
                    parameters = {TextColorReport, isEmptyAHA, isFlorida, biClaimIDSub, isTHA, isGHP, isPed}

                Else

                    parameters = {TextColorReport, isEmptyAHA, isFlorida, biClaimIDSub}
                End If



                Dim parametersList As New List(Of ReportParameter)()

                parametersList.AddRange(parameters)

                If UCase(exportFormat) = "PDF/NO" Then
                    parametersList.Add(New ReportParameter("printAppends", False))
                    exportFormat = "PDF"
                End If

                .SetParameters(parametersList.ToArray())


                .Refresh()


                Dim format As String = ""
                Dim deviceInfo As String = String.Empty
                Dim mimeType As String = ""
                Dim encoding As String = String.Empty
                Dim extension As String = "pdf"
                Dim streamIDs() As String = Nothing
                Dim warnings() As Warning = Nothing

                Select Case UCase(exportFormat)
                    Case UCase("tiff")
                        format = "IMAGE"
                        mimeType = "image/tiff"
                    Case Else
                        format = "PDF"
                        mimeType = "application/pdf"
                End Select

                bytes = .Render(format, deviceInfo, mimeType, encoding, extension, streamIDs, warnings)


                'Try

                '    ' Diagnostics.Process.Start("cmd C:  \Users\jorge.ramos\Desktop\Clean.bat")
                'If System.IO.Directory.Exists("C:\Form_Test\") Then
                '    Dim fts As String = Date.Now.Ticks
                '    Dim filenametopdf As String = "C:\Form_Test\" & reportName.Remove(0, 1).Remove(reportName.Length - 6, 5) & "-" & fts & ".pdf"
                '    System.IO.File.WriteAllBytes(filenametopdf, bytes)
                '    Diagnostics.Process.Start(filenametopdf)
                'End If



                'Catch ex As Exception

                'End Try

            End With
            ds.Dispose()

        Catch ex As Exception

            Dim requestXML As String

            requestXML = SerializeObject(ahaItem)

            Dim mp As New StringBuilder

            Try
                mp.AppendLine(String.Format("ClaimID = {0}", ahaItem.ID))

                If ahaItem.FormHeader.MemberID.Value IsNot Nothing Then mp.AppendLine(String.Format("MemberID = {0}", ahaItem.FormHeader.MemberID.Value))
                If ahaItem.FormHeader.BillingNPI.Value IsNot Nothing Then mp.AppendLine(String.Format("BillingNPI = {0}", ahaItem.FormHeader.BillingNPI.Value))
                If ahaItem.FormHeader.RenderingNPI.Value IsNot Nothing Then mp.AppendLine(String.Format("RenderingNPI = {0}", ahaItem.FormHeader.RenderingNPI.Value))

                mp.AppendLine("RequestXML...")
                mp.AppendLine(requestXML)

            Catch 'ex As Exception
            End Try

            Globals.LogError(ahaItem.SessionID, MethodBase.GetCurrentMethod.DeclaringType.Name, MethodBase.GetCurrentMethod.Name, mp.ToString, ex.Message, ex.StackTrace, sMemberID, sRenderingNPI)

            Throw
        End Try

        Return bytes

    End Function

    Private Function GetAHAReport2022(ByVal ahaItem As AHAFormItemShort, ByVal exportFormat As String, ByVal hasAddendum As Boolean, ByVal changeColor As Boolean, Optional ByVal addendumFirst As Boolean = False) As Byte()
        Dim rptViewer As New ReportViewer
        Dim bytes() As Byte = Nothing

        'get type of payer
        Dim payers As Dictionary(Of String, Boolean) = Globals.ValidatePayerID(ahaItem)
        Dim _isGHP As Boolean = payers.Item("isGHP")
        Dim _isAhaFL As Boolean = payers.Item("isAhaFL")
        Dim _isAhaPR As Boolean = payers.Item("isAhaPR")
        Dim _isDX As Boolean = False
        Dim iAge As Double = (TimeSpan.FromTicks(DateTime.Now.Ticks - ahaItem.FormHeader.MemberDOB.Value.Value.Ticks).TotalDays / 365.25)
        Dim _isPed As Boolean = iAge < 21



        Dim sMemberID As String = String.Empty
        Dim sRenderingNPI As String = String.Empty

        If Not (IsNothing(ahaItem)) Then
            If Not IsNothing(ahaItem.FormHeader) Then

                If Not IsNothing(ahaItem.FormHeader.MemberID) Then
                    If Not IsNothing(ahaItem.FormHeader.MemberID.Value) Then
                        sMemberID = ahaItem.FormHeader.MemberID.Value
                    End If
                End If

                If Not IsNothing(ahaItem.FormHeader.RenderingNPI) Then
                    If Not IsNothing(ahaItem.FormHeader.RenderingNPI.Value) Then
                        sRenderingNPI = ahaItem.FormHeader.RenderingNPI.Value
                    End If
                End If

            End If
        End If


        Try

            Dim ahahelp As New AHAReportHelper2022(ahaItem)
            Dim ds As DataSet = ahahelp.ConvertToDatasetShort()
            Dim rptSubReport As String = ""
            Dim hasSubReport As Boolean = False
            Dim rptSubReportNameID As String = ""

            rptViewer.Reset()

            With rptViewer.LocalReport

                .DataSources.Clear()

                Dim reportName As String
                reportName = ""

                If _isGHP Then

                    If _isPed Then
                        If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                            reportName = ".GHP2022_Ped_ENG_THA.rdlc"
                        Else
                            reportName = ".GHP2022_Ped_THA.rdlc"
                        End If
                    Else
                        If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                            reportName = ".GHP2022_ENG_THA.rdlc"
                        Else
                            reportName = ".GHP2022_THA.rdlc"
                        End If
                    End If



                ElseIf _isAhaFL Or _isAhaPR Then

                    If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                        reportName = ".AHA2022Short_ENG.rdlc"
                    Else
                        reportName = ".AHA2022Short.rdlc"
                    End If
                End If


                hasAddendum = AHAHasAddendum(ahaItem.ID)


                If ahaItem.FormHeader.Status.Value = 4 And hasAddendum Then



                    reportName = ".AHA2022_WithAddendumAndDx.rdlc"

                    .DataSources.Add(New ReportDataSource("dsAHAClaims_AcceptedDx", GetDxList(ahaItem.ID)))

                    Dim dsAddendum As DataSet = GetAddendumReport(Convert.ToInt32(ahaItem.ID))

                    .DataSources.Add(New ReportDataSource("Addendum", dsAddendum.Tables(0)))
                    .DataSources.Add(New ReportDataSource("Claims", dsAddendum.Tables(1)))
                    .DataSources.Add(New ReportDataSource("AddendumRejectCodes", dsAddendum.Tables(2)))

                    AddHandler .SubreportProcessing, AddressOf SubReportEventHandler

                ElseIf ahaItem.FormHeader.Status.Value = 4 AndAlso Not hasAddendum Then
                    _isDX = True


                    ' ajuste temporero
                    If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                        reportName = ".AHA2022Short_ENG.rdlc"
                    Else
                        reportName = ".AHA2022Short.rdlc"
                    End If
                    hasSubReport = False

                    .DataSources.Add(New ReportDataSource("dsAHAClaims_AcceptedDx", GetDxList(ahaItem.ID)))

                    AddHandler .SubreportProcessing, AddressOf SubReportEventHandler

                ElseIf hasAddendum Then

                    If addendumFirst Then
                        reportName = ".AddendumWithAHA2022.rdlc"
                    Else

                        If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                            reportName = ".AHA2022Short_ENG.rdlc"
                        Else
                            reportName = ".AHA2022Short.rdlc"
                        End If
                    End If

                    Dim dsAddendum As DataSet = GetAddendumReport(Convert.ToInt32(ahaItem.ID))

                    .DataSources.Add(New ReportDataSource("Addendum", dsAddendum.Tables(0)))
                    .DataSources.Add(New ReportDataSource("Claims", dsAddendum.Tables(1)))
                    .DataSources.Add(New ReportDataSource("AddendumRejectCodes", dsAddendum.Tables(2)))

                    AddHandler .SubreportProcessing, AddressOf SubReportEventHandler

                End If

                Dim asm As Assembly = Assembly.GetAssembly(Me.GetType())


                If (hasSubReport) Then
                    .LoadReportDefinition(asm.GetManifestResourceStream(Assembly.GetExecutingAssembly.GetName.Name & reportName))
                    .LoadSubreportDefinition(rptSubReportNameID, asm.GetManifestResourceStream("AHAController" + rptSubReport))
                Else
                    .ReportEmbeddedResource = Assembly.GetExecutingAssembly.GetName.Name & reportName

                End If

                If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                    .LoadSubreportDefinition("AHA2022_MalnutritionCriteria_ENG", asm.GetManifestResourceStream("AHAController" + ".AHA2022_MalnutritionCriteria_ENG.rdlc"))
                    .LoadSubreportDefinition("AHA2022_SocialDeterminants_ENG", asm.GetManifestResourceStream("AHAController" + ".AHA2022_SocialDeterminants_ENG.rdlc"))
                    .LoadSubreportDefinition("AHA2022_ScreeningSubstanceUse_ENG", asm.GetManifestResourceStream("AHAController" + ".AHA2022_ScreeningSubstanceUse_ENG.rdlc"))
                    If iAge >= 11 AndAlso iAge <= 20 AndAlso _isGHP Then
                        .LoadSubreportDefinition("AHA2022_PHQ9_ENG", asm.GetManifestResourceStream("AHAController" + ".AHA2022_PHQA_ENG.rdlc"))
                    Else
                        .LoadSubreportDefinition("AHA2022_PHQ9_ENG", asm.GetManifestResourceStream("AHAController" + ".AHA2022_PHQ9_ENG.rdlc"))
                    End If
                Else
                    .LoadSubreportDefinition("AHA2022_MalnutritionCriteria", asm.GetManifestResourceStream("AHAController" + ".AHA2022_MalnutritionCriteria.rdlc"))
                    .LoadSubreportDefinition("AHA2022_SocialDeterminants", asm.GetManifestResourceStream("AHAController" + ".AHA2022_SocialDeterminants.rdlc"))
                    .LoadSubreportDefinition("AHA2022_ScreeningSubstanceUse", asm.GetManifestResourceStream("AHAController" + ".AHA2022_ScreeningSubstanceUse.rdlc"))
                    If iAge >= 11 AndAlso iAge <= 20 AndAlso _isGHP Then
                        .LoadSubreportDefinition("AHA2022_PHQ9_ENG", asm.GetManifestResourceStream("AHAController" + ".AHA2022_PHQA_ENG.rdlc"))
                    Else
                        .LoadSubreportDefinition("AHA2022_PHQ9", asm.GetManifestResourceStream("AHAController" + ".AHA2022_PHQ9.rdlc"))
                    End If
                End If

                .DataSources.Add(New ReportDataSource("dsAHA2022_Claims_AHADetail", ds.Tables("Claims_AHADetail")))
                .DataSources.Add(New ReportDataSource("dsAHA2022_Claims", ds.Tables("Claims")))
                .DataSources.Add(New ReportDataSource("dsAHA2022_Claims_DX", ds.Tables("Claims_DX")))
                .DataSources.Add(New ReportDataSource("dsAHA2022_Claims_PressureSore", ds.Tables("Claims_PressureSores")))
                .DataSources.Add(New ReportDataSource("dsAHA2022_Claims_DiseasesOfTheSkin", ds.Tables("Claims_DiseasesOfTheSkin")))
                .DataSources.Add(New ReportDataSource("dsAHA2022_Claims_AHADetail_Short", ds.Tables("Claims_AHADetail_Short")))
                .DataSources.Add(New ReportDataSource("dsAHA2022_Claims_MalnutritionCriteria", ds.Tables("Claims_MalnutritionCriteria")))
                .DataSources.Add(New ReportDataSource("dsAHA2022_Claims_SocialDeterminants", ds.Tables("Claims_SocialDeterminants")))
                .DataSources.Add(New ReportDataSource("dsAHA2022_ScreeningSubstanceUse", ds.Tables("Claims_ScreeningSubstanceUse")))

                AddHandler .SubreportProcessing, AddressOf SubReportEventHandler

                Dim isEmptyAHA As New ReportParameter
                Dim TextColorReport As New ReportParameter()
                Dim isFlorida As New ReportParameter
                Dim biClaimIDSub As New ReportParameter
                Dim isPed As New ReportParameter
                Dim isGHP As New ReportParameter
                Dim isTHA As New ReportParameter


                isFlorida.Name = "isFlorida"
                isFlorida.Values.Add(_isAhaFL)

                isPed.Name = "isPED"
                isPed.Values.Add(False)

                isGHP.Name = "isGHP"
                isGHP.Values.Add(False)

                isTHA.Name = "isTHA"
                isTHA.Values.Add(True)


                TextColorReport.Name = "InputTextColor"
                If changeColor Then
                    TextColorReport.Values.Add(True)
                Else
                    TextColorReport.Values.Add(False)
                End If

                isEmptyAHA.Name = "IsEmptyAHA"
                isEmptyAHA.Values.Add(False)


                biClaimIDSub.Name = "biClaimIDSub"
                biClaimIDSub.Values.Add(ahaItem.ID)


                Dim parameters() As ReportParameter

                parameters = {TextColorReport, isEmptyAHA, isFlorida, biClaimIDSub}

                Dim parametersList = New List(Of ReportParameter)()

                parametersList.AddRange(parameters)

                If UCase(exportFormat) = "PDF/NO" Then
                    parametersList.Add(New ReportParameter("printAppends", False))
                    exportFormat = "PDF"
                End If

                .SetParameters(parametersList.ToArray())

                .Refresh()

                Dim format As String = ""
                Dim deviceInfo As String = String.Empty
                Dim mimeType As String = ""
                Dim encoding As String = String.Empty
                Dim extension As String = "pdf"
                Dim streamIDs() As String = Nothing
                Dim warnings() As Warning = Nothing

                Select Case UCase(exportFormat)
                    Case UCase("tiff")
                        format = "IMAGE"
                        mimeType = "image/tiff"
                    Case Else
                        format = "PDF"
                        mimeType = "application/pdf"
                End Select

                bytes = .Render(format, deviceInfo, mimeType, encoding, extension, streamIDs, warnings)

                'Try
                '#If DEBUG Then
                '                    If System.IO.Directory.Exists("C:\Form_Test\") Then
                '                        Dim fts As String = Date.Now.Ticks
                '                        Dim filenametopdf As String = "C:\Form_Test\" & reportName.Remove(0, 1).Remove(reportName.Length - 6, 5) & "-" & fts & ".pdf"
                '                        System.IO.File.WriteAllBytes(filenametopdf, bytes)
                '                        Diagnostics.Process.Start(filenametopdf)
                '                    End If
                '#End If
                '                Catch ex As Exception
                'End Try

            End With
            ds.Dispose()

        Catch ex As Exception

            Dim requestXML As String

            requestXML = SerializeObject(ahaItem)

            Dim mp As New StringBuilder

            Try
                mp.AppendLine(String.Format("ClaimID = {0}", ahaItem.ID))

                If ahaItem.FormHeader.MemberID.Value IsNot Nothing Then mp.AppendLine(String.Format("MemberID = {0}", ahaItem.FormHeader.MemberID.Value))
                If ahaItem.FormHeader.BillingNPI.Value IsNot Nothing Then mp.AppendLine(String.Format("BillingNPI = {0}", ahaItem.FormHeader.BillingNPI.Value))
                If ahaItem.FormHeader.RenderingNPI.Value IsNot Nothing Then mp.AppendLine(String.Format("RenderingNPI = {0}", ahaItem.FormHeader.RenderingNPI.Value))

                mp.AppendLine("RequestXML...")
                mp.AppendLine(requestXML)

            Catch

            End Try

            Globals.LogError(ahaItem.SessionID, MethodBase.GetCurrentMethod.DeclaringType.Name, MethodBase.GetCurrentMethod.Name, mp.ToString, ex.Message, ex.StackTrace, sMemberID, sRenderingNPI)

            Throw
        End Try

        Return bytes
    End Function


    Private Function GetAHAReport2023(ByVal ahaItem As AHAFormItem, ByVal exportFormat As String, ByVal hasAddendum As Boolean, ByVal changeColor As Boolean, Optional ByVal addendumFirst As Boolean = False) As Byte()

        Dim rptViewer As New ReportViewer
        Dim bytes() As Byte = Nothing

        'get type of payer

        Dim payers As Dictionary(Of String, Boolean) = Globals.ValidatePayerID(ahaItem)
        Dim _isGHP As Boolean = payers.Item("isGHP")
        Dim _isAhaFL As Boolean = payers.Item("isAhaFL")
        Dim _isAhaPR As Boolean = payers.Item("isAhaPR")
        Dim _isDX As Boolean = False
        Dim _isPed As Boolean = False

        Dim sMemberID As String = String.Empty
        Dim sRenderingNPI As String = String.Empty

        If Not (IsNothing(ahaItem)) Then
            If Not IsNothing(ahaItem.FormHeader) Then

                If Not IsNothing(ahaItem.FormHeader.MemberID) Then
                    If Not IsNothing(ahaItem.FormHeader.MemberID.Value) Then
                        sMemberID = ahaItem.FormHeader.MemberID.Value
                    End If
                End If

                If Not IsNothing(ahaItem.FormHeader.RenderingNPI) Then
                    If Not IsNothing(ahaItem.FormHeader.RenderingNPI.Value) Then
                        sRenderingNPI = ahaItem.FormHeader.RenderingNPI.Value
                    End If
                End If

            End If
        End If


        Try

            Dim ahahelp As New AHAReportHelper2023(ahaItem)
            Dim ds As DataSet = ahahelp.ConvertToDataset()
            Dim rptSubReport As String = ""
            Dim hasSubReport As Boolean = False
            Dim rptSubReportNameID As String = ""

            rptViewer.Reset()


            Dim iAge As Long = DateDiff(DateInterval.Year, CType(ahaItem.FormHeader.MemberDOB.Value, Date), CType(ahaItem.FormHeader.DateOfVisit.Value, Date)) -
                                        If(DateAdd(DateInterval.Year, DateDiff(DateInterval.Year, CType(ahaItem.FormHeader.MemberDOB.Value, Date), CType(ahaItem.FormHeader.DateOfVisit.Value, Date)), CType(ahaItem.FormHeader.MemberDOB.Value, Date)) > CType(ahaItem.FormHeader.DateOfVisit.Value, Date), 1, 0)

            '#If DEBUG Then
            '            _isGHP = True
            '            iAge = 15
            '#End If




            With rptViewer.LocalReport

                .DataSources.Clear()

                'Differ here if GHP form is used instead. use GHP2019.rdlc or the english vers _ENG instead.

                Dim reportName As String
                reportName = ""

                If _isGHP Then
                    _isPed = iAge < 21
                    'Dim _isPed As Boolean = False
                    ''get time diference on month
                    'Dim CorrectedAge As Integer = DateDiff(DateInterval.Month, CType(ahaItem.FormHeader.MemberDOB.Value, Date), Date.Now)
                    'Dim fAge As Decimal
                    ''divide by 12 to get correct years not aproximate
                    'fAge = CorrectedAge / 12
                    ''compare to 21 and get if is pediatric
                    '_isPed = fAge < 21


                    If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                        If _isPed Then
                            reportName = ".GHP2023_Ped_ENG.rdlc"
                        Else
                            reportName = ".GHP2023_ENG.rdlc"
                        End If
                    Else
                        If _isPed Then
                            reportName = ".GHP2023_Ped.rdlc"
                        Else
                            reportName = ".GHP2023.rdlc"
                        End If
                    End If


                ElseIf _isAhaFL Then
                    'Same goes for the others but in the future can descriminate.
                    If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                        reportName = ".AHAFL2023_ENG.rdlc"
                    Else
                        reportName = ".AHAFL2023.rdlc"
                    End If

                ElseIf _isAhaPR Then

                    If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                        reportName = ".AHA2023_ENG.rdlc"
                    Else
                        reportName = ".AHA2023.rdlc"
                    End If

                Else

                    If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                        reportName = ".AHA2023_ENG.rdlc"
                    Else
                        reportName = ".AHA2023.rdlc"
                    End If

                End If



                hasAddendum = AHAHasAddendum(ahaItem.ID)

                'Dim claimClassTag As Short = GetClaimClassTag(claimKey)

                'If ahaItem.FormHeader.Status.Value = 4 And hasAddendum Then 'ahaItem.FormHeader.Status.Value.Value = 3 Or 
                '    reportName = ".AHA2017_WithAddendumAndDx.rdlc"

                If ahaItem.FormHeader.Status.Value = 4 And hasAddendum Then

                    'If addendumFirst Then
                    '    reportName = ".AddendumWithAHA.rdlc"
                    'Else
                    '    reportName = ".AHA2017_WithAddendumCopy.rdlc"
                    'End If

                    reportName = ".AHA2023_WithAddendumAndDx.rdlc"

                    .DataSources.Add(New ReportDataSource("dsAHAClaims_AcceptedDx", GetDxList(ahaItem.ID)))

                    Dim dsAddendum As DataSet = GetAddendumReport(Convert.ToInt32(ahaItem.ID))

                    .DataSources.Add(New ReportDataSource("Addendum", dsAddendum.Tables(0)))
                    .DataSources.Add(New ReportDataSource("Claims", dsAddendum.Tables(1)))
                    .DataSources.Add(New ReportDataSource("AddendumRejectCodes", dsAddendum.Tables(2)))

                    AddHandler .SubreportProcessing, AddressOf SubReportEventHandler

                ElseIf ahaItem.FormHeader.Status.Value = 4 AndAlso Not hasAddendum Then


                    _isDX = True
                    If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                        rptSubReport = reportName
                        reportName = ".AHA2023_WithDx_ENG.rdlc"
                        rptSubReportNameID = "AHA2023_ENG"
                    Else
                        rptSubReport = reportName
                        reportName = ".AHA2023_WithDx.rdlc"
                        rptSubReportNameID = "AHA2023"
                    End If

                    ' ajuste temporero
                    hasSubReport = True

                    .DataSources.Add(New ReportDataSource("dsAHAClaims_AcceptedDx", GetDxList(ahaItem.ID)))

                    AddHandler .SubreportProcessing, AddressOf SubReportEventHandler

                ElseIf hasAddendum Then

                    If addendumFirst Then
                        reportName = ".AddendumWithAHA2023.rdlc"
                    Else
                        ' ajuste temporero
                        'reportName = ".AHA2021_WithAddendum.rdlc"
                        'If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                        '    reportName = ".AHA2021_ENG.rdlc"
                        'Else
                        '    reportName = ".AHA2021.rdlc"
                        'End If
                    End If

                    Dim dsAddendum As DataSet = GetAddendumReport(Convert.ToInt32(ahaItem.ID))

                    .DataSources.Add(New ReportDataSource("Addendum", dsAddendum.Tables(0)))
                    .DataSources.Add(New ReportDataSource("Claims", dsAddendum.Tables(1)))
                    .DataSources.Add(New ReportDataSource("AddendumRejectCodes", dsAddendum.Tables(2)))

                    AddHandler .SubreportProcessing, AddressOf SubReportEventHandler

                End If

                Dim asm As Assembly = Assembly.GetAssembly(Me.GetType())


                If (hasSubReport) Then
                    .LoadReportDefinition(asm.GetManifestResourceStream(Assembly.GetExecutingAssembly.GetName.Name & reportName))
                    .LoadSubreportDefinition(rptSubReportNameID, asm.GetManifestResourceStream("AHAController" + rptSubReport))

                    'Else
                    '    If (reportName = ".AHA2021.rdlc") Then
                    '        '.LoadSubreportDefinition("AHA" + ahaYear.ToString() + "_WithMemberClinicalHistory", asm.GetManifestResourceStream("AHAController" & rptSubReport))
                    '        '.LoadSubreportDefinition("AHAController" + ".AHA2021_Claims_MalnutritionCriteria", asm.GetManifestResourceStream("AHAController" + ".AHA2021.rdlc"))
                    '    End If
                Else
                    .ReportEmbeddedResource = Assembly.GetExecutingAssembly.GetName.Name & reportName
                End If
                If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                    .LoadSubreportDefinition("AHA2023_MalnutritionCriteria_ENG", asm.GetManifestResourceStream("AHAController" + ".AHA2023_MalnutritionCriteria_ENG.rdlc"))
                    If _isGHP Then
                        .LoadSubreportDefinition("AHA2023_SocialDeterminants_ENG", asm.GetManifestResourceStream("AHAController" + ".AHA2023_SocialDeterminants_ENG.rdlc"))
                    Else
                        .LoadSubreportDefinition("AHA2023_SocialDeterminants_ENG", asm.GetManifestResourceStream("AHAController" + ".AHA2023_SocialDeterminants_ENG.rdlc"))
                    End If
                    .LoadSubreportDefinition("AHA2023_ScreeningSubstanceUse_ENG", asm.GetManifestResourceStream("AHAController" + ".AHA2023_ScreeningSubstanceUse_ENG.rdlc"))
                    If iAge >= 11 AndAlso iAge <= 20 AndAlso _isGHP Then
                        .LoadSubreportDefinition("AHA2023_PHQ9_ENG", asm.GetManifestResourceStream("AHAController" + ".AHA2023_PHQA_ENG.rdlc"))
                    Else
                        .LoadSubreportDefinition("AHA2023_PHQ9_ENG", asm.GetManifestResourceStream("AHAController" + ".AHA2023_PHQ9_ENG.rdlc"))
                    End If
                Else
                    .LoadSubreportDefinition("AHA2023_MalnutritionCriteria", asm.GetManifestResourceStream("AHAController" + ".AHA2023_MalnutritionCriteria.rdlc"))
                    If _isGHP Then
                        .LoadSubreportDefinition("AHA2023_SocialDeterminants", asm.GetManifestResourceStream("AHAController" + ".AHA2023_SocialDeterminants.rdlc"))
                    Else
                        .LoadSubreportDefinition("AHA2023_SocialDeterminants", asm.GetManifestResourceStream("AHAController" + ".AHA2023_SocialDeterminants.rdlc"))
                    End If
                    .LoadSubreportDefinition("AHA2023_ScreeningSubstanceUse", asm.GetManifestResourceStream("AHAController" + ".AHA2023_ScreeningSubstanceUse.rdlc"))
                    If iAge >= 11 AndAlso iAge <= 20 AndAlso _isGHP Then
                        .LoadSubreportDefinition("AHA2023_PHQ9", asm.GetManifestResourceStream("AHAController" + ".AHA2023_PHQA.rdlc"))
                    Else
                        .LoadSubreportDefinition("AHA2023_PHQ9", asm.GetManifestResourceStream("AHAController" + ".AHA2023_PHQ9.rdlc")) ' Assembly.GetExecutingAssembly().GetName().Name
                    End If
                End If
                ' Se inicializa los datos de SocialDeterminants en blanco
                'Dim ahaClaims_Claims_SocialDeterminantsRow As dsAHA2021.Claims_SocialDeterminantsRow = ds.Tables("Claims_SocialDeterminants").NewRow()

                'ahaClaims_Claims_SocialDeterminantsRow.biClaimID = 0
                'ds.Tables("Claims_SocialDeterminants").LoadDataRow(ahaClaims_Claims_SocialDeterminantsRow.ItemArray, True)


                .DataSources.Add(New ReportDataSource("dsAHA2023_Claims_AHADetail", ds.Tables("Claims_AHADetail")))
                .DataSources.Add(New ReportDataSource("dsAHA2023_Claims", ds.Tables("Claims")))
                .DataSources.Add(New ReportDataSource("dsAHA2023_Claims_DX", ds.Tables("Claims_DX")))
                .DataSources.Add(New ReportDataSource("dsAHA2023_Claims_PressureSore", ds.Tables("Claims_PressureSores")))
                .DataSources.Add(New ReportDataSource("dsAHA2023_Claims_DiseasesOfTheSkin", ds.Tables("Claims_DiseasesOfTheSkin")))

                .DataSources.Add(New ReportDataSource("dsAHA2023_Claims_MalnutritionCriteria", ds.Tables("Claims_MalnutritionCriteria")))

                'If _isGHP Then
                '    .DataSources.Add(New ReportDataSource("dsAHA2022_Claims_SocialDeterminants", ds.Tables("Claims_SocialDeterminants")))
                'Else
                '    .DataSources.Add(New ReportDataSource("dsAHA2023_Claims_SocialDeterminants", ds.Tables("Claims_SocialDeterminants")))
                'End If

                .DataSources.Add(New ReportDataSource("dsAHA2023_ScreeningSubstanceUse", ds.Tables("Claims_ScreeningSubstanceUse")))
                ' New 2023
                If _isGHP Then
                    .DataSources.Add(New ReportDataSource("dsAHA2022_Claims_SocialDeterminants", ds.Tables("Claims_SocialDeterminants")))
                End If
                .DataSources.Add(New ReportDataSource("dsAHA2023_Claims_SocialDeterminants2023", ds.Tables("Claims_SocialDeterminants2023")))


                ' Verifcar si hay que añadir los datasource de los reportes nuevos


                'If PHQ9 is not rendered skip this line!!!
                AddHandler .SubreportProcessing, AddressOf SubReportEventHandler

                Dim isEmptyAHA As New ReportParameter
                Dim TextColorReport As New ReportParameter()
                Dim isFlorida As New ReportParameter
                Dim biClaimIDSub As New ReportParameter
                Dim isPed As New ReportParameter
                Dim isGHP As New ReportParameter
                Dim isTHA As New ReportParameter


                isFlorida.Name = "isFlorida"
                isFlorida.Values.Add(_isAhaFL)

                TextColorReport.Name = "InputTextColor"
                If changeColor Then
                    TextColorReport.Values.Add(True)
                Else
                    TextColorReport.Values.Add(False)
                End If

                isEmptyAHA.Name = "IsEmptyAHA"
                isEmptyAHA.Values.Add(False)

                biClaimIDSub.Name = "biClaimIDSub"
                biClaimIDSub.Values.Add(ahaItem.ID)

                isPed.Name = "isPED"
                isPed.Values.Add(_isPed)

                isGHP.Name = "isGHP"
                isGHP.Values.Add(_isGHP)

                isTHA.Name = "isTHA"
                isTHA.Values.Add(False)


                Dim parameters() As ReportParameter

                If _isDX Then
                    parameters = {TextColorReport, isEmptyAHA, isFlorida, biClaimIDSub, isTHA, isGHP, isPed}

                Else

                    parameters = {TextColorReport, isEmptyAHA, isFlorida, biClaimIDSub}
                End If



                Dim parametersList As New List(Of ReportParameter)()

                parametersList.AddRange(parameters)

                If UCase(exportFormat) = "PDF/NO" Then
                    parametersList.Add(New ReportParameter("printAppends", False))
                    exportFormat = "PDF"
                End If

                .SetParameters(parametersList.ToArray())


                .Refresh()


                Dim format As String = ""
                Dim deviceInfo As String = String.Empty
                Dim mimeType As String = ""
                Dim encoding As String = String.Empty
                Dim extension As String = "pdf"
                Dim streamIDs() As String = Nothing
                Dim warnings() As Warning = Nothing

                Select Case UCase(exportFormat)
                    Case UCase("tiff")
                        format = "IMAGE"
                        mimeType = "image/tiff"
                    Case Else
                        format = "PDF"
                        mimeType = "application/pdf"
                End Select

                bytes = .Render(format, deviceInfo, mimeType, encoding, extension, streamIDs, warnings)


                'Try

                '    ' Diagnostics.Process.Start("cmd C:  \Users\jorge.ramos\Desktop\Clean.bat")
                'If System.IO.Directory.Exists("C:\Form_Test\") Then
                '    Dim fts As String = Date.Now.Ticks
                '    Dim filenametopdf As String = "C:\Form_Test\" & reportName.Remove(0, 1).Remove(reportName.Length - 6, 5) & "-" & fts & ".pdf"
                '    System.IO.File.WriteAllBytes(filenametopdf, bytes)
                '    Diagnostics.Process.Start(filenametopdf)
                'End If



                'Catch ex As Exception

                'End Try

            End With
            ds.Dispose()

        Catch ex As Exception

            Dim requestXML As String

            requestXML = SerializeObject(ahaItem)

            Dim mp As New StringBuilder

            Try
                mp.AppendLine(String.Format("ClaimID = {0}", ahaItem.ID))

                If ahaItem.FormHeader.MemberID.Value IsNot Nothing Then mp.AppendLine(String.Format("MemberID = {0}", ahaItem.FormHeader.MemberID.Value))
                If ahaItem.FormHeader.BillingNPI.Value IsNot Nothing Then mp.AppendLine(String.Format("BillingNPI = {0}", ahaItem.FormHeader.BillingNPI.Value))
                If ahaItem.FormHeader.RenderingNPI.Value IsNot Nothing Then mp.AppendLine(String.Format("RenderingNPI = {0}", ahaItem.FormHeader.RenderingNPI.Value))

                mp.AppendLine("RequestXML...")
                mp.AppendLine(requestXML)

            Catch 'ex As Exception
            End Try

            Globals.LogError(ahaItem.SessionID, MethodBase.GetCurrentMethod.DeclaringType.Name, MethodBase.GetCurrentMethod.Name, mp.ToString, ex.Message, ex.StackTrace, sMemberID, sRenderingNPI)

            Throw
        End Try

        Return bytes

    End Function

    Private Function GetAHAReport2023(ByVal ahaItem As AHAFormItemShort, ByVal exportFormat As String, ByVal hasAddendum As Boolean, ByVal changeColor As Boolean, Optional ByVal addendumFirst As Boolean = False) As Byte()
        Dim rptViewer As New ReportViewer
        Dim bytes() As Byte = Nothing

        'get type of payer
        Dim payers As Dictionary(Of String, Boolean) = Globals.ValidatePayerID(ahaItem)
        Dim _isGHP As Boolean = payers.Item("isGHP")
        Dim _isAhaFL As Boolean = payers.Item("isAhaFL")
        Dim _isAhaPR As Boolean = payers.Item("isAhaPR")
        Dim _isDX As Boolean = False
        Dim iAge As Double = (TimeSpan.FromTicks(DateTime.Now.Ticks - ahaItem.FormHeader.MemberDOB.Value.Value.Ticks).TotalDays / 365.25)
        Dim _isPed As Boolean = iAge < 21



        Dim sMemberID As String = String.Empty
        Dim sRenderingNPI As String = String.Empty

        If Not (IsNothing(ahaItem)) Then
            If Not IsNothing(ahaItem.FormHeader) Then

                If Not IsNothing(ahaItem.FormHeader.MemberID) Then
                    If Not IsNothing(ahaItem.FormHeader.MemberID.Value) Then
                        sMemberID = ahaItem.FormHeader.MemberID.Value
                    End If
                End If

                If Not IsNothing(ahaItem.FormHeader.RenderingNPI) Then
                    If Not IsNothing(ahaItem.FormHeader.RenderingNPI.Value) Then
                        sRenderingNPI = ahaItem.FormHeader.RenderingNPI.Value
                    End If
                End If

            End If
        End If


        Try

            Dim ahahelp As New AHAReportHelper2023(ahaItem)
            Dim ds As DataSet = ahahelp.ConvertToDatasetShort()
            Dim rptSubReport As String = ""
            Dim hasSubReport As Boolean = False
            Dim rptSubReportNameID As String = ""

            rptViewer.Reset()

            With rptViewer.LocalReport

                .DataSources.Clear()

                Dim reportName As String
                reportName = ""

                If _isGHP Then

                    If _isPed Then
                        If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                            reportName = ".GHP2023_Ped_ENG_THA.rdlc"
                        Else
                            reportName = ".GHP2023_Ped_THA.rdlc"
                        End If
                    Else
                        If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                            reportName = ".GHP2023_ENG_THA.rdlc"
                        Else
                            reportName = ".GHP2023_THA.rdlc"
                        End If
                    End If



                ElseIf _isAhaFL Or _isAhaPR Then

                    If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                        reportName = ".AHA2023Short_ENG.rdlc"
                    Else
                        reportName = ".AHA2023Short.rdlc"
                    End If
                End If


                hasAddendum = AHAHasAddendum(ahaItem.ID)


                If ahaItem.FormHeader.Status.Value = 4 And hasAddendum Then



                    reportName = ".AHA2023_WithAddendumAndDx.rdlc"

                    .DataSources.Add(New ReportDataSource("dsAHAClaims_AcceptedDx", GetDxList(ahaItem.ID)))

                    Dim dsAddendum As DataSet = GetAddendumReport(Convert.ToInt32(ahaItem.ID))

                    .DataSources.Add(New ReportDataSource("Addendum", dsAddendum.Tables(0)))
                    .DataSources.Add(New ReportDataSource("Claims", dsAddendum.Tables(1)))
                    .DataSources.Add(New ReportDataSource("AddendumRejectCodes", dsAddendum.Tables(2)))

                    AddHandler .SubreportProcessing, AddressOf SubReportEventHandler

                ElseIf ahaItem.FormHeader.Status.Value = 4 AndAlso Not hasAddendum Then
                    _isDX = True


                    ' ajuste temporero
                    If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                        reportName = ".AHA2023Short_ENG.rdlc"
                    Else
                        reportName = ".AHA2023Short.rdlc"
                    End If
                    hasSubReport = False

                    .DataSources.Add(New ReportDataSource("dsAHAClaims_AcceptedDx", GetDxList(ahaItem.ID)))

                    AddHandler .SubreportProcessing, AddressOf SubReportEventHandler

                ElseIf hasAddendum Then

                    If addendumFirst Then
                        reportName = ".AddendumWithAHA2023.rdlc"
                    Else

                        If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                            reportName = ".AHA2023Short_ENG.rdlc"
                        Else
                            reportName = ".AHA2023Short.rdlc"
                        End If
                    End If

                    Dim dsAddendum As DataSet = GetAddendumReport(Convert.ToInt32(ahaItem.ID))

                    .DataSources.Add(New ReportDataSource("Addendum", dsAddendum.Tables(0)))
                    .DataSources.Add(New ReportDataSource("Claims", dsAddendum.Tables(1)))
                    .DataSources.Add(New ReportDataSource("AddendumRejectCodes", dsAddendum.Tables(2)))

                    AddHandler .SubreportProcessing, AddressOf SubReportEventHandler

                End If

                Dim asm As Assembly = Assembly.GetAssembly(Me.GetType())


                If (hasSubReport) Then
                    .LoadReportDefinition(asm.GetManifestResourceStream(Assembly.GetExecutingAssembly.GetName.Name & reportName))
                    .LoadSubreportDefinition(rptSubReportNameID, asm.GetManifestResourceStream("AHAController" + rptSubReport))
                Else
                    .ReportEmbeddedResource = Assembly.GetExecutingAssembly.GetName.Name & reportName

                End If

                If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                    .LoadSubreportDefinition("AHA2023_MalnutritionCriteria_ENG", asm.GetManifestResourceStream("AHAController" + ".AHA2023_MalnutritionCriteria_ENG.rdlc"))
                    .LoadSubreportDefinition("AHA2023_SocialDeterminants_ENG", asm.GetManifestResourceStream("AHAController" + ".AHA2023_SocialDeterminants_ENG.rdlc"))
                    .LoadSubreportDefinition("AHA2023_ScreeningSubstanceUse_ENG", asm.GetManifestResourceStream("AHAController" + ".AHA2023_ScreeningSubstanceUse_ENG.rdlc"))
                    If iAge >= 11 AndAlso iAge <= 20 AndAlso _isGHP Then
                        .LoadSubreportDefinition("AHA2023_PHQ9_ENG", asm.GetManifestResourceStream("AHAController" + ".AHA2023_PHQA_ENG.rdlc"))
                    Else
                        .LoadSubreportDefinition("AHA2023_PHQ9_ENG", asm.GetManifestResourceStream("AHAController" + ".AHA2023_PHQ9_ENG.rdlc"))
                    End If
                Else
                    .LoadSubreportDefinition("AHA2023_MalnutritionCriteria", asm.GetManifestResourceStream("AHAController" + ".AHA2023_MalnutritionCriteria.rdlc"))
                    .LoadSubreportDefinition("AHA2023_SocialDeterminants", asm.GetManifestResourceStream("AHAController" + ".AHA2023_SocialDeterminants.rdlc"))
                    .LoadSubreportDefinition("AHA2023_ScreeningSubstanceUse", asm.GetManifestResourceStream("AHAController" + ".AHA2023_ScreeningSubstanceUse.rdlc"))
                    If iAge >= 11 AndAlso iAge <= 20 AndAlso _isGHP Then
                        .LoadSubreportDefinition("AHA2023_PHQ9_ENG", asm.GetManifestResourceStream("AHAController" + ".AHA2023_PHQA_ENG.rdlc"))
                    Else
                        .LoadSubreportDefinition("AHA2023_PHQ9", asm.GetManifestResourceStream("AHAController" + ".AHA2023_PHQ9.rdlc"))
                    End If
                End If

                .DataSources.Add(New ReportDataSource("dsAHA2023_Claims_AHADetail", ds.Tables("Claims_AHADetail")))
                .DataSources.Add(New ReportDataSource("dsAHA2023_Claims", ds.Tables("Claims")))
                .DataSources.Add(New ReportDataSource("dsAHA2023_Claims_DX", ds.Tables("Claims_DX")))
                .DataSources.Add(New ReportDataSource("dsAHA2023_Claims_PressureSore", ds.Tables("Claims_PressureSores")))
                .DataSources.Add(New ReportDataSource("dsAHA2023_Claims_DiseasesOfTheSkin", ds.Tables("Claims_DiseasesOfTheSkin")))
                .DataSources.Add(New ReportDataSource("dsAHA2023_Claims_AHADetail_Short", ds.Tables("Claims_AHADetail_Short")))
                .DataSources.Add(New ReportDataSource("dsAHA2023_Claims_MalnutritionCriteria", ds.Tables("Claims_MalnutritionCriteria")))
                If _isGHP Then
                    .DataSources.Add(New ReportDataSource("dsAHA2023_Claims_SocialDeterminants", ds.Tables("Claims_SocialDeterminants")))
                Else
                    .DataSources.Add(New ReportDataSource("dsAHA2023_Claims_SocialDeterminants2023", ds.Tables("Claims_SocialDeterminants2023")))
                End If
                .DataSources.Add(New ReportDataSource("dsAHA2023_ScreeningSubstanceUse", ds.Tables("Claims_ScreeningSubstanceUse")))

                AddHandler .SubreportProcessing, AddressOf SubReportEventHandler

                Dim isEmptyAHA As New ReportParameter
                Dim TextColorReport As New ReportParameter()
                Dim isFlorida As New ReportParameter
                Dim biClaimIDSub As New ReportParameter
                Dim isPed As New ReportParameter
                Dim isGHP As New ReportParameter
                Dim isTHA As New ReportParameter


                isFlorida.Name = "isFlorida"
                isFlorida.Values.Add(_isAhaFL)

                isPed.Name = "isPED"
                isPed.Values.Add(False)

                isGHP.Name = "isGHP"
                isGHP.Values.Add(False)

                isTHA.Name = "isTHA"
                isTHA.Values.Add(True)


                TextColorReport.Name = "InputTextColor"
                If changeColor Then
                    TextColorReport.Values.Add(True)
                Else
                    TextColorReport.Values.Add(False)
                End If

                isEmptyAHA.Name = "IsEmptyAHA"
                isEmptyAHA.Values.Add(False)


                biClaimIDSub.Name = "biClaimIDSub"
                biClaimIDSub.Values.Add(ahaItem.ID)


                Dim parameters() As ReportParameter

                parameters = {TextColorReport, isEmptyAHA, isFlorida, biClaimIDSub}

                Dim parametersList = New List(Of ReportParameter)()

                parametersList.AddRange(parameters)

                If UCase(exportFormat) = "PDF/NO" Then
                    parametersList.Add(New ReportParameter("printAppends", False))
                    exportFormat = "PDF"
                End If

                .SetParameters(parametersList.ToArray())

                .Refresh()

                Dim format As String = ""
                Dim deviceInfo As String = String.Empty
                Dim mimeType As String = ""
                Dim encoding As String = String.Empty
                Dim extension As String = "pdf"
                Dim streamIDs() As String = Nothing
                Dim warnings() As Warning = Nothing

                Select Case UCase(exportFormat)
                    Case UCase("tiff")
                        format = "IMAGE"
                        mimeType = "image/tiff"
                    Case Else
                        format = "PDF"
                        mimeType = "application/pdf"
                End Select

                bytes = .Render(format, deviceInfo, mimeType, encoding, extension, streamIDs, warnings)

                'Try
                '#If DEBUG Then
                '                    If System.IO.Directory.Exists("C:\Form_Test\") Then
                '                        Dim fts As String = Date.Now.Ticks
                '                        Dim filenametopdf As String = "C:\Form_Test\" & reportName.Remove(0, 1).Remove(reportName.Length - 6, 5) & "-" & fts & ".pdf"
                '                        System.IO.File.WriteAllBytes(filenametopdf, bytes)
                '                        Diagnostics.Process.Start(filenametopdf)
                '                    End If
                '#End If
                '                Catch ex As Exception
                'End Try

            End With
            ds.Dispose()

        Catch ex As Exception

            Dim requestXML As String

            requestXML = SerializeObject(ahaItem)

            Dim mp As New StringBuilder

            Try
                mp.AppendLine(String.Format("ClaimID = {0}", ahaItem.ID))

                If ahaItem.FormHeader.MemberID.Value IsNot Nothing Then mp.AppendLine(String.Format("MemberID = {0}", ahaItem.FormHeader.MemberID.Value))
                If ahaItem.FormHeader.BillingNPI.Value IsNot Nothing Then mp.AppendLine(String.Format("BillingNPI = {0}", ahaItem.FormHeader.BillingNPI.Value))
                If ahaItem.FormHeader.RenderingNPI.Value IsNot Nothing Then mp.AppendLine(String.Format("RenderingNPI = {0}", ahaItem.FormHeader.RenderingNPI.Value))

                mp.AppendLine("RequestXML...")
                mp.AppendLine(requestXML)

            Catch

            End Try

            Globals.LogError(ahaItem.SessionID, MethodBase.GetCurrentMethod.DeclaringType.Name, MethodBase.GetCurrentMethod.Name, mp.ToString, ex.Message, ex.StackTrace, sMemberID, sRenderingNPI)

            Throw
        End Try

        Return bytes
    End Function


    Private Function GetAHAReport2024(ByVal ahaItem As AHAFormItem, ByVal exportFormat As String, ByVal hasAddendum As Boolean, ByVal changeColor As Boolean, Optional ByVal addendumFirst As Boolean = False) As Byte()

        Dim rptViewer As New ReportViewer
        Dim bytes() As Byte = Nothing

        'get type of payer

        Dim payers As Dictionary(Of String, Boolean) = Globals.ValidatePayerID(ahaItem)
        Dim _isGHP As Boolean = payers.Item("isGHP")
        Dim _isAhaFL As Boolean = payers.Item("isAhaFL")
        Dim _isAhaPR As Boolean = payers.Item("isAhaPR")
        Dim _isDX As Boolean = False
        Dim _isPed As Boolean = False

        Dim sMemberID As String = String.Empty
        Dim sRenderingNPI As String = String.Empty

        If Not (IsNothing(ahaItem)) Then
            If Not IsNothing(ahaItem.FormHeader) Then

                If Not IsNothing(ahaItem.FormHeader.MemberID) Then
                    If Not IsNothing(ahaItem.FormHeader.MemberID.Value) Then
                        sMemberID = ahaItem.FormHeader.MemberID.Value
                    End If
                End If

                If Not IsNothing(ahaItem.FormHeader.RenderingNPI) Then
                    If Not IsNothing(ahaItem.FormHeader.RenderingNPI.Value) Then
                        sRenderingNPI = ahaItem.FormHeader.RenderingNPI.Value
                    End If
                End If

            End If
        End If


        Try

            Dim ahahelp As New AHAReportHelper2024(ahaItem)
            Dim ds As DataSet = ahahelp.ConvertToDataset()
            Dim rptSubReport As String = ""
            Dim hasSubReport As Boolean = False
            Dim rptSubReportNameID As String = ""

            rptViewer.Reset()


            Dim iAge As Long = DateDiff(DateInterval.Year, CType(ahaItem.FormHeader.MemberDOB.Value, Date), CType(ahaItem.FormHeader.DateOfVisit.Value, Date)) -
                                        If(DateAdd(DateInterval.Year, DateDiff(DateInterval.Year, CType(ahaItem.FormHeader.MemberDOB.Value, Date), CType(ahaItem.FormHeader.DateOfVisit.Value, Date)), CType(ahaItem.FormHeader.MemberDOB.Value, Date)) > CType(ahaItem.FormHeader.DateOfVisit.Value, Date), 1, 0)

            '#If DEBUG Then
            '            _isGHP = True
            '            iAge = 15
            '#End If




            With rptViewer.LocalReport

                .DataSources.Clear()

                'Differ here if GHP form is used instead. use GHP2019.rdlc or the english vers _ENG instead.

                Dim reportName As String
                reportName = ""

                If _isGHP Then
                    _isPed = iAge < 21
                    'Dim _isPed As Boolean = False
                    ''get time diference on month
                    'Dim CorrectedAge As Integer = DateDiff(DateInterval.Month, CType(ahaItem.FormHeader.MemberDOB.Value, Date), Date.Now)
                    'Dim fAge As Decimal
                    ''divide by 12 to get correct years not aproximate
                    'fAge = CorrectedAge / 12
                    ''compare to 21 and get if is pediatric
                    '_isPed = fAge < 21


                    If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                        If _isPed Then
                            reportName = ".GHP2024_Ped_ENG.rdlc"
                        Else
                            reportName = ".GHP2024_ENG.rdlc"
                        End If
                    Else
                        If _isPed Then
                            reportName = ".GHP2024_Ped.rdlc"
                        Else
                            reportName = ".GHP2024.rdlc"
                        End If
                    End If


                ElseIf _isAhaFL Then
                    'Same goes for the others but in the future can descriminate.
                    If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                        reportName = ".AHAFL2024_ENG.rdlc"
                    Else
                        reportName = ".AHAFL2024.rdlc"
                    End If

                ElseIf _isAhaPR Then

                    If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                        reportName = ".AHA2024_ENG.rdlc"
                    Else
                        reportName = ".AHA2024.rdlc"
                    End If

                Else

                    If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                        reportName = ".AHA2024_ENG.rdlc"
                    Else
                        reportName = ".AHA2024.rdlc"
                    End If

                End If



                hasAddendum = AHAHasAddendum(ahaItem.ID)

                'Dim claimClassTag As Short = GetClaimClassTag(claimKey)

                'If ahaItem.FormHeader.Status.Value = 4 And hasAddendum Then 'ahaItem.FormHeader.Status.Value.Value = 3 Or 
                '    reportName = ".AHA2017_WithAddendumAndDx.rdlc"

                If ahaItem.FormHeader.Status.Value = 4 And hasAddendum Then

                    'If addendumFirst Then
                    '    reportName = ".AddendumWithAHA.rdlc"
                    'Else
                    '    reportName = ".AHA2017_WithAddendumCopy.rdlc"
                    'End If

                    reportName = ".AHA2024_WithAddendumAndDx.rdlc"

                    .DataSources.Add(New ReportDataSource("dsAHAClaims_AcceptedDx", GetDxList(ahaItem.ID)))

                    Dim dsAddendum As DataSet = GetAddendumReport(Convert.ToInt32(ahaItem.ID))

                    .DataSources.Add(New ReportDataSource("Addendum", dsAddendum.Tables(0)))
                    .DataSources.Add(New ReportDataSource("Claims", dsAddendum.Tables(1)))
                    .DataSources.Add(New ReportDataSource("AddendumRejectCodes", dsAddendum.Tables(2)))

                    AddHandler .SubreportProcessing, AddressOf SubReportEventHandler

                ElseIf ahaItem.FormHeader.Status.Value = 4 AndAlso Not hasAddendum Then


                    _isDX = True
                    If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                        rptSubReport = reportName
                        reportName = ".AHA2024_WithDx_ENG.rdlc"
                        rptSubReportNameID = "AHA2024_ENG"
                    Else
                        rptSubReport = reportName
                        reportName = ".AHA2024_WithDx.rdlc"
                        rptSubReportNameID = "AHA2024"
                    End If

                    ' ajuste temporero
                    hasSubReport = True

                    .DataSources.Add(New ReportDataSource("dsAHAClaims_AcceptedDx", GetDxList(ahaItem.ID)))

                    AddHandler .SubreportProcessing, AddressOf SubReportEventHandler

                ElseIf hasAddendum Then

                    If addendumFirst Then
                        reportName = ".AddendumWithAHA2024.rdlc"
                    Else
                        ' ajuste temporero
                        'reportName = ".AHA2021_WithAddendum.rdlc"
                        'If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                        '    reportName = ".AHA2021_ENG.rdlc"
                        'Else
                        '    reportName = ".AHA2021.rdlc"
                        'End If
                    End If

                    Dim dsAddendum As DataSet = GetAddendumReport(Convert.ToInt32(ahaItem.ID))

                    .DataSources.Add(New ReportDataSource("Addendum", dsAddendum.Tables(0)))
                    .DataSources.Add(New ReportDataSource("Claims", dsAddendum.Tables(1)))
                    .DataSources.Add(New ReportDataSource("AddendumRejectCodes", dsAddendum.Tables(2)))

                    AddHandler .SubreportProcessing, AddressOf SubReportEventHandler

                End If

                Dim asm As Assembly = Assembly.GetAssembly(Me.GetType())


                If (hasSubReport) Then
                    .LoadReportDefinition(asm.GetManifestResourceStream(Assembly.GetExecutingAssembly.GetName.Name & reportName))
                    .LoadSubreportDefinition(rptSubReportNameID, asm.GetManifestResourceStream("AHAController" + rptSubReport))

                    'Else
                    '    If (reportName = ".AHA2021.rdlc") Then
                    '        '.LoadSubreportDefinition("AHA" + ahaYear.ToString() + "_WithMemberClinicalHistory", asm.GetManifestResourceStream("AHAController" & rptSubReport))
                    '        '.LoadSubreportDefinition("AHAController" + ".AHA2021_Claims_MalnutritionCriteria", asm.GetManifestResourceStream("AHAController" + ".AHA2021.rdlc"))
                    '    End If
                Else
                    .ReportEmbeddedResource = Assembly.GetExecutingAssembly.GetName.Name & reportName
                End If
                If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                    .LoadSubreportDefinition("AHA2024_MalnutritionCriteria_ENG", asm.GetManifestResourceStream("AHAController" + ".AHA2024_MalnutritionCriteria_ENG.rdlc"))
                    If _isGHP Then
                        .LoadSubreportDefinition("AHA2024_SocialDeterminants_ENG", asm.GetManifestResourceStream("AHAController" + ".AHA2024_SocialDeterminants_ENG.rdlc"))
                    Else
                        .LoadSubreportDefinition("AHA2024_SocialDeterminants_ENG", asm.GetManifestResourceStream("AHAController" + ".AHA2024_SocialDeterminants_ENG.rdlc"))
                    End If
                    .LoadSubreportDefinition("AHA2024_ScreeningSubstanceUse_ENG", asm.GetManifestResourceStream("AHAController" + ".AHA2024_ScreeningSubstanceUse_ENG.rdlc"))
                    If iAge >= 11 AndAlso iAge <= 20 AndAlso _isGHP Then
                        .LoadSubreportDefinition("AHA2024_PHQ9_ENG", asm.GetManifestResourceStream("AHAController" + ".AHA2024_PHQA_ENG.rdlc"))
                    Else
                        .LoadSubreportDefinition("AHA2024_PHQ9_ENG", asm.GetManifestResourceStream("AHAController" + ".AHA2024_PHQ9_ENG.rdlc"))
                    End If
                Else
                    .LoadSubreportDefinition("AHA2024_MalnutritionCriteria", asm.GetManifestResourceStream("AHAController" + ".AHA2024_MalnutritionCriteria.rdlc"))
                    If _isGHP Then
                        .LoadSubreportDefinition("AHA2024_SocialDeterminants", asm.GetManifestResourceStream("AHAController" + ".AHA2024_SocialDeterminants.rdlc"))
                    Else
                        .LoadSubreportDefinition("AHA2024_SocialDeterminants", asm.GetManifestResourceStream("AHAController" + ".AHA2024_SocialDeterminants.rdlc"))
                    End If
                    .LoadSubreportDefinition("AHA2024_ScreeningSubstanceUse", asm.GetManifestResourceStream("AHAController" + ".AHA2024_ScreeningSubstanceUse.rdlc"))
                    If iAge >= 11 AndAlso iAge <= 20 AndAlso _isGHP Then
                        .LoadSubreportDefinition("AHA2024_PHQ9", asm.GetManifestResourceStream("AHAController" + ".AHA2024_PHQA.rdlc"))
                    Else
                        .LoadSubreportDefinition("AHA2024_PHQ9", asm.GetManifestResourceStream("AHAController" + ".AHA2024_PHQ9.rdlc")) ' Assembly.GetExecutingAssembly().GetName().Name
                    End If
                End If
                ' Se inicializa los datos de SocialDeterminants en blanco
                'Dim ahaClaims_Claims_SocialDeterminantsRow As dsAHA2021.Claims_SocialDeterminantsRow = ds.Tables("Claims_SocialDeterminants").NewRow()

                'ahaClaims_Claims_SocialDeterminantsRow.biClaimID = 0
                'ds.Tables("Claims_SocialDeterminants").LoadDataRow(ahaClaims_Claims_SocialDeterminantsRow.ItemArray, True)


                .DataSources.Add(New ReportDataSource("dsAHA2024_Claims_AHADetail", ds.Tables("Claims_AHADetail")))
                .DataSources.Add(New ReportDataSource("dsAHA2024_Claims", ds.Tables("Claims")))
                .DataSources.Add(New ReportDataSource("dsAHA2024_Claims_DX", ds.Tables("Claims_DX")))
                .DataSources.Add(New ReportDataSource("dsAHA2024_Claims_PressureSore", ds.Tables("Claims_PressureSores")))
                .DataSources.Add(New ReportDataSource("dsAHA2024_Claims_DiseasesOfTheSkin", ds.Tables("Claims_DiseasesOfTheSkin")))

                .DataSources.Add(New ReportDataSource("dsAHA2024_Claims_MalnutritionCriteria", ds.Tables("Claims_MalnutritionCriteria")))

                'If _isGHP Then
                '    .DataSources.Add(New ReportDataSource("dsAHA2022_Claims_SocialDeterminants", ds.Tables("Claims_SocialDeterminants")))
                'Else
                '    .DataSources.Add(New ReportDataSource("dsAHA2023_Claims_SocialDeterminants", ds.Tables("Claims_SocialDeterminants")))
                'End If

                .DataSources.Add(New ReportDataSource("dsAHA2024_ScreeningSubstanceUse", ds.Tables("Claims_ScreeningSubstanceUse")))
                ' New 2023
                If _isGHP Then
                    .DataSources.Add(New ReportDataSource("dsAHA2022_Claims_SocialDeterminants", ds.Tables("Claims_SocialDeterminants")))
                End If
                .DataSources.Add(New ReportDataSource("dsAHA2024_Claims_SocialDeterminants2024", ds.Tables("Claims_SocialDeterminants2023")))


                ' Verifcar si hay que añadir los datasource de los reportes nuevos


                'If PHQ9 is not rendered skip this line!!!
                RemoveHandler .SubreportProcessing, AddressOf SubReportEventHandler
                AddHandler .SubreportProcessing, AddressOf SubReportEventHandler

                Dim isEmptyAHA As New ReportParameter
                Dim TextColorReport As New ReportParameter()
                Dim isFlorida As New ReportParameter
                Dim biClaimIDSub As New ReportParameter
                Dim isPed As New ReportParameter
                Dim isGHP As New ReportParameter
                Dim isTHA As New ReportParameter


                isFlorida.Name = "isFlorida"
                isFlorida.Values.Add(_isAhaFL)

                TextColorReport.Name = "InputTextColor"
                If changeColor Then
                    TextColorReport.Values.Add(True)
                Else
                    TextColorReport.Values.Add(False)
                End If

                isEmptyAHA.Name = "IsEmptyAHA"
                isEmptyAHA.Values.Add(False)

                biClaimIDSub.Name = "biClaimIDSub"
                biClaimIDSub.Values.Add(ahaItem.ID)

                isPed.Name = "isPED"
                isPed.Values.Add(_isPed)

                isGHP.Name = "isGHP"
                isGHP.Values.Add(_isGHP)

                isTHA.Name = "isTHA"
                isTHA.Values.Add(False)


                Dim parameters() As ReportParameter

                If _isDX Then
                    parameters = {TextColorReport, isEmptyAHA, isFlorida, biClaimIDSub, isTHA, isGHP, isPed}

                Else

                    parameters = {TextColorReport, isEmptyAHA, isFlorida, biClaimIDSub}
                End If



                Dim parametersList As New List(Of ReportParameter)()

                parametersList.AddRange(parameters)

                If UCase(exportFormat) = "PDF/NO" Then
                    parametersList.Add(New ReportParameter("printAppends", False))
                    exportFormat = "PDF"
                End If

                .SetParameters(parametersList.ToArray())


                .Refresh()


                Dim format As String = ""
                Dim deviceInfo As String = String.Empty
                Dim mimeType As String = ""
                Dim encoding As String = String.Empty
                Dim extension As String = "pdf"
                Dim streamIDs() As String = Nothing
                Dim warnings() As Warning = Nothing

                Select Case UCase(exportFormat)
                    Case UCase("tiff")
                        format = "IMAGE"
                        mimeType = "image/tiff"
                    Case Else
                        format = "PDF"
                        mimeType = "application/pdf"
                End Select

                bytes = .Render(format, deviceInfo, mimeType, encoding, extension, streamIDs, warnings)


                Dim s() As Warning = warnings

                'Try

                '    ' Diagnostics.Process.Start("cmd C:  \Users\jorge.ramos\Desktop\Clean.bat")
                'If System.IO.Directory.Exists("C:\Form_Test\") Then
                '    Dim fts As String = Date.Now.Ticks
                '    Dim filenametopdf As String = "C:\Form_Test\" & reportName.Remove(0, 1).Remove(reportName.Length - 6, 5) & "-" & fts & ".pdf"
                '    System.IO.File.WriteAllBytes(filenametopdf, bytes)
                '    Diagnostics.Process.Start(filenametopdf)
                'End If



                'Catch ex As Exception

                'End Try

            End With
            ds.Dispose()

        Catch ex As Exception

            Dim requestXML As String

            requestXML = SerializeObject(ahaItem)

            Dim mp As New StringBuilder

            Try
                mp.AppendLine(String.Format("ClaimID = {0}", ahaItem.ID))

                If ahaItem.FormHeader.MemberID.Value IsNot Nothing Then mp.AppendLine(String.Format("MemberID = {0}", ahaItem.FormHeader.MemberID.Value))
                If ahaItem.FormHeader.BillingNPI.Value IsNot Nothing Then mp.AppendLine(String.Format("BillingNPI = {0}", ahaItem.FormHeader.BillingNPI.Value))
                If ahaItem.FormHeader.RenderingNPI.Value IsNot Nothing Then mp.AppendLine(String.Format("RenderingNPI = {0}", ahaItem.FormHeader.RenderingNPI.Value))

                mp.AppendLine("RequestXML...")
                mp.AppendLine(requestXML)

            Catch 'ex As Exception
            End Try

            Globals.LogError(ahaItem.SessionID, MethodBase.GetCurrentMethod.DeclaringType.Name, MethodBase.GetCurrentMethod.Name, mp.ToString, ex.Message, ex.StackTrace, sMemberID, sRenderingNPI)

            Throw
        End Try

        Return bytes

    End Function

    Private Function GetAHAReport2024(ByVal ahaItem As AHAFormItemShort, ByVal exportFormat As String, ByVal hasAddendum As Boolean, ByVal changeColor As Boolean, Optional ByVal addendumFirst As Boolean = False) As Byte()
        Dim rptViewer As New ReportViewer
        Dim bytes() As Byte = Nothing

        'get type of payer
        Dim payers As Dictionary(Of String, Boolean) = Globals.ValidatePayerID(ahaItem)
        Dim _isGHP As Boolean = payers.Item("isGHP")
        Dim _isAhaFL As Boolean = payers.Item("isAhaFL")
        Dim _isAhaPR As Boolean = payers.Item("isAhaPR")
        Dim _isDX As Boolean = False
        Dim iAge As Double = (TimeSpan.FromTicks(DateTime.Now.Ticks - ahaItem.FormHeader.MemberDOB.Value.Value.Ticks).TotalDays / 365.25)
        Dim _isPed As Boolean = iAge < 21



        Dim sMemberID As String = String.Empty
        Dim sRenderingNPI As String = String.Empty

        If Not (IsNothing(ahaItem)) Then
            If Not IsNothing(ahaItem.FormHeader) Then

                If Not IsNothing(ahaItem.FormHeader.MemberID) Then
                    If Not IsNothing(ahaItem.FormHeader.MemberID.Value) Then
                        sMemberID = ahaItem.FormHeader.MemberID.Value
                    End If
                End If

                If Not IsNothing(ahaItem.FormHeader.RenderingNPI) Then
                    If Not IsNothing(ahaItem.FormHeader.RenderingNPI.Value) Then
                        sRenderingNPI = ahaItem.FormHeader.RenderingNPI.Value
                    End If
                End If

            End If
        End If


        Try

            Dim ahahelp As New AHAReportHelper2023(ahaItem)
            Dim ds As DataSet = ahahelp.ConvertToDatasetShort()
            Dim rptSubReport As String = ""
            Dim hasSubReport As Boolean = False
            Dim rptSubReportNameID As String = ""

            rptViewer.Reset()

            With rptViewer.LocalReport

                .DataSources.Clear()

                Dim reportName As String
                reportName = ""

                If _isGHP Then

                    If _isPed Then
                        If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                            reportName = ".GHP2024_Ped_ENG_THA.rdlc"
                        Else
                            reportName = ".GHP2024_Ped_THA.rdlc"
                        End If
                    Else
                        If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                            reportName = ".GHP2024_ENG_THA.rdlc"
                        Else
                            reportName = ".GHP2024_THA.rdlc"
                        End If
                    End If



                ElseIf _isAhaFL Or _isAhaPR Then

                    If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                        reportName = ".AHA2024Short_ENG.rdlc"
                    Else
                        reportName = ".AHA2024Short.rdlc"
                    End If
                End If


                hasAddendum = AHAHasAddendum(ahaItem.ID)


                If ahaItem.FormHeader.Status.Value = 4 And hasAddendum Then



                    reportName = ".AHA2024_WithAddendumAndDx.rdlc"

                    .DataSources.Add(New ReportDataSource("dsAHAClaims_AcceptedDx", GetDxList(ahaItem.ID)))

                    Dim dsAddendum As DataSet = GetAddendumReport(Convert.ToInt32(ahaItem.ID))

                    .DataSources.Add(New ReportDataSource("Addendum", dsAddendum.Tables(0)))
                    .DataSources.Add(New ReportDataSource("Claims", dsAddendum.Tables(1)))
                    .DataSources.Add(New ReportDataSource("AddendumRejectCodes", dsAddendum.Tables(2)))

                    AddHandler .SubreportProcessing, AddressOf SubReportEventHandler

                ElseIf ahaItem.FormHeader.Status.Value = 4 AndAlso Not hasAddendum Then
                    _isDX = True


                    ' ajuste temporero
                    If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                        reportName = ".AHA2024Short_ENG.rdlc"
                    Else
                        reportName = ".AHA2024Short.rdlc"
                    End If
                    hasSubReport = False

                    .DataSources.Add(New ReportDataSource("dsAHAClaims_AcceptedDx", GetDxList(ahaItem.ID)))

                    AddHandler .SubreportProcessing, AddressOf SubReportEventHandler

                ElseIf hasAddendum Then

                    If addendumFirst Then
                        reportName = ".AddendumWithAHA2024.rdlc"
                    Else

                        If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                            reportName = ".AHA2024Short_ENG.rdlc"
                        Else
                            reportName = ".AHA2024Short.rdlc"
                        End If
                    End If

                    Dim dsAddendum As DataSet = GetAddendumReport(Convert.ToInt32(ahaItem.ID))

                    .DataSources.Add(New ReportDataSource("Addendum", dsAddendum.Tables(0)))
                    .DataSources.Add(New ReportDataSource("Claims", dsAddendum.Tables(1)))
                    .DataSources.Add(New ReportDataSource("AddendumRejectCodes", dsAddendum.Tables(2)))

                    AddHandler .SubreportProcessing, AddressOf SubReportEventHandler

                End If

                Dim asm As Assembly = Assembly.GetAssembly(Me.GetType())


                If (hasSubReport) Then
                    .LoadReportDefinition(asm.GetManifestResourceStream(Assembly.GetExecutingAssembly.GetName.Name & reportName))
                    .LoadSubreportDefinition(rptSubReportNameID, asm.GetManifestResourceStream("AHAController" + rptSubReport))
                Else
                    .ReportEmbeddedResource = Assembly.GetExecutingAssembly.GetName.Name & reportName

                End If

                If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                    .LoadSubreportDefinition("AHA2024_MalnutritionCriteria_ENG", asm.GetManifestResourceStream("AHAController" + ".AHA2024_MalnutritionCriteria_ENG.rdlc"))
                    .LoadSubreportDefinition("AHA2024_SocialDeterminants_ENG", asm.GetManifestResourceStream("AHAController" + ".AHA2024_SocialDeterminants_ENG.rdlc"))
                    .LoadSubreportDefinition("AHA2024_ScreeningSubstanceUse_ENG", asm.GetManifestResourceStream("AHAController" + ".AHA2024_ScreeningSubstanceUse_ENG.rdlc"))
                    If iAge >= 11 AndAlso iAge <= 20 AndAlso _isGHP Then
                        .LoadSubreportDefinition("AHA2024_PHQ9_ENG", asm.GetManifestResourceStream("AHAController" + ".AHA2024_PHQA_ENG.rdlc"))
                    Else
                        .LoadSubreportDefinition("AHA2024_PHQ9_ENG", asm.GetManifestResourceStream("AHAController" + ".AHA2024_PHQ9_ENG.rdlc"))
                    End If
                Else
                    .LoadSubreportDefinition("AHA2024_MalnutritionCriteria", asm.GetManifestResourceStream("AHAController" + ".AHA2024_MalnutritionCriteria.rdlc"))
                    .LoadSubreportDefinition("AHA2024_SocialDeterminants", asm.GetManifestResourceStream("AHAController" + ".AHA2024_SocialDeterminants.rdlc"))
                    .LoadSubreportDefinition("AHA2024_ScreeningSubstanceUse", asm.GetManifestResourceStream("AHAController" + ".AHA2024_ScreeningSubstanceUse.rdlc"))
                    If iAge >= 11 AndAlso iAge <= 20 AndAlso _isGHP Then
                        .LoadSubreportDefinition("AHA2024_PHQ9_ENG", asm.GetManifestResourceStream("AHAController" + ".AHA2024_PHQA_ENG.rdlc"))
                    Else
                        .LoadSubreportDefinition("AHA2024_PHQ9", asm.GetManifestResourceStream("AHAController" + ".AHA2024_PHQ9.rdlc"))
                    End If
                End If

                .DataSources.Add(New ReportDataSource("dsAHA2024_Claims_AHADetail", ds.Tables("Claims_AHADetail")))
                .DataSources.Add(New ReportDataSource("dsAHA2024_Claims", ds.Tables("Claims")))
                .DataSources.Add(New ReportDataSource("dsAHA2024_Claims_DX", ds.Tables("Claims_DX")))
                .DataSources.Add(New ReportDataSource("dsAHA2024_Claims_PressureSore", ds.Tables("Claims_PressureSores")))
                .DataSources.Add(New ReportDataSource("dsAHA2024_Claims_DiseasesOfTheSkin", ds.Tables("Claims_DiseasesOfTheSkin")))
                .DataSources.Add(New ReportDataSource("dsAHA2024_Claims_AHADetail_Short", ds.Tables("Claims_AHADetail_Short")))
                .DataSources.Add(New ReportDataSource("dsAHA2024_Claims_MalnutritionCriteria", ds.Tables("Claims_MalnutritionCriteria")))
                If _isGHP Then
                    .DataSources.Add(New ReportDataSource("dsAHA2024_Claims_SocialDeterminants", ds.Tables("Claims_SocialDeterminants")))
                Else
                    .DataSources.Add(New ReportDataSource("dsAHA2024_Claims_SocialDeterminants2023", ds.Tables("Claims_SocialDeterminants2023")))
                End If
                .DataSources.Add(New ReportDataSource("dsAHA2024_ScreeningSubstanceUse", ds.Tables("Claims_ScreeningSubstanceUse")))

                AddHandler .SubreportProcessing, AddressOf SubReportEventHandler

                Dim isEmptyAHA As New ReportParameter
                Dim TextColorReport As New ReportParameter()
                Dim isFlorida As New ReportParameter
                Dim biClaimIDSub As New ReportParameter
                Dim isPed As New ReportParameter
                Dim isGHP As New ReportParameter
                Dim isTHA As New ReportParameter


                isFlorida.Name = "isFlorida"
                isFlorida.Values.Add(_isAhaFL)

                isPed.Name = "isPED"
                isPed.Values.Add(False)

                isGHP.Name = "isGHP"
                isGHP.Values.Add(False)

                isTHA.Name = "isTHA"
                isTHA.Values.Add(True)


                TextColorReport.Name = "InputTextColor"
                If changeColor Then
                    TextColorReport.Values.Add(True)
                Else
                    TextColorReport.Values.Add(False)
                End If

                isEmptyAHA.Name = "IsEmptyAHA"
                isEmptyAHA.Values.Add(False)


                biClaimIDSub.Name = "biClaimIDSub"
                biClaimIDSub.Values.Add(ahaItem.ID)


                Dim parameters() As ReportParameter

                parameters = {TextColorReport, isEmptyAHA, isFlorida, biClaimIDSub}

                Dim parametersList = New List(Of ReportParameter)()

                parametersList.AddRange(parameters)

                If UCase(exportFormat) = "PDF/NO" Then
                    parametersList.Add(New ReportParameter("printAppends", False))
                    exportFormat = "PDF"
                End If

                .SetParameters(parametersList.ToArray())

                .Refresh()

                Dim format As String = ""
                Dim deviceInfo As String = String.Empty
                Dim mimeType As String = ""
                Dim encoding As String = String.Empty
                Dim extension As String = "pdf"
                Dim streamIDs() As String = Nothing
                Dim warnings() As Warning = Nothing

                Select Case UCase(exportFormat)
                    Case UCase("tiff")
                        format = "IMAGE"
                        mimeType = "image/tiff"
                    Case Else
                        format = "PDF"
                        mimeType = "application/pdf"
                End Select

                bytes = .Render(format, deviceInfo, mimeType, encoding, extension, streamIDs, warnings)

                'Try
                '#If DEBUG Then
                '                    If System.IO.Directory.Exists("C:\Form_Test\") Then
                '                        Dim fts As String = Date.Now.Ticks
                '                        Dim filenametopdf As String = "C:\Form_Test\" & reportName.Remove(0, 1).Remove(reportName.Length - 6, 5) & "-" & fts & ".pdf"
                '                        System.IO.File.WriteAllBytes(filenametopdf, bytes)
                '                        Diagnostics.Process.Start(filenametopdf)
                '                    End If
                '#End If
                '                Catch ex As Exception
                'End Try

            End With
            ds.Dispose()

        Catch ex As Exception

            Dim requestXML As String

            requestXML = SerializeObject(ahaItem)

            Dim mp As New StringBuilder

            Try
                mp.AppendLine(String.Format("ClaimID = {0}", ahaItem.ID))

                If ahaItem.FormHeader.MemberID.Value IsNot Nothing Then mp.AppendLine(String.Format("MemberID = {0}", ahaItem.FormHeader.MemberID.Value))
                If ahaItem.FormHeader.BillingNPI.Value IsNot Nothing Then mp.AppendLine(String.Format("BillingNPI = {0}", ahaItem.FormHeader.BillingNPI.Value))
                If ahaItem.FormHeader.RenderingNPI.Value IsNot Nothing Then mp.AppendLine(String.Format("RenderingNPI = {0}", ahaItem.FormHeader.RenderingNPI.Value))

                mp.AppendLine("RequestXML...")
                mp.AppendLine(requestXML)

            Catch

            End Try

            Globals.LogError(ahaItem.SessionID, MethodBase.GetCurrentMethod.DeclaringType.Name, MethodBase.GetCurrentMethod.Name, mp.ToString, ex.Message, ex.StackTrace, sMemberID, sRenderingNPI)

            Throw
        End Try

        Return bytes
    End Function


    Private Function GetAHAReport2025(ByVal ahaItem As AHAFormItem, ByVal exportFormat As String, ByVal hasAddendum As Boolean, ByVal changeColor As Boolean, Optional ByVal addendumFirst As Boolean = False) As Byte()
        'Define year for rdlc reportingName
        Const rptYear As String = "2025"

        Dim rptViewer As New ReportViewer
        Dim bytes() As Byte = Nothing
        'get type of payer
        Dim payers As Dictionary(Of String, Boolean) = Globals.ValidatePayerID(ahaItem)
        Dim _isGHP As Boolean = payers.Item("isGHP")
        Dim _isAhaFL As Boolean = payers.Item("isAhaFL")
        Dim _isAhaPR As Boolean = payers.Item("isAhaPR")
        Dim _isDX As Boolean = False
        Dim _isPed As Boolean = False
        Dim sMemberID As String = String.Empty
        Dim sRenderingNPI As String = String.Empty

        If Not (IsNothing(ahaItem)) Then
            If Not IsNothing(ahaItem.FormHeader) Then

                If Not IsNothing(ahaItem.FormHeader.MemberID) Then
                    If Not IsNothing(ahaItem.FormHeader.MemberID.Value) Then
                        sMemberID = ahaItem.FormHeader.MemberID.Value
                    End If
                End If

                If Not IsNothing(ahaItem.FormHeader.RenderingNPI) Then
                    If Not IsNothing(ahaItem.FormHeader.RenderingNPI.Value) Then
                        sRenderingNPI = ahaItem.FormHeader.RenderingNPI.Value
                    End If
                End If
            End If
        End If

        Try
            Dim ahahelp As New AHAReportHelper2025(ahaItem)
            Dim ds As DataSet = ahahelp.ConvertToDataset()
            Dim rptSubReport As String = ""
            Dim hasSubReport As Boolean = False
            Dim rptSubReportNameID As String = ""

            rptViewer.Reset()

            Dim iAge As Long = DateDiff(DateInterval.Year, CType(ahaItem.FormHeader.MemberDOB.Value, Date), CType(ahaItem.FormHeader.DateOfVisit.Value, Date)) -
                                        If(DateAdd(DateInterval.Year, DateDiff(DateInterval.Year, CType(ahaItem.FormHeader.MemberDOB.Value, Date), CType(ahaItem.FormHeader.DateOfVisit.Value, Date)), CType(ahaItem.FormHeader.MemberDOB.Value, Date)) > CType(ahaItem.FormHeader.DateOfVisit.Value, Date), 1, 0)

            With rptViewer.LocalReport
                .DataSources.Clear()

                Dim reportName As String
                reportName = ""

                If _isGHP Then
                    _isPed = iAge < 21

                    If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                        If _isPed Then
                            reportName = $".GHP{rptYear}_Ped_ENG.rdlc"
                        Else
                            reportName = $".GHP{rptYear}_ENG.rdlc"
                        End If
                    Else
                        If _isPed Then
                            reportName = $".GHP{rptYear}_Ped.rdlc"
                        Else
                            reportName = $".GHP{rptYear}.rdlc"
                        End If
                    End If
                ElseIf _isAhaFL Then
                    'Same goes for the others but in the future can descriminate.
                    If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                        reportName = $".AHAFL{rptYear}_ENG.rdlc"
                    Else
                        reportName = $".AHAFL{rptYear}.rdlc"
                    End If
                ElseIf _isAhaPR Then
                    If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                        reportName = $".AHA{rptYear}_ENG.rdlc"
                    Else
                        reportName = $".AHA{rptYear}.rdlc"
                    End If
                Else
                    If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                        reportName = $".AHA{rptYear}_ENG.rdlc"
                    Else
                        reportName = $".AHA{rptYear}.rdlc"
                    End If
                End If

                hasAddendum = AHAHasAddendum(ahaItem.ID)

                If ahaItem.FormHeader.Status.Value = 4 And hasAddendum Then
                    reportName = $".AHA{rptYear}_WithAddendumAndDx.rdlc"

                    .DataSources.Add(New ReportDataSource("dsAHAClaims_AcceptedDx", GetDxList(ahaItem.ID)))

                    Dim dsAddendum As DataSet = GetAddendumReport(Convert.ToInt32(ahaItem.ID))

                    .DataSources.Add(New ReportDataSource("Addendum", dsAddendum.Tables(0)))
                    .DataSources.Add(New ReportDataSource("Claims", dsAddendum.Tables(1)))
                    .DataSources.Add(New ReportDataSource("AddendumRejectCodes", dsAddendum.Tables(2)))

                    AddHandler .SubreportProcessing, AddressOf SubReportEventHandler
                ElseIf ahaItem.FormHeader.Status.Value = 4 AndAlso Not hasAddendum Then
                    _isDX = True

                    If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                        rptSubReport = reportName
                        reportName = $".AHA{rptYear}_WithDx_ENG.rdlc"
                        rptSubReportNameID = $"AHA{rptYear}_ENG"
                    Else
                        rptSubReport = reportName
                        reportName = $".AHA{rptYear}_WithDx.rdlc"
                        rptSubReportNameID = $"AHA{rptYear}"
                    End If

                    ' ajuste temporero
                    hasSubReport = True
                    .DataSources.Add(New ReportDataSource("dsAHAClaims_AcceptedDx", GetDxList(ahaItem.ID)))
                    AddHandler .SubreportProcessing, AddressOf SubReportEventHandler
                ElseIf hasAddendum Then
                    If addendumFirst Then
                        reportName = $".AddendumWithAHA{rptYear}.rdlc"
                    End If

                    Dim dsAddendum As DataSet = GetAddendumReport(Convert.ToInt32(ahaItem.ID))

                    .DataSources.Add(New ReportDataSource("Addendum", dsAddendum.Tables(0)))
                    .DataSources.Add(New ReportDataSource("Claims", dsAddendum.Tables(1)))
                    .DataSources.Add(New ReportDataSource("AddendumRejectCodes", dsAddendum.Tables(2)))

                    AddHandler .SubreportProcessing, AddressOf SubReportEventHandler

                End If

                Dim asm As Assembly = Assembly.GetAssembly(Me.GetType())

                If (hasSubReport) Then
                    .LoadReportDefinition(asm.GetManifestResourceStream(Assembly.GetExecutingAssembly.GetName.Name & reportName))
                    .LoadSubreportDefinition(rptSubReportNameID, asm.GetManifestResourceStream("AHAController" + rptSubReport))
                Else
                    .ReportEmbeddedResource = Assembly.GetExecutingAssembly.GetName.Name & reportName
                End If
                If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                    .LoadSubreportDefinition($"AHA{rptYear}_MalnutritionCriteria_ENG", asm.GetManifestResourceStream("AHAController" + $".AHA{rptYear}_MalnutritionCriteria_ENG.rdlc"))
                    If _isGHP Then
                        .LoadSubreportDefinition($"AHA{rptYear}_SocialDeterminants_ENG", asm.GetManifestResourceStream("AHAController" + $".AHA{rptYear}_SocialDeterminants_ENG.rdlc"))
                    Else
                        .LoadSubreportDefinition($"AHA{rptYear}_SocialDeterminants_ENG", asm.GetManifestResourceStream("AHAController" + $".AHA{rptYear}_SocialDeterminants_ENG.rdlc"))
                    End If
                    .LoadSubreportDefinition($"AHA{rptYear}_ScreeningSubstanceUse_ENG", asm.GetManifestResourceStream("AHAController" + $".AHA{rptYear}_ScreeningSubstanceUse_ENG.rdlc"))
                    If iAge >= 11 AndAlso iAge <= 20 AndAlso _isGHP Then
                        .LoadSubreportDefinition($"AHA{rptYear}_PHQ9_ENG", asm.GetManifestResourceStream("AHAController" + $".AHA{rptYear}_PHQA_ENG.rdlc"))
                    Else
                        .LoadSubreportDefinition($"AHA{rptYear}_PHQ9_ENG", asm.GetManifestResourceStream("AHAController" + $".AHA{rptYear}_PHQ9_ENG.rdlc"))
                    End If
                Else
                    .LoadSubreportDefinition($"AHA{rptYear}_MalnutritionCriteria", asm.GetManifestResourceStream("AHAController" + $".AHA{rptYear}_MalnutritionCriteria.rdlc"))
                    If _isGHP Then
                        .LoadSubreportDefinition($"AHA{rptYear}_SocialDeterminants", asm.GetManifestResourceStream("AHAController" + $".AHA{rptYear}_SocialDeterminants.rdlc"))
                    Else
                        .LoadSubreportDefinition($"AHA{rptYear}_SocialDeterminants", asm.GetManifestResourceStream("AHAController" + $".AHA{rptYear}_SocialDeterminants.rdlc"))
                    End If
                    .LoadSubreportDefinition($"AHA{rptYear}_ScreeningSubstanceUse", asm.GetManifestResourceStream("AHAController" + $".AHA{rptYear}_ScreeningSubstanceUse.rdlc"))
                    If iAge >= 11 AndAlso iAge <= 20 AndAlso _isGHP Then
                        .LoadSubreportDefinition($"AHA{rptYear}_PHQ9", asm.GetManifestResourceStream("AHAController" + $".AHA{rptYear}_PHQA.rdlc"))
                    Else
                        .LoadSubreportDefinition($"AHA{rptYear}_PHQ9", asm.GetManifestResourceStream("AHAController" + $".AHA{rptYear}_PHQ9.rdlc")) ' Assembly.GetExecutingAssembly().GetName().Name
                    End If
                End If

                .DataSources.Add(New ReportDataSource($"dsAHA{rptYear}_Claims_AHADetail", ds.Tables("Claims_AHADetail")))
                .DataSources.Add(New ReportDataSource($"dsAHA{rptYear}_Claims", ds.Tables("Claims")))
                .DataSources.Add(New ReportDataSource($"dsAHA{rptYear}_Claims_DX", ds.Tables("Claims_DX")))
                .DataSources.Add(New ReportDataSource($"dsAHA{rptYear}_Claims_PressureSore", ds.Tables("Claims_PressureSores")))
                .DataSources.Add(New ReportDataSource($"dsAHA{rptYear}_Claims_DiseasesOfTheSkin", ds.Tables("Claims_DiseasesOfTheSkin")))
                .DataSources.Add(New ReportDataSource($"dsAHA{rptYear}_Claims_MalnutritionCriteria", ds.Tables("Claims_MalnutritionCriteria")))
                .DataSources.Add(New ReportDataSource($"dsAHA{rptYear}_ScreeningSubstanceUse", ds.Tables("Claims_ScreeningSubstanceUse")))

                ' New 2023
                If _isGHP Then
                    .DataSources.Add(New ReportDataSource($"dsAHA{rptYear}_Claims_SocialDeterminants", ds.Tables("Claims_SocialDeterminants")))
                End If
                .DataSources.Add(New ReportDataSource($"dsAHA{rptYear}_Claims_SocialDeterminants{rptYear}", ds.Tables($"Claims_SocialDeterminants2023")))

                'If PHQ9 is not rendered skip this line!!!
                RemoveHandler .SubreportProcessing, AddressOf SubReportEventHandler
                AddHandler .SubreportProcessing, AddressOf SubReportEventHandler

                Dim isEmptyAHA As New ReportParameter
                Dim TextColorReport As New ReportParameter()
                Dim isFlorida As New ReportParameter
                Dim biClaimIDSub As New ReportParameter
                Dim isPed As New ReportParameter
                Dim isGHP As New ReportParameter
                Dim isTHA As New ReportParameter

                isFlorida.Name = "isFlorida"
                isFlorida.Values.Add(_isAhaFL)

                TextColorReport.Name = "InputTextColor"
                If changeColor Then
                    TextColorReport.Values.Add(True)
                Else
                    TextColorReport.Values.Add(False)
                End If

                isEmptyAHA.Name = "IsEmptyAHA"
                isEmptyAHA.Values.Add(False)

                biClaimIDSub.Name = "biClaimIDSub"
                biClaimIDSub.Values.Add(ahaItem.ID)

                isPed.Name = "isPED"
                isPed.Values.Add(_isPed)

                isGHP.Name = "isGHP"
                isGHP.Values.Add(_isGHP)

                isTHA.Name = "isTHA"
                isTHA.Values.Add(False)

                Dim parameters() As ReportParameter

                If _isDX Then
                    parameters = {TextColorReport, isEmptyAHA, isFlorida, biClaimIDSub, isTHA, isGHP, isPed}
                Else
                    parameters = {TextColorReport, isEmptyAHA, isFlorida, biClaimIDSub}
                End If

                Dim parametersList As New List(Of ReportParameter)()

                parametersList.AddRange(parameters)

                If UCase(exportFormat) = "PDF/NO" Then
                    parametersList.Add(New ReportParameter("printAppends", False))
                    exportFormat = "PDF"
                End If

                .SetParameters(parametersList.ToArray())
                .Refresh()

                Dim format As String = ""
                Dim deviceInfo As String = String.Empty
                Dim mimeType As String = ""
                Dim encoding As String = String.Empty
                Dim extension As String = "pdf"
                Dim streamIDs() As String = Nothing
                Dim warnings() As Warning = Nothing

                Select Case UCase(exportFormat)
                    Case UCase("tiff")
                        format = "IMAGE"
                        mimeType = "image/tiff"
                    Case Else
                        format = "PDF"
                        mimeType = "application/pdf"
                End Select

                bytes = .Render(format, deviceInfo, mimeType, encoding, extension, streamIDs, warnings)

                Dim s() As Warning = warnings
            End With

            ds.Dispose()
        Catch ex As Exception
            Dim requestXML As String

            requestXML = SerializeObject(ahaItem)

            Dim mp As New StringBuilder

            Try
                mp.AppendLine(String.Format("ClaimID = {0}", ahaItem.ID))

                If ahaItem.FormHeader.MemberID.Value IsNot Nothing Then mp.AppendLine(String.Format("MemberID = {0}", ahaItem.FormHeader.MemberID.Value))
                If ahaItem.FormHeader.BillingNPI.Value IsNot Nothing Then mp.AppendLine(String.Format("BillingNPI = {0}", ahaItem.FormHeader.BillingNPI.Value))
                If ahaItem.FormHeader.RenderingNPI.Value IsNot Nothing Then mp.AppendLine(String.Format("RenderingNPI = {0}", ahaItem.FormHeader.RenderingNPI.Value))

                mp.AppendLine("RequestXML...")
                mp.AppendLine(requestXML)

            Catch 'ex As Exception
            End Try

            Globals.LogError(ahaItem.SessionID, MethodBase.GetCurrentMethod.DeclaringType.Name, MethodBase.GetCurrentMethod.Name, mp.ToString, String.Format("Message: {0} InnerException: {1}", ex.Message, ex.InnerException), ex.StackTrace, sMemberID, sRenderingNPI)

            Throw
        End Try

        Return bytes
    End Function

    Private Function GetAHAReport2025(ByVal ahaItem As AHAFormItemShort, ByVal exportFormat As String, ByVal hasAddendum As Boolean, ByVal changeColor As Boolean, Optional ByVal addendumFirst As Boolean = False) As Byte()
        'Define year for reportingName
        Const rptYear As String = "2025"

        Dim rptViewer As New ReportViewer
        Dim bytes() As Byte = Nothing

        'get type of payer
        Dim payers As Dictionary(Of String, Boolean) = Globals.ValidatePayerID(ahaItem)
        Dim _isGHP As Boolean = payers.Item("isGHP")
        Dim _isAhaFL As Boolean = payers.Item("isAhaFL")
        Dim _isAhaPR As Boolean = payers.Item("isAhaPR")
        Dim _isDX As Boolean = False
        Dim iAge As Double = (TimeSpan.FromTicks(DateTime.Now.Ticks - ahaItem.FormHeader.MemberDOB.Value.Value.Ticks).TotalDays / 365.25)
        Dim _isPed As Boolean = iAge < 21
        Dim sMemberID As String = String.Empty
        Dim sRenderingNPI As String = String.Empty

        If Not (IsNothing(ahaItem)) Then
            If Not IsNothing(ahaItem.FormHeader) Then
                If Not IsNothing(ahaItem.FormHeader.MemberID) Then
                    If Not IsNothing(ahaItem.FormHeader.MemberID.Value) Then
                        sMemberID = ahaItem.FormHeader.MemberID.Value
                    End If
                End If

                If Not IsNothing(ahaItem.FormHeader.RenderingNPI) Then
                    If Not IsNothing(ahaItem.FormHeader.RenderingNPI.Value) Then
                        sRenderingNPI = ahaItem.FormHeader.RenderingNPI.Value
                    End If
                End If
            End If
        End If

        Try
            Dim ahahelp As New AHAReportHelper2025(ahaItem)
            Dim ds As DataSet = ahahelp.ConvertToDatasetShort()
            Dim rptSubReport As String = ""
            Dim hasSubReport As Boolean = False
            Dim rptSubReportNameID As String = ""

            rptViewer.Reset()

            With rptViewer.LocalReport
                .DataSources.Clear()

                Dim reportName As String
                reportName = ""

                If _isGHP Then
                    If _isPed Then
                        If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                            reportName = $".GHP{rptYear}_Ped_ENG_THA.rdlc"
                        Else
                            reportName = $".GHP{rptYear}_Ped_THA.rdlc"
                        End If
                    Else
                        If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                            reportName = $".GHP{rptYear}_ENG_THA.rdlc"
                        Else
                            reportName = $".GHP{rptYear}_THA.rdlc"
                        End If
                    End If
                ElseIf _isAhaFL Or _isAhaPR Then
                    If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                        reportName = $".AHA{rptYear}Short_ENG.rdlc"
                    Else
                        reportName = $".AHA{rptYear}Short.rdlc"
                    End If
                End If

                hasAddendum = AHAHasAddendum(ahaItem.ID)

                If ahaItem.FormHeader.Status.Value = 4 And hasAddendum Then
                    reportName = $".AHA{rptYear}_WithAddendumAndDx.rdlc"

                    .DataSources.Add(New ReportDataSource("dsAHAClaims_AcceptedDx", GetDxList(ahaItem.ID)))

                    Dim dsAddendum As DataSet = GetAddendumReport(Convert.ToInt32(ahaItem.ID))

                    .DataSources.Add(New ReportDataSource("Addendum", dsAddendum.Tables(0)))
                    .DataSources.Add(New ReportDataSource("Claims", dsAddendum.Tables(1)))
                    .DataSources.Add(New ReportDataSource("AddendumRejectCodes", dsAddendum.Tables(2)))

                    AddHandler .SubreportProcessing, AddressOf SubReportEventHandler
                ElseIf ahaItem.FormHeader.Status.Value = 4 AndAlso Not hasAddendum Then
                    _isDX = True

                    ' ajuste temporero
                    If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                        reportName = $".AHA{rptYear}Short_ENG.rdlc"
                    Else
                        reportName = $".AHA{rptYear}Short.rdlc"
                    End If

                    hasSubReport = False

                    .DataSources.Add(New ReportDataSource("dsAHAClaims_AcceptedDx", GetDxList(ahaItem.ID)))

                    AddHandler .SubreportProcessing, AddressOf SubReportEventHandler
                ElseIf hasAddendum Then
                    If addendumFirst Then
                        reportName = $".AddendumWithAHA{rptYear}.rdlc"
                    Else
                        If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                            reportName = $".AHA{rptYear}Short_ENG.rdlc"
                        Else
                            reportName = $".AHA{rptYear}Short.rdlc"
                        End If
                    End If

                    Dim dsAddendum As DataSet = GetAddendumReport(Convert.ToInt32(ahaItem.ID))

                    .DataSources.Add(New ReportDataSource("Addendum", dsAddendum.Tables(0)))
                    .DataSources.Add(New ReportDataSource("Claims", dsAddendum.Tables(1)))
                    .DataSources.Add(New ReportDataSource("AddendumRejectCodes", dsAddendum.Tables(2)))

                    AddHandler .SubreportProcessing, AddressOf SubReportEventHandler
                End If

                Dim asm As Assembly = Assembly.GetAssembly(Me.GetType())

                If (hasSubReport) Then
                    .LoadReportDefinition(asm.GetManifestResourceStream(Assembly.GetExecutingAssembly.GetName.Name & reportName))
                    .LoadSubreportDefinition(rptSubReportNameID, asm.GetManifestResourceStream("AHAController" + rptSubReport))
                Else
                    .ReportEmbeddedResource = Assembly.GetExecutingAssembly.GetName.Name & reportName
                End If

                If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                    .LoadSubreportDefinition($"AHA{rptYear}_MalnutritionCriteria_ENG", asm.GetManifestResourceStream("AHAController" + $".AHA{rptYear}_MalnutritionCriteria_ENG.rdlc"))
                    .LoadSubreportDefinition($"AHA{rptYear}_SocialDeterminants_ENG", asm.GetManifestResourceStream("AHAController" + $".AHA{rptYear}_SocialDeterminants_ENG.rdlc"))
                    .LoadSubreportDefinition($"AHA{rptYear}_ScreeningSubstanceUse_ENG", asm.GetManifestResourceStream("AHAController" + $".AHA{rptYear}_ScreeningSubstanceUse_ENG.rdlc"))

                    If iAge >= 11 AndAlso iAge <= 20 AndAlso _isGHP Then
                        .LoadSubreportDefinition($"AHA{rptYear}_PHQ9_ENG", asm.GetManifestResourceStream("AHAController" + $".AHA{rptYear}_PHQA_ENG.rdlc"))
                    Else
                        .LoadSubreportDefinition($"AHA{rptYear}_PHQ9_ENG", asm.GetManifestResourceStream("AHAController" + $".AHA{rptYear}_PHQ9_ENG.rdlc"))
                    End If
                Else
                    .LoadSubreportDefinition($"AHA{rptYear}_MalnutritionCriteria", asm.GetManifestResourceStream("AHAController" + $".AHA{rptYear}_MalnutritionCriteria.rdlc"))
                    .LoadSubreportDefinition($"AHA{rptYear}_SocialDeterminants", asm.GetManifestResourceStream("AHAController" + $".AHA{rptYear}_SocialDeterminants.rdlc"))
                    .LoadSubreportDefinition($"AHA{rptYear}_ScreeningSubstanceUse", asm.GetManifestResourceStream("AHAController" + $".AHA{rptYear}_ScreeningSubstanceUse.rdlc"))

                    If iAge >= 11 AndAlso iAge <= 20 AndAlso _isGHP Then
                        .LoadSubreportDefinition($"AHA{rptYear}_PHQ9_ENG", asm.GetManifestResourceStream("AHAController" + $".AHA{rptYear}_PHQA_ENG.rdlc"))
                    Else
                        .LoadSubreportDefinition($"AHA{rptYear}_PHQ9", asm.GetManifestResourceStream("AHAController" + $".AHA{rptYear}_PHQ9.rdlc"))
                    End If
                End If

                .DataSources.Add(New ReportDataSource($"dsAHA{rptYear}_Claims_AHADetail", ds.Tables("Claims_AHADetail")))
                .DataSources.Add(New ReportDataSource($"dsAHA{rptYear}_Claims", ds.Tables("Claims")))
                .DataSources.Add(New ReportDataSource($"dsAHA{rptYear}_Claims_DX", ds.Tables("Claims_DX")))
                .DataSources.Add(New ReportDataSource($"dsAHA{rptYear}_Claims_PressureSore", ds.Tables("Claims_PressureSores")))
                .DataSources.Add(New ReportDataSource($"dsAHA{rptYear}_Claims_DiseasesOfTheSkin", ds.Tables("Claims_DiseasesOfTheSkin")))
                .DataSources.Add(New ReportDataSource($"dsAHA{rptYear}_Claims_AHADetail_Short", ds.Tables("Claims_AHADetail_Short")))
                .DataSources.Add(New ReportDataSource($"dsAHA{rptYear}_Claims_MalnutritionCriteria", ds.Tables("Claims_MalnutritionCriteria")))

                ' New 2023
                If _isGHP Then
                    .DataSources.Add(New ReportDataSource($"dsAHA{rptYear}_Claims_SocialDeterminants", ds.Tables("Claims_SocialDeterminants")))
                End If
                .DataSources.Add(New ReportDataSource($"dsAHA{rptYear}_Claims_SocialDeterminants{rptYear}", ds.Tables($"Claims_SocialDeterminants2023")))

                .DataSources.Add(New ReportDataSource($"dsAHA{rptYear}_ScreeningSubstanceUse", ds.Tables("Claims_ScreeningSubstanceUse")))

                AddHandler .SubreportProcessing, AddressOf SubReportEventHandler

                Dim isEmptyAHA As New ReportParameter
                Dim TextColorReport As New ReportParameter()
                Dim isFlorida As New ReportParameter
                Dim biClaimIDSub As New ReportParameter
                Dim isPed As New ReportParameter
                Dim isGHP As New ReportParameter
                Dim isTHA As New ReportParameter

                isFlorida.Name = "isFlorida"
                isFlorida.Values.Add(_isAhaFL)

                isPed.Name = "isPED"
                isPed.Values.Add(False)

                isGHP.Name = "isGHP"
                isGHP.Values.Add(False)

                isTHA.Name = "isTHA"
                isTHA.Values.Add(True)

                TextColorReport.Name = "InputTextColor"
                If changeColor Then
                    TextColorReport.Values.Add(True)
                Else
                    TextColorReport.Values.Add(False)
                End If

                isEmptyAHA.Name = "IsEmptyAHA"
                isEmptyAHA.Values.Add(False)

                biClaimIDSub.Name = "biClaimIDSub"
                biClaimIDSub.Values.Add(ahaItem.ID)

                Dim parameters() As ReportParameter

                parameters = {TextColorReport, isEmptyAHA, isFlorida, biClaimIDSub}

                Dim parametersList = New List(Of ReportParameter)()

                parametersList.AddRange(parameters)

                If UCase(exportFormat) = "PDF/NO" Then
                    parametersList.Add(New ReportParameter("printAppends", False))
                    exportFormat = "PDF"
                End If

                .SetParameters(parametersList.ToArray())

                .Refresh()

                Dim format As String = ""
                Dim deviceInfo As String = String.Empty
                Dim mimeType As String = ""
                Dim encoding As String = String.Empty
                Dim extension As String = "pdf"
                Dim streamIDs() As String = Nothing
                Dim warnings() As Warning = Nothing

                Select Case UCase(exportFormat)
                    Case UCase("tiff")
                        format = "IMAGE"
                        mimeType = "image/tiff"
                    Case Else
                        format = "PDF"
                        mimeType = "application/pdf"
                End Select

                bytes = .Render(format, deviceInfo, mimeType, encoding, extension, streamIDs, warnings)
            End With

            ds.Dispose()
        Catch ex As Exception
            Dim requestXML As String

            requestXML = SerializeObject(ahaItem)

            Dim mp As New StringBuilder

            Try
                mp.AppendLine(String.Format("ClaimID = {0}", ahaItem.ID))

                If ahaItem.FormHeader.MemberID.Value IsNot Nothing Then mp.AppendLine(String.Format("MemberID = {0}", ahaItem.FormHeader.MemberID.Value))
                If ahaItem.FormHeader.BillingNPI.Value IsNot Nothing Then mp.AppendLine(String.Format("BillingNPI = {0}", ahaItem.FormHeader.BillingNPI.Value))
                If ahaItem.FormHeader.RenderingNPI.Value IsNot Nothing Then mp.AppendLine(String.Format("RenderingNPI = {0}", ahaItem.FormHeader.RenderingNPI.Value))

                mp.AppendLine("RequestXML...")
                mp.AppendLine(requestXML)
            Catch
            End Try

            Globals.LogError(ahaItem.SessionID, MethodBase.GetCurrentMethod.DeclaringType.Name, MethodBase.GetCurrentMethod.Name, mp.ToString, ex.Message, ex.StackTrace, sMemberID, sRenderingNPI)

            Throw
        End Try

        Return bytes
    End Function


    Private Function GetAHAReport2026(ByVal ahaItem As AHAFormItem, ByVal exportFormat As String, ByVal hasAddendum As Boolean, ByVal changeColor As Boolean, Optional ByVal addendumFirst As Boolean = False) As Byte()
