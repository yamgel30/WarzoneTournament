    Private Function GetOtherConditionDxDescription(ByVal dxCode As String, Optional ByVal year As Integer = 2017) As String

        Dim cn As New SqlConnection(ConnectionStrings(AppSettings("DBClaimAttach").ToString).ConnectionString)
        Dim cmd As New SqlCommand

        cmd.Connection = cn
        cmd.CommandType = CommandType.StoredProcedure
        cmd.CommandText = "usp_Portal_Repopulate_Dx_GetDescription"

        cmd.Parameters.Add("@code", SqlDbType.VarChar).Value = dxCode
        cmd.Parameters.Add("@year", SqlDbType.Int).Value = year

        Try
            cn.Open()

            Using dataReader As SqlDataReader = cmd.ExecuteReader

                If dataReader.HasRows AndAlso dataReader.Read Then
                    Return dataReader("Description").ToString()
                End If

            End Using

        Catch ex As Exception
            Globals.LogError(0, MethodBase.GetCurrentMethod.DeclaringType.Name, MethodBase.GetCurrentMethod.Name, "", ex.Message, ex.StackTrace)
        Finally
            cmd.Dispose()
            cn.Dispose()
        End Try

        Return ""

    End Function

