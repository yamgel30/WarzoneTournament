    Private Function GetAHAReport2016(ByVal ahaItem As AHAFormItem, ByVal exportFormat As String, ByVal hasAddendum As Boolean, Optional ByVal changeColor As Boolean = False) As Byte()

        Dim rptViewer As New ReportViewer
        Dim bytes() As Byte = Nothing

        Try

            Dim ahahelp As New AHAReportHelper2016(ahaItem)
            Dim ds As DataSet = ahahelp.ConvertToDataset()

            rptViewer.Reset()

            With rptViewer.LocalReport

                .DataSources.Clear()

                Dim reportName As String = ".AHA2016.rdlc"

                'Dim claimClassTag As Short = GetClaimClassTag(claimKey)

                If ahaItem.FormHeader.Status.Value = 4 And hasAddendum Then 'ahaItem.FormHeader.Status.Value.Value = 3 Or 
                    reportName = ".AHA2016_WithAddendumAndDx.rdlc"
                    .DataSources.Add(New ReportDataSource("dsAHAClaims_AcceptedDx", GetDxList(ahaItem.ID)))

                    Dim dsAddendum As DataSet = GetAddendumReport(Convert.ToInt32(ahaItem.ID))

                    .DataSources.Add(New ReportDataSource("Addendum", dsAddendum.Tables(0)))
                    .DataSources.Add(New ReportDataSource("Claims", dsAddendum.Tables(1)))
                    .DataSources.Add(New ReportDataSource("AddendumRejectCodes", dsAddendum.Tables(2)))

                ElseIf ahaItem.FormHeader.Status.Value = 4 Then
                    reportName = ".AHA2016_WithDx.rdlc"
                    .DataSources.Add(New ReportDataSource("dsAHAClaims_AcceptedDx", GetDxList(ahaItem.ID)))

                ElseIf hasAddendum Then
                    reportName = ".AHA2016_WithAddendum.rdlc"

                    Dim dsAddendum As DataSet = GetAddendumReport(Convert.ToInt32(ahaItem.ID))
                    .DataSources.Add(New ReportDataSource("Addendum", dsAddendum.Tables(0)))
                    .DataSources.Add(New ReportDataSource("Claims", dsAddendum.Tables(1)))
                    .DataSources.Add(New ReportDataSource("AddendumRejectCodes", dsAddendum.Tables(2)))
                End If

                If changeColor Then
                    If Not hasAddendum Then
                        reportName = ".AHA2016_Audit.rdlc"
                    Else
                        reportName = ".AHA2016_WithAddendum_Audit.rdlc"
                    End If
                End If



                .ReportEmbeddedResource = Assembly.GetExecutingAssembly.GetName.Name & reportName

                .DataSources.Add(New ReportDataSource("dsAHA2016_Claims_AHADetail", ds.Tables(2)))
                .DataSources.Add(New ReportDataSource("dsAHA2016_Claims", ds.Tables(0)))
                .DataSources.Add(New ReportDataSource("dsAHA2016_Claims_DX", ds.Tables(1)))
                .DataSources.Add(New ReportDataSource("dsAHA2016_Claims_PressureSore", ds.Tables(3)))


                'Dim TextColorReport As New ReportParameter()
                'TextColorReport.Name = "InputTextColor"


                'If changeColor Then
                '    TextColorReport.Values.Add(True)
                'Else
                '    TextColorReport.Values.Add(False)
                'End If

                'Dim parameters() As ReportParameter = {TextColorReport}
                '.SetParameters(parameters)



                .Refresh()

                Dim format As String = ""
                Dim deviceInfo As String = String.Empty
                Dim mimeType As String = ""
                Dim encoding As String = String.Empty
                Dim extension As String = "pdf"
                Dim streamIDs() As String = Nothing
                Dim warnings() As Warning = Nothing

                Select Case UCase(exportFormat)
                    Case UCase("tiff")
                        format = "IMAGE"
                        mimeType = "image/tiff"
                    Case Else
                        format = "PDF"
                        mimeType = "application/pdf"
                End Select

                bytes = .Render(format, deviceInfo, mimeType, encoding, extension, streamIDs, warnings)

            End With

        Catch ex As Exception

            Dim requestXML As String = SerializeObject(ahaItem)

            Dim mp As New StringBuilder

            Try
                mp.AppendLine(String.Format("ClaimID = {0}", ahaItem.ID))

                If ahaItem.FormHeader.MemberID.Value IsNot Nothing Then mp.AppendLine(String.Format("MemberID = {0}", ahaItem.FormHeader.MemberID.Value))
                If ahaItem.FormHeader.BillingNPI.Value IsNot Nothing Then mp.AppendLine(String.Format("BillingNPI = {0}", ahaItem.FormHeader.BillingNPI.Value))
                If ahaItem.FormHeader.RenderingNPI.Value IsNot Nothing Then mp.AppendLine(String.Format("RenderingNPI = {0}", ahaItem.FormHeader.RenderingNPI.Value))

                mp.AppendLine("RequestXML...")
                mp.AppendLine(requestXML)

            Catch 'ex As Exception
            End Try

            Globals.LogError(0, MethodBase.GetCurrentMethod.DeclaringType.Name, MethodBase.GetCurrentMethod.Name, mp.ToString, ex.Message, ex.StackTrace)
        End Try

        Return bytes

    End Function

