                        End If

                    Case 2024
                        If ahaForm.FormHeader.ClaimClassTag.Value = 4 Then
                            Dim ahaFormShort As New AHAFormItemShort
                            ahaFormShort = GetAHAShort(claimId)
                            response.ReportBytes = GetAHAReport2024(ahaFormShort, exportFormat, hasAddendum, changeColor)
                        Else
                            response.ReportBytes = GetAHAReport2024(ahaForm, exportFormat, hasAddendum, changeColor)
                        End If
                    Case 2023
                        If ahaForm.FormHeader.ClaimClassTag.Value = 4 Then
                            Dim ahaFormShort As New AHAFormItemShort
                            ahaFormShort = GetAHAShort(claimId)
                            response.ReportBytes = GetAHAReport2023(ahaFormShort, exportFormat, hasAddendum, changeColor)
                        Else
                            response.ReportBytes = GetAHAReport2023(ahaForm, exportFormat, hasAddendum, changeColor)
                        End If
                    Case 2022
                        If ahaForm.FormHeader.ClaimClassTag.Value = 4 Then
                            Dim ahaFormShort As New AHAFormItemShort
                            ahaFormShort = GetAHAShort(claimId)
                            response.ReportBytes = GetAHAReport2022(ahaFormShort, exportFormat, hasAddendum, changeColor)
                        Else
                            response.ReportBytes = GetAHAReport2022(ahaForm, exportFormat, hasAddendum, changeColor)
                        End If
                    Case 2021

                        If ahaForm.FormHeader.ClaimClassTag.Value = 4 Then
                            Dim ahaFormShort As New AHAFormItemShort
                            ahaFormShort = GetAHAShort(claimId)
                            response.ReportBytes = GetAHAReport2021(ahaFormShort, exportFormat, hasAddendum, changeColor)
                        Else
                            response.ReportBytes = GetAHAReport2021(ahaForm, exportFormat, hasAddendum, changeColor)
