    Public Function GetAHAAndAtHomeSummary(claimClass As Short, claimClassTag As Short?, criteria As SearchCriteria) As List(Of SummaryCount) Implements IAHAService12.GetAHAAndAtHomeSummary
        Dim dbo As New SqlDataObject(ConnectionStrings(AppSettings("DBClaimAttach").ToString).ConnectionString, True)
        Dim resp As New List(Of SummaryCount)
        Dim pkey As Integer = 0
        Try
            Using cmd As SqlCommand = New SqlCommand()

                'billingNPI.Add("1681098699") 'ATHome Billing NPI

                cmd.CommandType = CommandType.StoredProcedure
                cmd.CommandText = "usp_GetAHAAndAtHomeSummary"
                cmd.CommandTimeout = 120

                With cmd.Parameters
                    .AddWithValue("@ClaimClass", claimClass)
                    .AddWithValue("@ClaimClassTag", claimClassTag)
                    .AddWithValue("@groupID", criteria.PayerID)
                    .AddWithValue("@DateFrom", criteria.DateFrom)
                    .AddWithValue("@DateTo", criteria.DateTo)
                End With

                Dim renderingList = New SqlParameter("@RenderingNPI", SqlDbType.Structured)
                renderingList.Value = New DataTable()
                Dim drRendering
                renderingList.Value.Columns.Add("NPI")
                For Each r In criteria.RenderingNPIList
                    drRendering = renderingList.Value.NewRow()
                    drRendering("NPI") = r.Trim
                    renderingList.Value.Rows.Add(drRendering)
                Next
                cmd.Parameters.Add(renderingList)

                Dim billingList = New SqlParameter("@BillingNPI", SqlDbType.Structured)
                billingList.Value = New DataTable()
                Dim drBilling
                billingList.Value.Columns.Add("NPI")
                For Each r In criteria.BillingNPIList
                    drBilling = billingList.Value.NewRow()
                    drBilling("NPI") = r.Trim
                    billingList.Value.Rows.Add(drBilling)
                Next
                cmd.Parameters.Add(billingList)

                Using sdr As SqlDataReader = _DBO.GetReader(cmd, CommandBehavior.Default)
                    If sdr.HasRows Then
                        While sdr.Read()
                            resp.Add(New SummaryCount() With {
                                .iStatus = CChar(sdr("iStatus")),
                                .nClaimClass = CShort(sdr("nClaimClass")),
                                .AtHome = CBool(sdr("AtHome")),
                                .PayerID = sdr("PayerID").ToString,
                                .Amount = CShort(If(IsNothing(sdr("Amount")), 0, sdr("Amount"))),
                                .FormType = sdr("FormType").ToString
                            })
                        End While
                    End If
                End Using
            End Using
        Catch ex As Exception
            SaveError("0", ex.Message, ex.StackTrace, Nothing, "-1", MethodBase.GetCurrentMethod().DeclaringType.Name)
        End Try
        Return resp
    End Function


