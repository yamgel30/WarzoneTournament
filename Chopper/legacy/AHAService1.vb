    Public Function ResubmitAHA(ByVal accountID As String, ByVal loginToken As String, ByVal sourceIP As String, ByVal ahaForm As AHAFormItem) As AHASubmissionResponse Implements IAHAService12.ResubmitAHA

        Dim debugOn As Boolean = False
        Dim requestXML As String = String.Empty
        Dim errorMessage As String = String.Empty
        If AppSettings("DebugOn") IsNot Nothing AndAlso Boolean.Parse(AppSettings("DebugOn")) Then
            debugOn = True
            requestXML = SerializeObject(ahaForm)
        End If

        Dim response As New AHASubmissionResponse

