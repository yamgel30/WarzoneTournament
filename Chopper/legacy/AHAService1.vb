            Dim rptSubReportNameID As String = ""

            rptViewer.Reset()

            Dim iAge As Long = DateDiff(DateInterval.Year, CType(ahaItem.FormHeader.MemberDOB.Value, Date), CType(ahaItem.FormHeader.DateOfVisit.Value, Date)) -
                                        If(DateAdd(DateInterval.Year, DateDiff(DateInterval.Year, CType(ahaItem.FormHeader.MemberDOB.Value, Date), CType(ahaItem.FormHeader.DateOfVisit.Value, Date)), CType(ahaItem.FormHeader.MemberDOB.Value, Date)) > CType(ahaItem.FormHeader.DateOfVisit.Value, Date), 1, 0)

            With rptViewer.LocalReport
                .DataSources.Clear()

                Dim reportName As String
                reportName = ""

                If _isGHP Then
                    _isPed = iAge < 21

                    If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                        If _isPed Then
                            reportName = $".GHP{rptYear}_Ped_ENG.rdlc"
                        Else
                            reportName = $".GHP{rptYear}_ENG.rdlc"
                        End If
                    Else
                        If _isPed Then
                            reportName = $".GHP{rptYear}_Ped.rdlc"
                        Else
                            reportName = $".GHP{rptYear}.rdlc"
                        End If
                    End If
                ElseIf _isAhaFL Then
                    'Same goes for the others but in the future can descriminate.
                    If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                        reportName = $".AHAFL{rptYear}_ENG.rdlc"
                    Else
                        reportName = $".AHAFL{rptYear}.rdlc"
                    End If
                ElseIf _isAhaPR Then
                    If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                        reportName = $".AHA{rptYear}_ENG.rdlc"
                    Else
                        reportName = $".AHA{rptYear}.rdlc"
                    End If
                Else
                    If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                        reportName = $".AHA{rptYear}_ENG.rdlc"
                    Else
                        reportName = $".AHA{rptYear}.rdlc"
                    End If
                End If

                hasAddendum = AHAHasAddendum(ahaItem.ID)

                If ahaItem.FormHeader.Status.Value = 4 And hasAddendum Then
                    reportName = $".AHA{rptYear}_WithAddendumAndDx.rdlc"

                    .DataSources.Add(New ReportDataSource("dsAHAClaims_AcceptedDx", GetDxList(ahaItem.ID)))

                    Dim dsAddendum As DataSet = GetAddendumReport(Convert.ToInt32(ahaItem.ID))

                    .DataSources.Add(New ReportDataSource("Addendum", dsAddendum.Tables(0)))
                    .DataSources.Add(New ReportDataSource("Claims", dsAddendum.Tables(1)))
                    .DataSources.Add(New ReportDataSource("AddendumRejectCodes", dsAddendum.Tables(2)))

                    AddHandler .SubreportProcessing, AddressOf SubReportEventHandler
                ElseIf ahaItem.FormHeader.Status.Value = 4 AndAlso Not hasAddendum Then
                    _isDX = True

                    If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                        rptSubReport = reportName
                        reportName = $".AHA{rptYear}_WithDx_ENG.rdlc"
                        rptSubReportNameID = $"AHA{rptYear}_ENG"
                    Else
                        rptSubReport = reportName
                        reportName = $".AHA{rptYear}_WithDx.rdlc"
                        rptSubReportNameID = $"AHA{rptYear}"
                    End If

                    ' ajuste temporero
                    hasSubReport = True
                    .DataSources.Add(New ReportDataSource("dsAHAClaims_AcceptedDx", GetDxList(ahaItem.ID)))
                    AddHandler .SubreportProcessing, AddressOf SubReportEventHandler
                ElseIf hasAddendum Then
                    If addendumFirst Then
                        reportName = $".AddendumWithAHA{rptYear}.rdlc"
                    End If

                    Dim dsAddendum As DataSet = GetAddendumReport(Convert.ToInt32(ahaItem.ID))

                    .DataSources.Add(New ReportDataSource("Addendum", dsAddendum.Tables(0)))
                    .DataSources.Add(New ReportDataSource("Claims", dsAddendum.Tables(1)))
                    .DataSources.Add(New ReportDataSource("AddendumRejectCodes", dsAddendum.Tables(2)))

                    AddHandler .SubreportProcessing, AddressOf SubReportEventHandler

                End If

                Dim asm As Assembly = Assembly.GetAssembly(Me.GetType())

                If (hasSubReport) Then
                    .LoadReportDefinition(asm.GetManifestResourceStream(Assembly.GetExecutingAssembly.GetName.Name & reportName))
                    .LoadSubreportDefinition(rptSubReportNameID, asm.GetManifestResourceStream("AHAController" + rptSubReport))
                Else
                    .ReportEmbeddedResource = Assembly.GetExecutingAssembly.GetName.Name & reportName
                End If
                If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                    .LoadSubreportDefinition($"AHA{rptYear}_MalnutritionCriteria_ENG", asm.GetManifestResourceStream("AHAController" + $".AHA{rptYear}_MalnutritionCriteria_ENG.rdlc"))
                    If _isGHP Then
                        .LoadSubreportDefinition($"AHA{rptYear}_SocialDeterminants_ENG", asm.GetManifestResourceStream("AHAController" + $".AHA{rptYear}_SocialDeterminants_ENG.rdlc"))
                    Else
                        .LoadSubreportDefinition($"AHA{rptYear}_SocialDeterminants_ENG", asm.GetManifestResourceStream("AHAController" + $".AHA{rptYear}_SocialDeterminants_ENG.rdlc"))
                    End If
                    .LoadSubreportDefinition($"AHA{rptYear}_ScreeningSubstanceUse_ENG", asm.GetManifestResourceStream("AHAController" + $".AHA{rptYear}_ScreeningSubstanceUse_ENG.rdlc"))
                    If iAge >= 11 AndAlso iAge <= 20 AndAlso _isGHP Then
                        .LoadSubreportDefinition($"AHA{rptYear}_PHQ9_ENG", asm.GetManifestResourceStream("AHAController" + $".AHA{rptYear}_PHQA_ENG.rdlc"))
                    Else
                        .LoadSubreportDefinition($"AHA{rptYear}_PHQ9_ENG", asm.GetManifestResourceStream("AHAController" + $".AHA{rptYear}_PHQ9_ENG.rdlc"))
                    End If
                Else
                    .LoadSubreportDefinition($"AHA{rptYear}_MalnutritionCriteria", asm.GetManifestResourceStream("AHAController" + $".AHA{rptYear}_MalnutritionCriteria.rdlc"))
                    If _isGHP Then
                        .LoadSubreportDefinition($"AHA{rptYear}_SocialDeterminants", asm.GetManifestResourceStream("AHAController" + $".AHA{rptYear}_SocialDeterminants.rdlc"))
                    Else
                        .LoadSubreportDefinition($"AHA{rptYear}_SocialDeterminants", asm.GetManifestResourceStream("AHAController" + $".AHA{rptYear}_SocialDeterminants.rdlc"))
                    End If
                    .LoadSubreportDefinition($"AHA{rptYear}_ScreeningSubstanceUse", asm.GetManifestResourceStream("AHAController" + $".AHA{rptYear}_ScreeningSubstanceUse.rdlc"))
                    If iAge >= 11 AndAlso iAge <= 20 AndAlso _isGHP Then
                        .LoadSubreportDefinition($"AHA{rptYear}_PHQ9", asm.GetManifestResourceStream("AHAController" + $".AHA{rptYear}_PHQA.rdlc"))
                    Else
                        .LoadSubreportDefinition($"AHA{rptYear}_PHQ9", asm.GetManifestResourceStream("AHAController" + $".AHA{rptYear}_PHQ9.rdlc")) ' Assembly.GetExecutingAssembly().GetName().Name
                    End If
                End If

                .DataSources.Add(New ReportDataSource($"dsAHA{rptYear}_Claims_AHADetail", ds.Tables("Claims_AHADetail")))
                .DataSources.Add(New ReportDataSource($"dsAHA{rptYear}_Claims", ds.Tables("Claims")))
                .DataSources.Add(New ReportDataSource($"dsAHA{rptYear}_Claims_DX", ds.Tables("Claims_DX")))
                .DataSources.Add(New ReportDataSource($"dsAHA{rptYear}_Claims_PressureSore", ds.Tables("Claims_PressureSores")))
                .DataSources.Add(New ReportDataSource($"dsAHA{rptYear}_Claims_DiseasesOfTheSkin", ds.Tables("Claims_DiseasesOfTheSkin")))
                .DataSources.Add(New ReportDataSource($"dsAHA{rptYear}_Claims_MalnutritionCriteria", ds.Tables("Claims_MalnutritionCriteria")))
                .DataSources.Add(New ReportDataSource($"dsAHA{rptYear}_ScreeningSubstanceUse", ds.Tables("Claims_ScreeningSubstanceUse")))

                ' New 2023
                If _isGHP Then
                    .DataSources.Add(New ReportDataSource($"dsAHA{rptYear}_Claims_SocialDeterminants", ds.Tables("Claims_SocialDeterminants")))
                End If
                .DataSources.Add(New ReportDataSource($"dsAHA{rptYear}_Claims_SocialDeterminants{rptYear}", ds.Tables($"Claims_SocialDeterminants2023")))

                'If PHQ9 is not rendered skip this line!!!
                RemoveHandler .SubreportProcessing, AddressOf SubReportEventHandler
                AddHandler .SubreportProcessing, AddressOf SubReportEventHandler

                Dim isEmptyAHA As New ReportParameter
                Dim TextColorReport As New ReportParameter()
                Dim isFlorida As New ReportParameter
                Dim biClaimIDSub As New ReportParameter
                Dim isPed As New ReportParameter
                Dim isGHP As New ReportParameter
                Dim isTHA As New ReportParameter

                isFlorida.Name = "isFlorida"
                isFlorida.Values.Add(_isAhaFL)

                TextColorReport.Name = "InputTextColor"
                If changeColor Then
                    TextColorReport.Values.Add(True)
                Else
                    TextColorReport.Values.Add(False)
                End If

                isEmptyAHA.Name = "IsEmptyAHA"
                isEmptyAHA.Values.Add(False)

                biClaimIDSub.Name = "biClaimIDSub"
                biClaimIDSub.Values.Add(ahaItem.ID)

                isPed.Name = "isPED"
                isPed.Values.Add(_isPed)

                isGHP.Name = "isGHP"
                isGHP.Values.Add(_isGHP)

                isTHA.Name = "isTHA"
                isTHA.Values.Add(False)

                Dim parameters() As ReportParameter

                If _isDX Then
                    parameters = {TextColorReport, isEmptyAHA, isFlorida, biClaimIDSub, isTHA, isGHP, isPed}
                Else
                    parameters = {TextColorReport, isEmptyAHA, isFlorida, biClaimIDSub}
                End If

                Dim parametersList As New List(Of ReportParameter)()

                parametersList.AddRange(parameters)

                If UCase(exportFormat) = "PDF/NO" Then
                    parametersList.Add(New ReportParameter("printAppends", False))
                    exportFormat = "PDF"
                End If

                .SetParameters(parametersList.ToArray())
                .Refresh()

                Dim format As String = ""
                Dim deviceInfo As String = String.Empty
                Dim mimeType As String = ""
                Dim encoding As String = String.Empty
                Dim extension As String = "pdf"
                Dim streamIDs() As String = Nothing
                Dim warnings() As Warning = Nothing

                Select Case UCase(exportFormat)
                    Case UCase("tiff")
                        format = "IMAGE"
                        mimeType = "image/tiff"
                    Case Else
                        format = "PDF"
                        mimeType = "application/pdf"
                End Select

                bytes = .Render(format, deviceInfo, mimeType, encoding, extension, streamIDs, warnings)

                Dim s() As Warning = warnings
            End With

            ds.Dispose()
        Catch ex As Exception
            Dim requestXML As String

            requestXML = SerializeObject(ahaItem)

            Dim mp As New StringBuilder

            Try
                mp.AppendLine(String.Format("ClaimID = {0}", ahaItem.ID))

                If ahaItem.FormHeader.MemberID.Value IsNot Nothing Then mp.AppendLine(String.Format("MemberID = {0}", ahaItem.FormHeader.MemberID.Value))
                If ahaItem.FormHeader.BillingNPI.Value IsNot Nothing Then mp.AppendLine(String.Format("BillingNPI = {0}", ahaItem.FormHeader.BillingNPI.Value))
                If ahaItem.FormHeader.RenderingNPI.Value IsNot Nothing Then mp.AppendLine(String.Format("RenderingNPI = {0}", ahaItem.FormHeader.RenderingNPI.Value))

                mp.AppendLine("RequestXML...")
                mp.AppendLine(requestXML)

            Catch 'ex As Exception
            End Try

            Globals.LogError(ahaItem.SessionID, MethodBase.GetCurrentMethod.DeclaringType.Name, MethodBase.GetCurrentMethod.Name, mp.ToString, String.Format("Message: {0} InnerException: {1}", ex.Message, ex.InnerException), ex.StackTrace, sMemberID, sRenderingNPI)

            Throw
        End Try

        Return bytes
    End Function
    Private Function GetAHAReport2026(ByVal ahaItem As AHAFormItemShort, ByVal exportFormat As String, ByVal hasAddendum As Boolean, ByVal changeColor As Boolean, Optional ByVal addendumFirst As Boolean = False) As Byte()
        'Define year for reportingName
        Const rptYear As String = "2026"

        Dim rptViewer As New ReportViewer
        Dim bytes() As Byte = Nothing

        'get type of payer
        Dim payers As Dictionary(Of String, Boolean) = Globals.ValidatePayerID(ahaItem)
        Dim _isGHP As Boolean = payers.Item("isGHP")
        Dim _isAhaFL As Boolean = payers.Item("isAhaFL")
        Dim _isAhaPR As Boolean = payers.Item("isAhaPR")
        Dim _isDX As Boolean = False
        Dim iAge As Double = (TimeSpan.FromTicks(DateTime.Now.Ticks - ahaItem.FormHeader.MemberDOB.Value.Value.Ticks).TotalDays / 365.25)
        Dim _isPed As Boolean = iAge < 21
        Dim sMemberID As String = String.Empty
        Dim sRenderingNPI As String = String.Empty

        If Not (IsNothing(ahaItem)) Then
            If Not IsNothing(ahaItem.FormHeader) Then
                If Not IsNothing(ahaItem.FormHeader.MemberID) Then
                    If Not IsNothing(ahaItem.FormHeader.MemberID.Value) Then
                        sMemberID = ahaItem.FormHeader.MemberID.Value
                    End If
                End If

                If Not IsNothing(ahaItem.FormHeader.RenderingNPI) Then
                    If Not IsNothing(ahaItem.FormHeader.RenderingNPI.Value) Then
                        sRenderingNPI = ahaItem.FormHeader.RenderingNPI.Value
                    End If
                End If
            End If
        End If

        Try
            Dim ahahelp As New AHAReportHelper2026(ahaItem)
            Dim ds As DataSet = ahahelp.ConvertToDatasetShort()
            Dim rptSubReport As String = ""
            Dim hasSubReport As Boolean = False
            Dim rptSubReportNameID As String = ""

            rptViewer.Reset()

            With rptViewer.LocalReport
                .DataSources.Clear()

                Dim reportName As String
                reportName = ""

                If _isGHP Then
                    If _isPed Then
                        If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                            reportName = $".GHP{rptYear}_Ped_ENG_THA.rdlc"
                        Else
                            reportName = $".GHP{rptYear}_Ped_THA.rdlc"
                        End If
                    Else
                        If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                            reportName = $".GHP{rptYear}_ENG_THA.rdlc"
                        Else
                            reportName = $".GHP{rptYear}_THA.rdlc"
                        End If
                    End If
                ElseIf _isAhaFL Or _isAhaPR Then
                    If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                        reportName = $".AHA{rptYear}Short_ENG.rdlc"
                    Else
                        reportName = $".AHA{rptYear}Short.rdlc"
                    End If
                End If

                hasAddendum = AHAHasAddendum(ahaItem.ID)

                If ahaItem.FormHeader.Status.Value = 4 And hasAddendum Then
                    reportName = $".AHA{rptYear}_WithAddendumAndDx.rdlc"

                    .DataSources.Add(New ReportDataSource("dsAHAClaims_AcceptedDx", GetDxList(ahaItem.ID)))

                    Dim dsAddendum As DataSet = GetAddendumReport(Convert.ToInt32(ahaItem.ID))

                    .DataSources.Add(New ReportDataSource("Addendum", dsAddendum.Tables(0)))
                    .DataSources.Add(New ReportDataSource("Claims", dsAddendum.Tables(1)))
                    .DataSources.Add(New ReportDataSource("AddendumRejectCodes", dsAddendum.Tables(2)))

                    AddHandler .SubreportProcessing, AddressOf SubReportEventHandler
                ElseIf ahaItem.FormHeader.Status.Value = 4 AndAlso Not hasAddendum Then
                    _isDX = True

                    ' ajuste temporero
                    If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                        reportName = $".AHA{rptYear}Short_ENG.rdlc"
                    Else
                        reportName = $".AHA{rptYear}Short.rdlc"
                    End If

                    hasSubReport = False

                    .DataSources.Add(New ReportDataSource("dsAHAClaims_AcceptedDx", GetDxList(ahaItem.ID)))

                    AddHandler .SubreportProcessing, AddressOf SubReportEventHandler
                ElseIf hasAddendum Then
                    If addendumFirst Then
                        reportName = $".AddendumWithAHA{rptYear}.rdlc"
                    Else
                        If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                            reportName = $".AHA{rptYear}Short_ENG.rdlc"
                        Else
                            reportName = $".AHA{rptYear}Short.rdlc"
                        End If
                    End If

                    Dim dsAddendum As DataSet = GetAddendumReport(Convert.ToInt32(ahaItem.ID))

                    .DataSources.Add(New ReportDataSource("Addendum", dsAddendum.Tables(0)))
                    .DataSources.Add(New ReportDataSource("Claims", dsAddendum.Tables(1)))
                    .DataSources.Add(New ReportDataSource("AddendumRejectCodes", dsAddendum.Tables(2)))

                    AddHandler .SubreportProcessing, AddressOf SubReportEventHandler
                End If

                Dim asm As Assembly = Assembly.GetAssembly(Me.GetType())

                If (hasSubReport) Then
                    .LoadReportDefinition(asm.GetManifestResourceStream(Assembly.GetExecutingAssembly.GetName.Name & reportName))
                    .LoadSubreportDefinition(rptSubReportNameID, asm.GetManifestResourceStream("AHAController" + rptSubReport))
                Else
                    .ReportEmbeddedResource = Assembly.GetExecutingAssembly.GetName.Name & reportName
                End If

                If ahaItem.Language IsNot Nothing AndAlso ahaItem.Language.ToUpper() = "EN" Then
                    .LoadSubreportDefinition($"AHA{rptYear}_MalnutritionCriteria_ENG", asm.GetManifestResourceStream("AHAController" + $".AHA{rptYear}_MalnutritionCriteria_ENG.rdlc"))
                    .LoadSubreportDefinition($"AHA{rptYear}_SocialDeterminants_ENG", asm.GetManifestResourceStream("AHAController" + $".AHA{rptYear}_SocialDeterminants_ENG.rdlc"))
                    .LoadSubreportDefinition($"AHA{rptYear}_ScreeningSubstanceUse_ENG", asm.GetManifestResourceStream("AHAController" + $".AHA{rptYear}_ScreeningSubstanceUse_ENG.rdlc"))

                    If iAge >= 11 AndAlso iAge <= 20 AndAlso _isGHP Then
                        .LoadSubreportDefinition($"AHA{rptYear}_PHQ9_ENG", asm.GetManifestResourceStream("AHAController" + $".AHA{rptYear}_PHQA_ENG.rdlc"))
                    Else
                        .LoadSubreportDefinition($"AHA{rptYear}_PHQ9_ENG", asm.GetManifestResourceStream("AHAController" + $".AHA{rptYear}_PHQ9_ENG.rdlc"))
                    End If
                Else
                    .LoadSubreportDefinition($"AHA{rptYear}_MalnutritionCriteria", asm.GetManifestResourceStream("AHAController" + $".AHA{rptYear}_MalnutritionCriteria.rdlc"))
                    .LoadSubreportDefinition($"AHA{rptYear}_SocialDeterminants", asm.GetManifestResourceStream("AHAController" + $".AHA{rptYear}_SocialDeterminants.rdlc"))
                    .LoadSubreportDefinition($"AHA{rptYear}_ScreeningSubstanceUse", asm.GetManifestResourceStream("AHAController" + $".AHA{rptYear}_ScreeningSubstanceUse.rdlc"))

                    If iAge >= 11 AndAlso iAge <= 20 AndAlso _isGHP Then
                        .LoadSubreportDefinition($"AHA{rptYear}_PHQ9_ENG", asm.GetManifestResourceStream("AHAController" + $".AHA{rptYear}_PHQA_ENG.rdlc"))
                    Else
                        .LoadSubreportDefinition($"AHA{rptYear}_PHQ9", asm.GetManifestResourceStream("AHAController" + $".AHA{rptYear}_PHQ9.rdlc"))
                    End If
                End If

                .DataSources.Add(New ReportDataSource($"dsAHA{rptYear}_Claims_AHADetail", ds.Tables("Claims_AHADetail")))
                .DataSources.Add(New ReportDataSource($"dsAHA{rptYear}_Claims", ds.Tables("Claims")))
                .DataSources.Add(New ReportDataSource($"dsAHA{rptYear}_Claims_DX", ds.Tables("Claims_DX")))
                .DataSources.Add(New ReportDataSource($"dsAHA{rptYear}_Claims_PressureSore", ds.Tables("Claims_PressureSores")))
                .DataSources.Add(New ReportDataSource($"dsAHA{rptYear}_Claims_DiseasesOfTheSkin", ds.Tables("Claims_DiseasesOfTheSkin")))
                .DataSources.Add(New ReportDataSource($"dsAHA{rptYear}_Claims_AHADetail_Short", ds.Tables("Claims_AHADetail_Short")))
                .DataSources.Add(New ReportDataSource($"dsAHA{rptYear}_Claims_MalnutritionCriteria", ds.Tables("Claims_MalnutritionCriteria")))

                If _isGHP Then
                    .DataSources.Add(New ReportDataSource($"dsAHA{rptYear}_Claims_SocialDeterminants", ds.Tables("Claims_SocialDeterminants")))
                Else
                    .DataSources.Add(New ReportDataSource($"dsAHA{rptYear}_Claims_SocialDeterminants{rptYear}", ds.Tables("Claims_SocialDeterminants2023")))
                End If

                .DataSources.Add(New ReportDataSource($"dsAHA{rptYear}_ScreeningSubstanceUse", ds.Tables("Claims_ScreeningSubstanceUse")))

                AddHandler .SubreportProcessing, AddressOf SubReportEventHandler

                Dim isEmptyAHA As New ReportParameter
                Dim TextColorReport As New ReportParameter()
                Dim isFlorida As New ReportParameter
                Dim biClaimIDSub As New ReportParameter
                Dim isPed As New ReportParameter
                Dim isGHP As New ReportParameter
                Dim isTHA As New ReportParameter

                isFlorida.Name = "isFlorida"
                isFlorida.Values.Add(_isAhaFL)

                isPed.Name = "isPED"
                isPed.Values.Add(False)

                isGHP.Name = "isGHP"
                isGHP.Values.Add(False)

                isTHA.Name = "isTHA"
                isTHA.Values.Add(True)

                TextColorReport.Name = "InputTextColor"
                If changeColor Then
                    TextColorReport.Values.Add(True)
                Else
                    TextColorReport.Values.Add(False)
                End If

                isEmptyAHA.Name = "IsEmptyAHA"
                isEmptyAHA.Values.Add(False)

                biClaimIDSub.Name = "biClaimIDSub"
                biClaimIDSub.Values.Add(ahaItem.ID)

                Dim parameters() As ReportParameter

                parameters = {TextColorReport, isEmptyAHA, isFlorida, biClaimIDSub}

                Dim parametersList = New List(Of ReportParameter)()

                parametersList.AddRange(parameters)

                If UCase(exportFormat) = "PDF/NO" Then
                    parametersList.Add(New ReportParameter("printAppends", False))
                    exportFormat = "PDF"
                End If

                .SetParameters(parametersList.ToArray())

                .Refresh()

                Dim format As String = ""
                Dim deviceInfo As String = String.Empty
                Dim mimeType As String = ""
                Dim encoding As String = String.Empty
                Dim extension As String = "pdf"
                Dim streamIDs() As String = Nothing
                Dim warnings() As Warning = Nothing

                Select Case UCase(exportFormat)
                    Case UCase("tiff")
                        format = "IMAGE"
                        mimeType = "image/tiff"
                    Case Else
                        format = "PDF"
                        mimeType = "application/pdf"
                End Select

                bytes = .Render(format, deviceInfo, mimeType, encoding, extension, streamIDs, warnings)
            End With

            ds.Dispose()
        Catch ex As Exception
            Dim requestXML As String

            requestXML = SerializeObject(ahaItem)

            Dim mp As New StringBuilder

            Try
                mp.AppendLine(String.Format("ClaimID = {0}", ahaItem.ID))

                If ahaItem.FormHeader.MemberID.Value IsNot Nothing Then mp.AppendLine(String.Format("MemberID = {0}", ahaItem.FormHeader.MemberID.Value))
                If ahaItem.FormHeader.BillingNPI.Value IsNot Nothing Then mp.AppendLine(String.Format("BillingNPI = {0}", ahaItem.FormHeader.BillingNPI.Value))
                If ahaItem.FormHeader.RenderingNPI.Value IsNot Nothing Then mp.AppendLine(String.Format("RenderingNPI = {0}", ahaItem.FormHeader.RenderingNPI.Value))

                mp.AppendLine("RequestXML...")
                mp.AppendLine(requestXML)
            Catch
            End Try

            Globals.LogError(ahaItem.SessionID, MethodBase.GetCurrentMethod.DeclaringType.Name, MethodBase.GetCurrentMethod.Name, mp.ToString, ex.Message, ex.StackTrace, sMemberID, sRenderingNPI)

            Throw
        End Try

        Return bytes
    End Function


    Private Function AHAHasAddendum(ByVal claimID As Long) As Boolean

        Dim has As Boolean = False
        Dim _DBO As New SqlDataObject(ConnectionStrings(AppSettings("DBClaimAttach").ToString).ConnectionString, True)
        Dim cmd As New SqlCommand

        cmd.CommandTimeout = 60 * 5
        cmd.CommandType = CommandType.Text
        cmd.CommandText = "SELECT HasAddendum FROM Claims (NOLOCK) WHERE biClaimID = @ClaimID AND HasAddendum = 1"

        With cmd.Parameters
            .AddWithValue("@ClaimID", claimID)
        End With

        Dim dr As SqlDataReader = _DBO.GetReader(cmd, CommandBehavior.Default)

        Try
            If dr.HasRows AndAlso dr.Read() Then
                has = True
            Else
                has = False
            End If

            dr.Close()

        Catch ex As Exception
            Globals.LogError(0, MethodBase.GetCurrentMethod.DeclaringType.Name, MethodBase.GetCurrentMethod.Name, String.Format("ClaimID = {0}", claimID), ex.Message, ex.StackTrace)
            has = False
        Finally
            cmd.Dispose()
        End Try

        Return has

    End Function

    Private Function GetDxList(ByVal claimId As Long) As List(Of DiagnosisItem)

        Dim dxListResponse As GetClaimDxListResponse = GetClaimDiagnosticList(claimId)
        Dim claimDxList As New List(Of DiagnosisItem)

        If dxListResponse.ErrorNumber = 0 Then
            claimDxList = dxListResponse.DiagnosticList
        End If

        Return claimDxList

    End Function

    Public Function GetAddendumReport(ByVal claimID As Integer) As DataSet

        Dim dbo As New SqlDataObject(ConnectionStrings(AppSettings("DBClaimAttach").ToString).ConnectionString, True)

        Dim sqlCMD As New SqlCommand

        Dim Adden As dsAddendum = New dsAddendum()
        Dim addendumItem As New Addendum
        Dim ad As dsAddendum.AddendumRow = Adden.Addendum.NewAddendumRow()

        Dim adClaim As dsAddendum.ClaimsRow = Adden.Claims.NewClaimsRow()

        sqlCMD.CommandType = CommandType.StoredProcedure
        sqlCMD.CommandText = "uspGetAddendumReportDt_ByClaim"

        sqlCMD.Parameters.AddWithValue("@claimID", claimID)

        Using dataReader As SqlDataReader = dbo.GetReader(sqlCMD, CommandBehavior.Default)

            If dataReader.HasRows AndAlso dataReader.Read Then
                With ad
                    .bTratamiento = CBool(dataReader("bTratamiento"))
                    .bResultado = CBool(dataReader("bResultado"))
                    .bComorbilidades = CBool(dataReader("bComorbilidades"))
                    .bDocumentacion = CBool(dataReader("bDocumentacion"))
                    .bOtro1 = CBool(dataReader("bOtro1"))
                    .bClarificar = CBool(dataReader("bClarificar"))
                    .bCorregir = CBool(dataReader("bCorregir"))
                    .bAnadir = CBool(dataReader("bAnadir"))
                    .bOtro2 = CBool(dataReader("bOtro2"))
                    .sOtroRazon = dataReader("sOtroRazon").ToString
                    .sProvClarificacion = dataReader("sProvClarificacion").ToString
                    .dProvAccepted = CDate(dataReader("dProvAccepted"))
                End With
                Adden.Addendum.AddAddendumRow(ad)
            Else
                With ad
                    .bTratamiento = False
                    .bResultado = False
                    .bComorbilidades = False
                    .bDocumentacion = False
                    .bOtro1 = False
                    .bClarificar = False
                    .bCorregir = False
                    .bAnadir = False
                    .bOtro2 = False
                    .sOtroRazon = ""
                    .sProvClarificacion = ""
                    '.dProvAccepted = Date.Now()
                End With
                Adden.Addendum.AddAddendumRow(ad)
            End If

            dataReader.NextResult()

            If dataReader.HasRows AndAlso dataReader.Read Then
                With adClaim
                    .sUserID = dataReader("sUserID").ToString
                    .dApproved = CDate(dataReader("dApproved"))
                    .PatientName = dataReader("PatientName").ToString
                    .dDos = CDate(dataReader("dDos"))
                    .dSubmitter = CDate(dataReader("dSubmitter"))
                    .sAuditorNotes = dataReader("sAuditorNotes").ToString
                    .ProviderName = dataReader("ProviderName").ToString
                End With
                Adden.Claims.AddClaimsRow(adClaim)
            Else
                With adClaim
                    .sUserID = ""
                    '.dApproved = Date.Now
                    .PatientName = ""
                    '.dDos = Date.Now
                    '.dSubmitter = Date.Now
                    .sAuditorNotes = ""
                    .ProviderName = ""
                End With
                Adden.Claims.AddClaimsRow(adClaim)
            End If

            dataReader.NextResult()

            addendumItem.AddendumRejectNotes = New List(Of AddendumRejectedNotes)

            If dataReader.HasRows Then

                While dataReader.Read
                    Dim adrej As dsAddendum.AddendumRejectCodesRow = Adden.AddendumRejectCodes.NewAddendumRejectCodesRow()
                    With adrej
                        .biAddendumRejectCodes = dataReader("biAddendumRejectCodes").ToString
                        .sRejectCode = dataReader("sRejectCode").ToString
                        .RejectedNote = dataReader("RejectedNote").ToString
                        If Not IsDBNull(dataReader("Page")) Then .Page = CInt(dataReader("Page")) Else .Page = 1
                        .Clinica = CBool(dataReader("Clinica"))
                        .Otro = CBool(dataReader("Otro"))
                        .OtroRazon = dataReader("OtroRazon").ToString
                    End With
                    Adden.AddendumRejectCodes.AddAddendumRejectCodesRow(adrej)
                End While
            Else
                For x = 0 To 0 Step 1
                    Dim adrej As dsAddendum.AddendumRejectCodesRow = Adden.AddendumRejectCodes.NewAddendumRejectCodesRow()
                    With adrej
                        .biAddendumRejectCodes = ""
                        .sRejectCode = ""
                        .RejectedNote = ""
                        '.Page = x
                        .Clinica = False
                        .Otro = False
                        .OtroRazon = ""
                    End With
                    Adden.AddendumRejectCodes.AddAddendumRejectCodesRow(adrej)
                Next x

            End If

        End Using

        Return Adden

    End Function

