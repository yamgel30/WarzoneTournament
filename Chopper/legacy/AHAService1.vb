    Private Function GetAHAShort(ByVal ahaID As Long) As AHAFormItemShort

        Dim aha As New AHAFormItemShort
        Dim dbo As SqlDataObject
        Dim sqlCMD As SqlCommand

        Try

            dbo = New SqlDataObject(ConnectionStrings(AppSettings("DBClaimAttach").ToString).ConnectionString, True)
            sqlCMD = New SqlCommand

            sqlCMD.CommandType = CommandType.StoredProcedure
            sqlCMD.CommandText = "uspGetAHA2"
            sqlCMD.Parameters.AddWithValue("@biClaimID", ahaID)

            Dim ds As DataSet = dbo.GetDataSet(sqlCMD)
            Dim _isGHP As Boolean

            If ds.Tables(0).Rows.Count > 0 Then

                aha.ID = ahaID

                With ds.Tables(0).Rows(0)

                    aha.SubmittedDate = CDate(.Item("SubmittedDate"))

                    aha.FormHeader = New FormHeaderSection

                    If Not IsDBNull(.Item("AHALanguage")) Then aha.Language = .Item("AHALanguage")

                    If Not IsDBNull(.Item("BillingNPI")) Then aha.FormHeader.BillingNPI.Value = .Item("BillingNPI")
                    If Not IsDBNull(.Item("ServiceDate")) Then aha.FormHeader.DateOfVisit.Value = CDate(.Item("ServiceDate"))
                    If Not IsDBNull(.Item("PayerName")) Then aha.FormHeader.HealthPlan.Value = .Item("PayerName")
                    If Not IsDBNull(.Item("birthDate")) Then aha.FormHeader.MemberDOB.Value = .Item("birthDate")
                    If Not IsDBNull(.Item("genderID")) Then aha.FormHeader.MemberGender.Value = .Item("genderID")
                    If Not IsDBNull(.Item("MemberID")) Then aha.FormHeader.MemberID.Value = .Item("MemberID")
                    If Not IsDBNull(.Item("MemberName")) Then aha.FormHeader.MemberName.Value = .Item("MemberName")
                    If Not IsDBNull(ds.Tables(2).Rows(0)("sPayerID")) Then aha.FormHeader.PayerID.Value = ds.Tables(2).Rows(0)("sPayerID")
                    If Not IsDBNull(.Item("ProvName")) Then aha.FormHeader.ProviderName.Value = .Item("ProvName")
                    If Not IsDBNull(.Item("RenderingNPI")) Then aha.FormHeader.RenderingNPI.Value = .Item("RenderingNPI")
                    If Not IsDBNull(.Item("AtHome")) Then aha.FormHeader.AtHome.Value = .Item("AtHome")
                    If Not IsDBNull(.Item("nPOS")) Then aha.FormHeader.PlaceOfService.Value = CInt(.Item("nPOS"))
                    If Not IsDBNull(.Item("iStatus")) Then aha.FormHeader.Status.Value = CInt(.Item("iStatus"))
                    If Not IsDBNull(.Item("dApproved")) Then aha.FormHeader.ApprovedOrRejectedDate.Value = CDate(.Item("dApproved"))
                    If Not IsDBNull(.Item("MemberFName")) Then aha.FormHeader.MemberFName = .Item("MemberFName").ToString
                    If Not IsDBNull(.Item("MemberMName")) Then aha.FormHeader.MemberMName = .Item("MemberMName").ToString
                    If Not IsDBNull(.Item("MemberLName")) Then aha.FormHeader.MemberLName = .Item("MemberLName").ToString
                    If Not IsDBNull(.Item("PatientBirth")) Then aha.FormHeader.MemberDOB.Value = .Item("PatientBirth")
                    If Not IsDBNull(.Item("RenderingName")) Then aha.FormHeader.RenderingName = .Item("RenderingName").ToString
                    If Not IsDBNull(.Item("BillingName")) Then aha.FormHeader.BillingName = .Item("BillingName").ToString
                    If Not IsDBNull(.Item("IPAName")) Then aha.FormHeader.IPAName = .Item("IPAName")
                    If Not IsDBNull(.Item("AccompaniedBy")) Then aha.FormHeader.AccompaniedBy.Value = .Item("AccompaniedBy")
                    If Not IsDBNull(.Item("TypeOfVisit")) Then aha.FormHeader.TypeOfVisit = CInt(.Item("TypeOfVisit"))
                    If Not IsDBNull(.Item("ConcurrencyID")) Then aha.FormHeader.ConcurrencyID = CLng(.Item("ConcurrencyID")) Else aha.FormHeader.ConcurrencyID = 0
                    If Not IsDBNull(.Item("nClaimClassTag")) Then aha.FormHeader.ClaimClassTag.Value = CInt(.Item("nClaimClassTag")) Else aha.FormHeader.ClaimClassTag = Nothing

                    If Not IsDBNull(.Item("Member_Race")) Then aha.FormHeader.Race.Value = .Item("Member_Race").ToString
                    If Not IsDBNull(.Item("Member_Ethnicity")) Then aha.FormHeader.Ethnicity.Value = .Item("Member_Ethnicity").ToString
                    If Not IsDBNull(.Item("Member_Phone")) Then aha.FormHeader.Phone.Value = .Item("Member_Phone").ToString
                    If Not IsDBNull(.Item("Member_EMail")) Then aha.FormHeader.Email.Value = .Item("Member_EMail").ToString
