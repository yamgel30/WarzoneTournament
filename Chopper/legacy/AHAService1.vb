    Public Function VerifyMemberHasAHAForYear(ByVal memberNumber As String, ByVal year As Integer, ByVal renderingNPI As String, Optional ByVal claimClassTag As Integer = 1) As Boolean Implements IAHAService12.VerifyMemberHasAHAForYear
        Dim claimClass As Integer = 0
        Dim has As Boolean = False

        'Actualizacion de 2020 - Cambio de Codigo
        claimClass = GetClaimClassByYear(year)

        'If year = 2019 Then
        '    claimClass = 84
        'Else
        '    claimClass = 84
        'End If
        'End Actualizacion 2020


        Dim _DBO As New SqlDataObject(ConnectionStrings(AppSettings("DBClaimAttach").ToString).ConnectionString, True)
        Dim cmd As New SqlCommand

        cmd.CommandTimeout = 60 * 5
        cmd.CommandType = CommandType.Text
        cmd.CommandText = "SELECT biClaimID 
                            FROM Claims c (NOLOCK) 
                            LEFT JOIN M_MSV_Master m (NOLOCK)
	                            ON c.sPatientContract = m.memberID
	                            AND m.useForPCPEligibility = 1
	                            AND c.sRenderingNPI = m.renderingNPI
                            WHERE c.sPatientContract = @memberNumber
	                            AND c.sRenderingNPI = @rendeingNPI
	                            AND c.nClaimClass = @claimClass
	                            AND c.iStatus in (-1*@claimClass,2,3,4)
                                AND c.nClaimClassTag = @claimClassTag
	                            AND (
		                            (c.iStatus in (2,4) AND c.nApproved = 1)
		                            OR c.iStatus = -1*@claimClass
	                            )
	                            AND DATEDIFF(DAY, c.dDOS, GETDATE()) <= 90"

        With cmd.Parameters
            .AddWithValue("@rendeingNPI", renderingNPI)
            .AddWithValue("@memberNumber", memberNumber)
            .AddWithValue("@claimClass", claimClass)
            .AddWithValue("@claimClassTag", claimClassTag)
        End With

        Dim dr As SqlDataReader = _DBO.GetReader(cmd, CommandBehavior.Default)

        Try
            If dr.HasRows AndAlso dr.Read() Then
                has = True
            Else
                has = False
            End If

            dr.Close()

        Catch ex As Exception
            Globals.LogError(0, MethodBase.GetCurrentMethod.DeclaringType.Name, MethodBase.GetCurrentMethod.Name, String.Format("memberNumber = {0}", memberNumber), ex.Message, ex.StackTrace)
            has = False
        Finally
            cmd.Dispose()
        End Try

        Return has

    End Function

