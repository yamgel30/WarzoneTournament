    Public Function GetInfo(model As AHAAIInfo) As GetAHAAIInfoResponse Implements IAHAService12.GetInfo
        Dim sqlCMD As New SqlCommand
        Dim resp As New GetAHAAIInfoResponse

        Try
            Dim sqlText As New StringBuilder

            sqlCMD.CommandType = CommandType.StoredProcedure
            sqlCMD.CommandText = "usp_AHAAIInfo_GetInfo"

            sqlCMD.Parameters.AddWithValue("@ClaimID", model.ClaimID)
            sqlCMD.Parameters.AddWithValue("@ContractID", model.ContractID)

            _DBO.OpenConnection()

            Dim sdr As SqlDataReader = _DBO.GetReader(sqlCMD, CommandBehavior.Default)

            While sdr.Read
                If Not IsDBNull(sdr("Transcript")) Then resp.Transcript = sdr("Transcript").ToString()
                If Not IsDBNull(sdr("HasFillAHA")) Then resp.HasFillAHA = Boolean.Parse(sdr("HasFillAHA"))
            End While

            sdr.Close()

            resp.ErrorNumber = AHAEDM.Errors.Sucessfull
        Catch ex As Exception
            Globals.LogError(0, MethodBase.GetCurrentMethod.DeclaringType.Name, MethodBase.GetCurrentMethod.Name, "", ex.Message, ex.StackTrace)
            Throw
        Finally
            sqlCMD.Dispose()
            _DBO.CloseConnection()
        End Try

        Return resp
    End Function

