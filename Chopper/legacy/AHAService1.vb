    Public Function GetMemberActiveCondition(ByVal memberID As String, ByVal year As String) As GetMemberConditionResponse Implements IAHAService12.GetMemberActiveCondition

        Dim resp As New GetMemberConditionResponse
        Dim activeConditionItem As Condition

        resp.Conditions = New List(Of Condition)

        Dim dbo As New SqlDataObject
        Dim sqlCMD As New SqlCommand
        Dim sdr As SqlDataReader
        Dim ahaTemp As AHAFormItem = Nothing

        Try
            dbo = New SqlDataObject(ConnectionStrings(AppSettings("DBClaimAttach").ToString).ConnectionString, True)

            sqlCMD.CommandType = CommandType.StoredProcedure
            sqlCMD.CommandText = "uspGetMemberActiveCondition"
            sqlCMD.Parameters.AddWithValue("@memberID", memberID)
            sqlCMD.Parameters.AddWithValue("@year", IIf(String.IsNullOrEmpty(year), AppShared.AHAVersion, year))

            sdr = dbo.GetReader(sqlCMD, CommandBehavior.Default)

            resp.ErrorNumber = 0
            resp.ReturnValue = ""

            If sdr.HasRows Then

                Do While sdr.Read()

                    activeConditionItem = New Condition

                    activeConditionItem.Index = sdr("pKey")
                    activeConditionItem.Condition = sdr("condition").ToString()

                    resp.Conditions.Add(activeConditionItem)

                Loop

                sdr.Close()

            End If

        Catch ex As Exception
            Globals.LogError(0, MethodBase.GetCurrentMethod.DeclaringType.Name, MethodBase.GetCurrentMethod.Name, String.Format("MemberID = {0}, Year = {1}", memberID, year), ex.Message, ex.StackTrace)
            resp.ErrorNumber = -1
            resp.ReturnValue = "Internal Error"
        Finally
            sqlCMD.Dispose()
            dbo.Dispose()
        End Try

        Return resp

    End Function

