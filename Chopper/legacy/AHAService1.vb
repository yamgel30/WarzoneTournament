    Private Function GetBillingOfRendering(ByVal renderingNPI As String) As List(Of DataBinding)

        Dim billingList As New List(Of DataBinding)
        Dim billingItem As DataBinding

        Dim _DBO As New SqlDataObject(ConnectionStrings(AppSettings("DBClaimAttach").ToString).ConnectionString, True)
        Dim cmd As New SqlCommand

        cmd.CommandType = CommandType.StoredProcedure
        cmd.CommandText = "uspGetBillingsOfRendering"

        cmd.Parameters.AddWithValue("RenderingNPI", renderingNPI)

        Try
            Using reader As SqlDataReader = _DBO.GetReader(cmd)

                If reader.HasRows Then

                    While reader.Read

                        billingItem = New DataBinding

                        billingItem.DataValue = reader("billingNPI").ToString
                        billingItem.DisplayText = String.Format("{0} - {1}", billingItem.DataValue, reader("vendorName").ToString)

                        billingList.Add(billingItem)

                    End While

                End If

            End Using

        Catch ex As Exception
            Globals.LogError(0, MethodBase.GetCurrentMethod.DeclaringType.Name, MethodBase.GetCurrentMethod.Name, "", ex.Message, ex.StackTrace)
        End Try

        Dim bl = billingList.GroupBy(Function(b) b.DataValue).Select(Function(x) x.FirstOrDefault)


        Return bl.ToList

    End Function

