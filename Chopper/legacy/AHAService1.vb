                If ahaItem.FormHeader.BillingNPI IsNot Nothing Then mp.AppendLine(String.Format("BillingNPI = {0}", ahaItem.FormHeader.BillingNPI.Value))
                If ahaItem.FormHeader.RenderingNPI IsNot Nothing Then mp.AppendLine(String.Format("RenderingNPI = {0}", ahaItem.FormHeader.RenderingNPI.Value))
                mp.AppendLine(String.Format("RepType = {0}", repType))

                mp.AppendLine("RequestXML...")
                mp.AppendLine(requestXML)

            Catch 'ex As Exception

            End Try

            Globals.LogError(SessionID, MethodBase.GetCurrentMethod.DeclaringType.Name, MethodBase.GetCurrentMethod.Name, mp.ToString, ex.Message, ex.StackTrace)

            Throw
        Finally
            ahaItem = Nothing
            asm = Nothing
            TextColorReport = Nothing
            isEmptyAHA = Nothing
            hiddenAHAForm = Nothing
            isFlorida = Nothing
            IsGHP = Nothing
            IsPed = Nothing
            GC.Collect(GC.MaxGeneration)
            GC.WaitForPendingFinalizers()
        End Try

        Return bytes
    End Function

    Private Sub ProcessPDFBatch(ByVal PDFfile As Byte())

        Try

            Dim path As String = AppSettings("FilePath").ToString

            If PDFfile IsNot Nothing And System.IO.Directory.Exists(path) Then  '"" + FileName + ".pdf"
                System.IO.File.WriteAllBytes(path + "/AHA_BillingNPI_RenderingNPI_" + Convert.ToString(DateTime.Now.ToString("yyyyMMddHHmmss")) + ".pdf", PDFfile)
            End If
        Catch ex As Exception

        End Try
    End Sub

    Public Function GetAHAHeaderList(accountID As String, loginToken As String, sourceIP As String, memberID As String, renderingNPI As String, billingNPI As String, ipaName As String, formYear As Integer) As GetAHAHeaderResponse Implements IAHAService12.GetAHAHeaderList

        Dim resp As New GetAHAHeaderResponse

        resp.HeaderList = New List(Of FormHeaderSection)

        Try
            Dim ahaHeaders As List(Of FormHeaderSection) = GetMemberHeaderList(memberID, renderingNPI, billingNPI, ipaName, formYear, False)

            resp.ErrorNumber = 0
            resp.HeaderList = ahaHeaders

        Catch ex As Exception
            resp.ErrorNumber = -1
            resp.ReturnValue = ex.ToString
        End Try

        Return resp

    End Function

    Public Function GetAHAYearItem(accountID As String, loginToken As String, sourceIP As String, ahaYear As Integer) As GetAHAYearItemResponse Implements IAHAService12.GetAHAYearItem

        Dim resp As New GetAHAYearItemResponse
        Dim dbo As New SqlDataObject(ConnectionStrings(AppSettings("DBClaimAttach").ToString).ConnectionString, True)
        Dim cmd As SqlCommand = New SqlCommand()

        cmd.CommandType = CommandType.StoredProcedure
        cmd.CommandText = "uspAHAYear_GetAHAYearItem"
        cmd.Parameters.AddWithValue("Year", ahaYear)

        Try
            Using sdr As SqlDataReader = _DBO.GetReader(cmd, CommandBehavior.Default)

                If sdr.HasRows AndAlso sdr.Read() Then

                    resp.ClaimClass = Convert.ToInt32(sdr("ClaimClass"))
                    resp.Year = ahaYear
                    resp.IsReadOnly = Convert.ToBoolean(sdr("ReadOnly"))
                    resp.ReadOnlyBy = sdr("ReadOnlyBy").ToString
                    If Not IsDBNull(sdr("ReadOnlyDateTime")) Then resp.ReadOnlyDate = sdr("ReadOnlyDateTime")

                End If

                resp.ErrorNumber = 0
                resp.ReturnValue = ""

            End Using

        Catch ex As Exception
            resp.ErrorNumber = -1
            resp.ReturnValue = "Internal Error"
        End Try

        Return resp

    End Function

    Public Function GetMemberClinicalDataForm(accountID As String, loginToken As String, sourceIP As String, memberID As String, renderingNPI As String, billingNPI As String, ipaName As String, formYear As Integer) As GetAHAReportBytesResponse Implements IAHAService12.GetMemberClinicalDataForm

        Try

            Dim resp As New GetAHAReportBytesResponse
            Dim ahaHeaders As List(Of FormHeaderSection) = GetMemberHeaderList(memberID, renderingNPI, billingNPI, ipaName, formYear, True)

            If ahaHeaders.Count > 0 Then

                Dim pdfByteList As New List(Of Byte())

                'Create AhaForm and contact to PDF
                For Each h As FormHeaderSection In ahaHeaders
                    pdfByteList.Add(GetClinicalDataForm(h))
                Next

                Dim pdfHelper As New PDFHelper

                resp.ReportBytes = pdfHelper.MergePdfFiles(pdfByteList)
                resp.ErrorNumber = 0
                resp.ReturnValue = ""

                'IO.File.WriteAllBytes("T:\DevRoot\EmptyAHAList.pdf", resp.ReportBytes)

                If String.IsNullOrEmpty(memberID) Then
                    'ProcessPDFBatch(resp.ReportBytes)
                    Return Nothing
                Else
                    Return resp
                End If

            End If

            Return resp

        Catch ex As Exception
            Return Nothing
        End Try

    End Function

    Public Function GetHistoryPresentIllnessOption(ahaPR As Integer, ahaFL As Integer, ghpAdult As Integer, ghpPediatric As Integer, isshort As Integer) As HistoryPresentIllnessOptionsResponse Implements IAHAService12.GetHistoryPresentIllnessOption

        Dim resp As New HistoryPresentIllnessOptionsResponse

        resp.HistoryPresentIllnessOptionList = New List(Of HistoryPresentIllnessOptions)

        Dim dbo As New SqlDataObject(ConnectionStrings(AppSettings("DBClaimAttach").ToString).ConnectionString, True)
        Dim cmd As SqlCommand = New SqlCommand()

        cmd.CommandType = CommandType.StoredProcedure
        cmd.CommandText = "uspHistoryPresentIllnessOptions_GetByFormType"

        If ahaPR >= 0 Then cmd.Parameters.AddWithValue("AHAPR", ahaPR)
        If ahaFL >= 0 Then cmd.Parameters.AddWithValue("AHAFL", ahaFL)
        If ghpAdult >= 0 Then cmd.Parameters.AddWithValue("GHPAdult", ghpAdult)
        If ghpPediatric >= 0 Then cmd.Parameters.AddWithValue("GHPPediatric", ghpPediatric)
        If isshort >= 0 Then cmd.Parameters.AddWithValue("IsShort", isshort)

        Try
            Using sdr As SqlDataReader = _DBO.GetReader(cmd, CommandBehavior.Default)

                If sdr.HasRows Then
                    While sdr.Read()
                        resp.HistoryPresentIllnessOptionList.Add(New HistoryPresentIllnessOptions() With {
