    Public Function VerifyEligibility(memberID As String, dateOfService As Date, renderingNPI As String, billingNPI As String, ByVal payerID As String) As MemberEligibilityResponse Implements IAHAService12.VerifyEligibility

        Dim resp As New MemberEligibilityResponse

        Dim _DBO As New SqlDataObject(ConnectionStrings(AppSettings("DBClaimAttach").ToString).ConnectionString, True)
        Dim cmd As New SqlCommand

        cmd.CommandType = CommandType.StoredProcedure
        cmd.CommandText = "uspAHAMemberEligibility"

        If String.IsNullOrEmpty(billingNPI) Then
            resp.ErrorNumber = 5
            resp.ReturnValue = "Required information. Please try again"

            Return resp
        End If

        cmd.Parameters.AddWithValue("MemberID", memberID)
        cmd.Parameters.AddWithValue("BillingNPI", billingNPI)
        cmd.Parameters.AddWithValue("RenderingNPI", renderingNPI)
        cmd.Parameters.AddWithValue("ServiceDate", dateOfService)
        cmd.Parameters.AddWithValue("PayerID", payerID)


        Dim firstPlusDummyNPI As New DataTable
        firstPlusDummyNPI.Columns.Add("NPI")

        Dim fpDummyNPI As List(Of String) = GetFirstPlusDummyNPI()

        For Each npi In fpDummyNPI
            Dim dr = firstPlusDummyNPI.NewRow

            dr("NPI") = npi

            firstPlusDummyNPI.Rows.Add(dr)
        Next

        Dim param As New SqlParameter("FirstPlusDummyNPI", SqlDbType.Structured)
        param.Value = firstPlusDummyNPI

        cmd.Parameters.Add(param)

        resp.MemberInfo = New MemberItem

        Try
            Using reader As SqlDataReader = _DBO.GetReader(cmd, CommandBehavior.Default)

                If reader.HasRows AndAlso reader.Read Then

                    resp.MemberInfo.BillingNPI = reader("billingNPI").ToString
                    resp.MemberInfo.Cover = reader("contractDesc").ToString
                    If Not IsDBNull(reader("birthDate")) Then resp.MemberInfo.DOB = CDate(reader("birthDate"))
                    resp.MemberInfo.Gender = reader("genderID").ToString
                    resp.MemberInfo.MemberID = memberID
                    resp.MemberInfo.Name = reader("name").ToString
                    resp.MemberInfo.PayerID = reader("payerID").ToString
                    resp.MemberInfo.ProviderName = reader("providerName").ToString
                    resp.MemberInfo.RenderingNPI = reader("renderingNPI").ToString
                    resp.MemberInfo.FirstName = reader("firstName").ToString
                    resp.MemberInfo.MiddleName = reader("middleName").ToString
                    resp.MemberInfo.LastName = reader("lastName").ToString

                    resp.ErrorNumber = 0
                    resp.ReturnValue = ""

                Else
                    resp.ErrorNumber = 4
                    resp.ReturnValue = "Member is not eligible or not found."
                End If

            End Using

        Catch ex As Exception

            Dim mp As New StringBuilder

            Try
                mp.AppendLine(String.Format("Member ID = {0}", memberID.ToString))
                mp.AppendLine(String.Format("Rendering NPI = {0}", renderingNPI.ToString))
                mp.AppendLine(String.Format("Billing NPI = {0}", billingNPI.ToString))
            Catch 'ex As Exception
            End Try

            Globals.LogError(0, MethodBase.GetCurrentMethod.DeclaringType.Name, MethodBase.GetCurrentMethod.Name, mp.ToString, ex.Message, ex.StackTrace)

            resp.ErrorNumber = -1
            resp.ReturnValue = "Internal Error"

        End Try

        Return resp

    End Function

