    Public Function GetProviderStatusLetterCSV(ByVal renderingNPI As String, ByVal claimYear As Integer,
                                               ByVal ipaName As String, ByVal billingNPI As String) As GetProviderStatusLetterCSVResponse Implements IAHAService12.GetProviderStatusLetterCSV

        Dim resp As New GetProviderStatusLetterCSVResponse

        Dim _DBO As New SqlDataObject(ConnectionStrings(AppSettings("DBClaimAttach").ToString).ConnectionString, True)
        Dim cmd As New SqlCommand

        cmd.CommandTimeout = 60 * 5
        cmd.CommandType = CommandType.StoredProcedure
        cmd.CommandText = "uspGetProvidersStatusLetter2"

        cmd.Parameters.AddWithValue("@claimYear", claimYear)

        If Not String.IsNullOrEmpty(ipaName.Trim) Then
            cmd.Parameters.AddWithValue("@ipaName", ipaName)
        End If

        If Not String.IsNullOrEmpty(billingNPI.Trim) Then
            cmd.Parameters.AddWithValue("@billingNPI", billingNPI)
        End If

        If Not String.IsNullOrEmpty(renderingNPI.Trim) Then
            cmd.Parameters.AddWithValue("@renderingNPI", renderingNPI)
        End If

        Dim dtClaims As DataTable = Nothing
        Dim ms As New IO.MemoryStream
        Dim sb As IO.TextWriter = New IO.StreamWriter(ms)

        Try
            dtClaims = _DBO.GetDataTable(cmd)

            If dtClaims.Rows.Count > 0 Then

                'Create CSV
                resp.ErrorNumber = 0
                resp.ReturnValue = ""

                'Header
                AppendCSVField("MemberID", sb, True, True)
                AppendCSVField("MemberName", sb, True)
                AppendCSVField("BirthDate", sb, True, True)
                AppendCSVField("BillingNPI", sb, True, True)
                AppendCSVField("RenderingNPI", sb, True, True)
                AppendCSVField("ProviderName", sb, True)
                AppendCSVField("Service Date", sb, True, True)
                AppendCSVField("Submitted Date", sb, True, True)
                AppendCSVField("Plan", sb, True)
                AppendCSVField("Cover Description", sb, True)
                AppendCSVField("AHA Status", sb, True, True)
                AppendCSVField("Denied Code", sb, True, True) '************
                AppendCSVField("Check Number", sb, True, True) '***********
                AppendCSVField("Check Amount", sb, True, True) '************
                AppendCSVField("Check Date", sb, False, True) '**************

                sb.WriteLine()

                For Each claim As DataRow In dtClaims.Rows

                    AppendCSVField(claim("memberID").ToString, sb, True, True)
                    AppendCSVField(claim("memberName").ToString, sb, True, True)

                    If Not IsDBNull(claim("birthDate")) Then
                        AppendCSVField(CDate(claim("birthDate")).ToShortDateString, sb, True)
                    Else
                        AppendCSVField("", sb, True)
                    End If

                    AppendCSVField(claim("billingNPI").ToString, sb, True)
                    AppendCSVField(claim("renderingNPI").ToString, sb, True)
                    AppendCSVField(claim("ProviderName").ToString, sb, True)

                    If Not IsDBNull(claim("serviceDate")) Then
                        AppendCSVField(CDate(claim("serviceDate")).ToShortDateString, sb, True)
                    Else
                        AppendCSVField("", sb, True)
                    End If

                    If Not IsDBNull(claim("submittedDate")) Then
                        AppendCSVField(CDate(claim("submittedDate")).ToShortDateString, sb, True)
                    Else
                        AppendCSVField("", sb, True)
                    End If

                    AppendCSVField(claim("payerAlias").ToString, sb, True)
                    AppendCSVField(claim("contractDesc").ToString, sb, True)

                    If Not IsDBNull(claim("claimStatus")) Then
                        AppendCSVField(claim("claimStatus").ToString, sb, True)
                    Else
                        AppendCSVField("", sb, True)
                    End If

                    If Not IsDBNull(claim("deniedCode")) Then
                        AppendCSVField(claim("deniedCode").ToString, sb, True, True) 'Denied Code
                    Else
                        AppendCSVField("", sb, True) 'Denied Code
                    End If

                    If Not IsDBNull(claim("checkNumber")) Then
                        AppendCSVField(claim("checkNumber"), sb, True, True) 'Check Number
                    Else
                        AppendCSVField("", sb, True) '
                    End If

                    If Not IsDBNull(claim("checkAmount")) Then
                        AppendCSVField(FormatCurrency(claim("checkAmount").ToString, 2), sb, True, True) 'Amount
                    Else
                        AppendCSVField("", sb, True)
                    End If

                    If Not IsDBNull(claim("checkDate")) Then
                        AppendCSVField(CDate(claim("checkDate")).ToShortDateString, sb, False, True) 'Date
                    Else
                        AppendCSVField("", sb, False) '
                    End If

                    sb.WriteLine()

                    Threading.Thread.Sleep(0)

                Next

                sb.Flush()

                resp.CSVData = ms.ToArray

                resp.FileName = String.Format("Reconciliation_{0}{1}{2}_{3}{4}{5}.csv", Now.Year,
                                                Now.Month.ToString.PadLeft(2, "0"), Now.Day.ToString.PadLeft(2, "0"),
                                                Now.Hour.ToString.PadLeft(2, "0"), Now.Minute.ToString.PadLeft(2, "0"),
                                                Now.Second.ToString.PadLeft(2, "0"))
            End If

        Catch ex As Exception
            Globals.LogError(0, MethodBase.GetCurrentMethod.DeclaringType.Name, MethodBase.GetCurrentMethod.Name, "", ex.Message, ex.StackTrace)
            resp.ErrorNumber = -1
            resp.ReturnValue = "Internal Error"
        Finally
            cmd.Dispose()
            sb.Dispose()
            ms.Dispose()
        End Try

        Return resp

    End Function

    Private Sub AppendCSVField(ByVal value As String, ByVal sb As IO.TextWriter,
                           ByVal addComma As Boolean,
                           Optional ByVal bFixNumber As Boolean = False)

        'sb.Write("=""" & value.Replace(",", " ") & """")
        'sb.Write("=""" & value & """")
        'If addComma Then sb.Write(",")

        If bFixNumber Then
            sb.Write("=""" & value.Replace(",", " ") & """")
        Else
            sb.Write("""" & value.Replace(",", " ") & """")
        End If

        If addComma Then sb.Write(",")

    End Sub

    Public Function LoginAHAHome(ByVal userId As String, ByVal password As String, ByVal ipAddress As String) As AHAAtHomeLoginResponse Implements IAHAService12.LoginAHAHome

        Dim resp As New AHAAtHomeLoginResponse
        Dim _DBO As New SqlDataObject(ConnectionStrings(AppSettings("DBClaimAttach").ToString).ConnectionString, True)
        Dim cmd As New SqlCommand

        cmd.CommandTimeout = 60 * 5
        cmd.CommandType = CommandType.StoredProcedure
        cmd.CommandText = "uspAHAAtHomeLogin"

        With cmd.Parameters
            .AddWithValue("@RenderingNPI", userId)
            .AddWithValue("@Password", password)
            .AddWithValue("@HashPwd", CalculateMD5Hash(password & userId))
            .AddWithValue("@DefaultPwd", AppShared.AtHomeDefaultPassword)
            .AddWithValue("@IPAddress", ipAddress)
        End With

        Dim dtUser As DataTable = Nothing

        Try
            dtUser = _DBO.GetDataTable(cmd)

            resp.AHAHomeUser = New AHAAtHomeUserItem

            If dtUser IsNot Nothing Then

                If dtUser.Rows.Count > 0 Then

                    resp.AHAHomeUser.FullName = dtUser.Rows(0)("RenderingName").ToString()
                    resp.AHAHomeUser.RenderingNPI = dtUser.Rows(0)("renderingNPI").ToString()
                    resp.AHAHomeUser.ChangePassword = dtUser.Rows(0)("changePassword")
                    resp.AHAHomeUser.CreateDate = dtUser.Rows(0)("createDate")
                    resp.AHAHomeUser.UpdateDate = dtUser.Rows(0)("updateDate")

                    resp.ErrorNumber = 0
                    resp.ReturnValue = ""

                Else
                    resp.ErrorNumber = 2
                    resp.ReturnValue = "Access Denied."
                End If

            Else
                resp.ErrorNumber = 2
                resp.ReturnValue = "Access Denied."
            End If

        Catch ex As Exception
            Globals.LogError(0, MethodBase.GetCurrentMethod.DeclaringType.Name, MethodBase.GetCurrentMethod.Name, "", ex.Message, ex.StackTrace)
            resp.ErrorNumber = -1
            resp.ReturnValue = "Internal Error."
        End Try

        Return resp

    End Function

    Private Function CalculateMD5Hash(ByVal input As String) As String

        ' step 1, calculate MD5 hash from input
        Dim md5 As System.Security.Cryptography.MD5 = System.Security.Cryptography.MD5.Create
        Dim inputBytes() As Byte = System.Text.Encoding.ASCII.GetBytes(input)
        Dim hash() = md5.ComputeHash(inputBytes)

        ' step 2, convert byte array to hex string
        Dim sb As New StringBuilder()

        For i As Integer = 0 To hash.Length - 1
            sb.Append(hash(i).ToString("X2"))
        Next

        Return sb.ToString()

    End Function

