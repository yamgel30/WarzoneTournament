    Public Function SingleSignOn(ByVal portalID As String, ByVal token As String, ByVal mac As String, ByVal ip As String) As Models.SingleSignOnResponse Implements IAHAService12.SingleSignOn
        Dim response As New Models.SingleSignOnResponse
        Dim errorMessage As String = String.Empty
        Dim debugOn As Boolean = False

        If AppSettings("DebugOn") IsNot Nothing AndAlso Boolean.Parse(AppSettings("DebugOn")) Then
            debugOn = True
        End If

        Try

            response.ErrorNumber = Models.SingleSignOnResponse.ResultCode.Invalid

            If (Not String.IsNullOrEmpty(portalID) AndAlso Not String.IsNullOrEmpty(token) AndAlso Not String.IsNullOrEmpty(mac)) Then

                Using ausCentralDataAdapter As New Data.AUSCentralDataAdapter()

                    Dim portalPassKey As Models.PortalPassKey = ausCentralDataAdapter.PortalPassKeys_CheckOut(portalID, token, mac)

                    'portalPassKey = New Models.PortalPassKey()
                    'Dim dataTest As String = "<LOGIN><Provider RenderingNPI=""8888888889""/><Member ID=""010401305"" /><AHAHome IsAtHome=""true""/></LOGIN>"
                    'portalPassKey.Data = Encoding.UTF8.GetBytes(dataTest)
                    If (portalPassKey IsNot Nothing AndAlso portalPassKey.Data IsNot Nothing) Then
                        Dim appRequestData As String = Encoding.UTF8.GetString(portalPassKey.Data)

                        If (Not String.IsNullOrEmpty(appRequestData)) Then

                            Dim requestData As Models.LOGIN = DeserializeRequestData(portalPassKey.Data)

                            If (RequestDataIsValid(requestData)) Then
                                Dim portalSession As New Models.PortalSession
                                With portalSession
                                    .AccountNo = portalPassKey.AccountNo
                                    .LoginID = portalPassKey.LoginID
                                    .ApplicationUser = portalPassKey.RequestName
                                    .SourceIP = ip
                                    .PortalID = portalID
                                    .Token = token
                                End With

                                Dim ahaDataAdapter As AHADataAdapter = New AHADataAdapter()
                                Dim portalSessionID As Long = ahaDataAdapter.LogSession(portalSession)

                                If (portalSessionID > 0) Then
                                    response.ErrorNumber = Models.SingleSignOnResponse.ResultCode.Success
                                    response.RequestData = requestData
                                    response.RequestUserName = portalPassKey.RequestName
                                    response.PortalSessionID = portalSessionID
                                End If
                            End If
                        End If
                    End If
                End Using
            End If

        Catch ex As Exception
            Globals.LogError(0, MethodBase.GetCurrentMethod.DeclaringType.Name, MethodBase.GetCurrentMethod.Name, "", ex.Message, ex.StackTrace)
            response.ErrorNumber = Models.SingleSignOnResponse.ResultCode.InternalError
            response.ReturnValue = String.Concat(ex.Message, Environment.NewLine, ex.StackTrace)
            errorMessage = response.ReturnValue
        Finally
            If debugOn Then
                LogAHA(String.Empty, String.Empty, String.Empty, response, "GetAHAReportBytes", errorMessage)
            End If
        End Try

        Return response
    End Function

    ''' <summary>
    ''' returns null if deserialization fails
    ''' </summary>
    Private Function DeserializeRequestData(appRequestData As Byte()) As Models.LOGIN
        Dim requestData As Models.LOGIN = Nothing
        Try
            requestData = AppShared.DeserializeFromXml(Of Models.LOGIN)(appRequestData)
        Catch ex As Exception
            Debug.Print(ex.ToString)
        End Try
        Return requestData
    End Function

    Private Function RequestDataIsValid(requestData As Models.LOGIN) As Boolean
        Dim isValid As Boolean = False
        Try
            If requestData Is Nothing Then
                Return isValid
            End If

            If requestData.Provider Is Nothing OrElse requestData.Provider.Count.Equals(0) OrElse String.IsNullOrEmpty(requestData.Provider(0).RenderingNPI) Then
                Return isValid
            End If

            Return True
        Catch
            isValid = False
        End Try
        Return isValid
    End Function

    Public Function GetProvidersInformation(ByVal renderingList As List(Of String)) As GetProviderInformationResponse Implements IAHAService12.GetProvidersInformation

        Dim resp As New GetProviderInformationResponse
        Dim provItem As ProviderItem

        resp.ProviderInfoList = New List(Of ProviderItem)

        Dim _DBO As New SqlDataObject(ConnectionStrings(AppSettings("DBClaimAttach").ToString).ConnectionString, True)
        Dim cmd As New SqlCommand

        cmd.CommandTimeout = 60 * 5
        cmd.CommandType = CommandType.StoredProcedure
        cmd.CommandText = "uspGetProviderInformation"

        _DBO.OpenConnection()

        For Each npi In renderingList

            cmd.Parameters.Clear()
            cmd.Parameters.AddWithValue("ProviderNPI", npi)

            Try
                Using reader As SqlDataReader = _DBO.GetReader(cmd)

                    If reader.HasRows AndAlso reader.Read Then

                        provItem = New ProviderItem

                        provItem.RenderingNPI = npi
                        provItem.RenderingName = reader("ProvName").ToString
                        provItem.DisplayText = String.Format("{0} - {1}", npi, provItem.RenderingName)
                        provItem.PayerID = ""
                        provItem.BillingNPI = ""
                        provItem.BillingList = GetBillingOfRendering(npi)

                        resp.ProviderInfoList.Add(provItem)

                    End If

                End Using

            Catch ex As Exception
                Globals.LogError(0, MethodBase.GetCurrentMethod.DeclaringType.Name, MethodBase.GetCurrentMethod.Name, "", ex.Message, ex.StackTrace)
                resp.ErrorNumber = -1
                resp.ReturnValue = "Internal Error."
            End Try

        Next

        _DBO.CloseConnection()

        Return resp

    End Function

