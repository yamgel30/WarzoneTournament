    Public Function GetAddendumFormReport(accountID As String, loginToken As String, sourceIP As String, claimId As String, exportFormat As String, changeColor As Boolean) As GetAddendumFormReportBytesResponse Implements IAHAService12.GetAddendumFormReport

        Dim resp As New GetAddendumFormReportBytesResponse
        Dim rptViewer As New ReportViewer
        Dim bytes() As Byte = Nothing

        Try

            Dim ds As DataSet = GetAddendumReport(CInt(claimId))

            rptViewer.Reset()

            With rptViewer.LocalReport

                .DataSources.Clear()

                Dim reportName As String = ".AddendumAHA2017.rdlc"

                .ReportEmbeddedResource = Assembly.GetExecutingAssembly.GetName.Name & reportName

                .DataSources.Add(New ReportDataSource("Addendum", ds.Tables(0)))
                .DataSources.Add(New ReportDataSource("Claims", ds.Tables(1)))
                .DataSources.Add(New ReportDataSource("AddendumRejectCodes", ds.Tables(2)))
                '.DataSources.Add(New ReportDataSource("AddendumRejectCodeRelation", ds.Tables(3)))

                .Refresh()

                Dim format As String = ""
                Dim deviceInfo As String = String.Empty
                Dim mimeType As String = ""
                Dim encoding As String = String.Empty
                Dim extension As String = "pdf"
                Dim streamIDs() As String = Nothing
                Dim warnings() As Warning = Nothing

                Select Case exportFormat.ToLower
                    Case "pdf"
                        format = "PDF"
                        mimeType = "application/pdf"
                        extension = "pdf"
                    Case Else
                        format = "IMAGE"
                        mimeType = "image/tiff"
                        extension = "tif"
                End Select

                bytes = .Render(format, deviceInfo, mimeType, encoding, extension, streamIDs, warnings)

                resp.ReportBytes = bytes
                resp.ErrorNumber = 0
                resp.ReturnValue = ""

            End With

        Catch ex As Exception
            Globals.LogError(0, MethodBase.GetCurrentMethod.DeclaringType.Name, MethodBase.GetCurrentMethod.Name, "", ex.Message, ex.StackTrace)
            resp.ErrorNumber = -1
            resp.ReturnValue = ex.ToString
        Finally
            'sqlCMD.Dispose()
        End Try

        Return resp

    End Function

